#!/usr/bin/env bash
# DESC: Integrate AppImages into the app launcher: add, update from GitHub, roll back, remove
#
# NEW IN THIS VERSION (3.3.0):
#   - New: 'appimgr remove <slug> --purge-data' also looks for the app's leftover data
#     (config, cache, data, state). An AppImage does not say where it keeps its files, so
#     the search is by name: entries in ~/.config, ~/.cache, ~/.local/share, ~/.local/state
#     (and hidden folders in ~) whose name equals the app's slug, display name or window
#     class, ignoring case and punctuation. You get a list with sizes and pick what to
#     delete; with -y nothing found this way is deleted. On a terminal, plain 'remove'
#     (and the menu) asks "Also look for leftover data?". Caches are deleted for good,
#     everything else goes to the Trash (--purge = permanently).
#   - New: portable mode, for apps you only want for a while. 'appimgr add ... --portable'
#     (or 'appimgr portable <slug> on|off|status') keeps all of an app's data in
#     <slug>.AppImage.home next to the AppImage, so 'remove --purge-data' deletes it exactly,
#     with no guessing. Existing settings are not moved, and the app no longer sees your real
#     home. Kept across updates. The menu has a matching entry and an "add" question.
#   - 'list -l' shows where each app's data lives. 'remove' warns when a portable data folder
#     is kept, and refuses --purge-data while the app is running.
#   - The Trash helper now also names folders correctly when a name is already taken.
#   - The 3.2.0 entry is replaced by this one.
VERSION="3.3.0"
#
set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
APPS_DIR="${APPIMGR_DIR:-$DATA_HOME/AppImages}"
ICONS_DIR="$APPS_DIR/.icons"
META_DIR="$APPS_DIR/.meta"
BACKUP_DIR="$APPS_DIR/.backup"
DESKTOP_DIR="$DATA_HOME/applications"

SELF=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null) || SELF=$0

die()  { echo "error: $*" >&2; exit 1; }
warn() { echo "warning: $*" >&2; }
info() { echo ":: $*"; }

TMP_DIR=""; STAGE_FILE=""; DL_DIR=""; SCRATCH=""; BATCH_DIR=""
SAVED=(); PF=(); LEFT=()
L_VERSION=""; L_URL=""; L_NAME=""; L_SIZE=""; L_DIGEST=""; L_ETAG=""; L_MATCHES=0
STATUS=""; DL_ETAG=""
JOBS="${APPIMGR_JOBS:-4}"
USE_ARIA=1
GH_TOKEN=""; GH_BODY=""; GH_PARSED=""; GH_ERR=""; GH_RESET=""
RL_QUIET=0     # 1 inside parallel check jobs: rate-limit / bad-token messages are printed once by the parent

cleanup() {
  local p
  for p in $(jobs -p 2>/dev/null); do kill "$p" 2>/dev/null || true; done
  if [[ -n $TMP_DIR ]]; then rm -rf -- "$TMP_DIR"; fi
  if [[ -n $STAGE_FILE ]]; then rm -f -- "$STAGE_FILE"; fi
  if [[ -n $DL_DIR ]]; then rm -rf -- "$DL_DIR"; fi
  if [[ -n $SCRATCH ]]; then rm -rf -- "$SCRATCH"; fi
  if [[ -n $BATCH_DIR ]]; then rm -rf -- "$BATCH_DIR"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Scratch folder on disk, inside the AppImage folder: /tmp is often RAM, and a full
# extraction of a big AppImage can be hundreds of MB. Removed by cleanup().
mk_tmp() { mkdir -p "$APPS_DIR" && mktemp -d "$APPS_DIR/.appimgr-tmp.XXXXXX"; }

usage() {
cat <<EOF
appimgr v$VERSION - integrate AppImages into your app launcher

Usage:
  appimgr                                  Interactive menu (when run without arguments)
  appimgr add <file.AppImage> [options]    Integrate an AppImage into the launcher
  appimgr add <link> [options]             Download (GitHub release link or direct URL) and integrate
  appimgr add --repo OWNER/REPO [--asset 'PATTERN'] [--tag TAG] [options]
                                           Download from a GitHub release and integrate
  appimgr update <slug> [--check] [-y]     Update from the saved update source
  appimgr update [--all] [--check] [-y] [-j N]
                                           Check every app with a source (in parallel), list updates,
                                           ask once, download them together, install all
                                           (no <slug> = all)
  appimgr update <slug> <file> [options]   Replace with a local file instead
  appimgr rollback <slug>                  Swap back to the previous version
  appimgr icon <slug> [<file>|--reset]     Show / change the icon (PNG or SVG)
  appimgr source [<slug> [set ...|clear]]  Show/set/clear the update source (no args = how-to)
  appimgr portable <slug> [on|off|status]  Keep the app's data in its own folder (see "Leftover data")
  appimgr run <slug> [-d] [args...]        Launch from the terminal (-d = detached)
  appimgr list [-l]                        List integrated AppImages (-l = details)
  appimgr remove <slug> [-y] [--purge] [--purge-data]
                                           Remove the app; the AppImage goes to the Trash
                                           (-y = no prompt, --purge = delete permanently,
                                           --purge-data = also remove its leftover data)
  appimgr version | --version

Options for add / update <slug> <file>:
  -n, --name "Name"     Override the display name
  -a, --args "ARGS"     Extra args added to Exec (e.g. "--no-sandbox")
  -i, --icon FILE       Use this PNG/SVG as the icon (remembered across updates).
                        Only needed to override; if the AppImage has no icon you are asked.
      --no-fuse         Force extract-and-run mode (APPIMAGE_EXTRACT_AND_RUN=1).
                        Without it, FUSE is checked and this is enabled automatically if needed.
      --no-move         Keep the original file (default: it is deleted after success)
      --portable        Keep all of the app's data in <slug>.AppImage.home next to the
                        AppImage (remembered across updates; see "Leftover data")

Options for add <link> / --repo (downloads):
      --repo OWNER/REPO Take the AppImage from this GitHub project's release
      --asset 'PATTERN' Asset file name, version replaced by * (default: the one .AppImage
                        asset for this CPU; asked to choose if several)
      --tag TAG         Release tag (default: latest non-prerelease). Also the tag saved for updates
      --no-source       Never save or suggest an update source (apps you don't want updated)
                        Otherwise a source is saved silently when it is certain to work
                        (GitHub, one matching asset) and you are asked only when it is not
                        (--no-move has no effect for downloads: the temp file is always removed)

Options for update <slug|--all>:
      --check           Only check for updates, install nothing
  -y, --yes             Don't ask before installing
  -j, --jobs N          Run N update checks at the same time (default 4, max 16)

Options for add (downloads) and update:
      --no-aria2        Download with curl even if aria2c is installed

Downloads:
  If aria2c is installed it is used automatically: several connections per file, and
  'update' fetches all files at once with a single progress line. A file that fails is
  downloaded again on its own (aria2c, then curl). Installing always happens one app at a time.

Leftover data:
  An AppImage does not say where it keeps its settings, so appimgr cannot know for sure.
  Two ways to deal with that:
  * Long-term apps: 'remove --purge-data' (or the "Also look for leftover data?" question
    that 'remove' asks on a terminal) searches ~/.config, ~/.cache, ~/.local/share,
    ~/.local/state and hidden folders in ~ for entries named like the app: its slug,
    display name or window class, ignoring case and punctuation (3+ characters, system
    folders skipped). You get a list with sizes and choose what to delete. With -y nothing
    found this way is deleted. Apps that use an unrelated folder name are not found.
  * Temporary apps: portable mode ('add --portable', or 'portable <slug> on') keeps all the
    app's data in <slug>.AppImage.home next to the AppImage, so the data is known exactly
    and 'remove --purge-data' deletes it without guessing, even with -y. Existing settings
    are not moved, the app starts empty, and it no longer sees your real home (its file
    dialog opens in the portable home, your desktop theme settings are not read, ...).
    Run the app from a terminal (appimgr run <slug>) to see the runtime confirm it.
  Caches (~/.cache) are deleted permanently; everything else goes to the Trash, or is deleted
  permanently with --purge.

Layout:
  $APPS_DIR/<slug>.AppImage
  $APPS_DIR/<slug>.AppImage.home   (portable mode only)
  $APPS_DIR/.icons/  .meta/  .backup/
  $DESKTOP_DIR/appimage-<slug>.desktop

Environment:
  GITHUB_TOKEN        A GitHub token (no special rights needed). Raises the API limit from
                      60 to 5000 requests per hour; useful with many apps. Sent only to
                      api.github.com, never printed, not passed on to AppImages.
  APPIMGR_JOBS        Default for --jobs
  APPIMGR_DOWNLOADER  Set to curl to never use aria2c
  APPIMGR_DIR         Overrides the AppImage dir
EOF
}

source_help() {
cat <<'EOF'
Update sources let 'appimgr update' find newer versions. appimgr reads one from
the AppImage itself when you 'add' it; if there is none, set it by hand:

  appimgr source <slug> set github OWNER/REPO 'ASSET_PATTERN' [TAG]
  appimgr source <slug> set url DIRECT_DOWNLOAD_URL
  appimgr source <slug> clear

Where to get the values:
  OWNER/REPO     from the project's GitHub URL: github.com/OWNER/REPO
  ASSET_PATTERN  the .AppImage file name on the project's Releases page, with the
                 version replaced by * and the whole thing quoted, e.g.
                 Foo-1.2.3-x86_64.AppImage  ->  'Foo-*-x86_64.AppImage'
                 It should match exactly one file.
  TAG            optional, default 'latest' (newest non-prerelease). Only use a
                 fixed tag (e.g. nightly) for projects with a rolling release.
  URL            a link that always serves the newest AppImage (right-click the
                 download button -> copy link). Checked via its HTTP headers.

Only GitHub releases and direct URLs are supported.
EOF
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required for this (install: sudo pacman -S ${2:-$1})"; }

confirm() { # <prompt> <default when not interactive: y|n>; Enter = yes
  local ans
  if [[ ! -t 0 ]]; then
    if [[ ${2:-n} == y ]]; then return 0; else return 1; fi
  fi
  read -r -p "   $1 [Y/n] " ans || return 1
  [[ -z $ans || $ans == [Yy] || $ans == [Yy][Ee][Ss] ]]
}

# The token is read once from the environment and then removed from it, so that
# programs we start (AppImages, aria2c, ...) never inherit it.
init_token() {
  local t=${GITHUB_TOKEN:-}
  unset GITHUB_TOKEN
  if [[ -z $t ]]; then return 0; fi
  if [[ $t =~ ^[A-Za-z0-9_.-]+$ ]]; then
    GH_TOKEN=$t
  else
    warn "GITHUB_TOKEN contains unexpected characters - ignoring it"
  fi
}

set_jobs() { # <N>
  if [[ ! $1 =~ ^[0-9]+$ ]] || (( 10#$1 < 1 )); then die "jobs must be a whole number of 1 or more, got '$1'"; fi
  JOBS=$((10#$1))
  if (( JOBS > 16 )); then JOBS=16; fi
}

use_aria() { (( USE_ARIA )) && command -v aria2c >/dev/null 2>&1; }

# ~ instead of the home folder, for messages
tilde() { local t='~'; printf '%s' "${1/#$HOME/$t}"; }

# Folder next to the AppImage that the AppImage runtime uses as $HOME when it exists.
portable_dir() { printf '%s' "$APPS_DIR/$1.AppImage.home"; }

# ---------- small metadata store: $APPS_DIR/.meta/<slug>.conf (key=value) ----------
meta_get() { # <slug> <key>
  local f="$META_DIR/$1.conf"
  if [[ -f $f ]]; then grep -m1 "^$2=" "$f" | cut -d= -f2- || true; fi
}

meta_set() { # <slug> <key> <value>   (empty value removes the key)
  local f="$META_DIR/$1.conf" t
  mkdir -p "$META_DIR"
  t=$(mktemp "$META_DIR/.tmp.XXXXXX")
  if [[ -f $f ]]; then grep -v "^$2=" "$f" > "$t" || true; fi
  if [[ -n ${3:-} ]]; then printf '%s=%s\n' "$2" "$3" >> "$t"; fi
  mv -f -- "$t" "$f"
}

saved_opts() { # <slug> -> fills SAVED with the options used at install time
  SAVED=()
  local v
  v=$(meta_get "$1" name);   if [[ -n $v ]]; then SAVED+=(--name "$v"); fi
  v=$(meta_get "$1" args);   if [[ -n $v ]]; then SAVED+=(--args "$v"); fi
  v=$(meta_get "$1" nofuse); if [[ $v == 1 ]]; then SAVED+=(--no-fuse); fi
  v=$(meta_get "$1" icon);   if [[ -n $v && -f $v ]]; then SAVED+=(--icon "$v"); fi
  if [[ -d $(portable_dir "$1") ]]; then SAVED+=(--portable); fi
}

desktop_path() { grep -m1 '^X-AppImage-Path=' "$1" | cut -d= -f2- || true; }

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

# "Obsidian-1.5.3-x86_64.AppImage" -> "Obsidian"
name_from_file() {
  local n
  n=$(basename "$1"); n=${n%.[Aa]pp[Ii]mage}
  sed -E \
    -e 's/[-_.]?v?[0-9]+(\.[0-9]+)+.*$//' \
    -e 's/[-_.]+$//' \
    -e 's/[-_.](x86_64|x86-64|amd64|linux|linux64|64bit)$//I' \
    -e 's/[-_.]+$//' <<<"$n"
}

refresh() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
  fi
}

# AppImages do NOT detect/fall back on missing FUSE by themselves, so we check.
# Old runtimes link libfuse.so.2 dynamically; new static runtimes only need fusermount(3).
fuse_ready() { # 0 = this AppImage can be mounted normally on this system
  local f=$1 off n
  off=$("$f" --appimage-offset 2>/dev/null || true)
  [[ $off =~ ^[0-9]+$ ]] || return 0
  if grep -qa 'libfuse\.so\.2' < <(head -c "$off" "$f"); then
    n=$(ldconfig -p 2>/dev/null | grep -c 'libfuse\.so\.2' || true)
    if (( ${n:-0} > 0 )) || [[ -e /usr/lib/libfuse.so.2 ]]; then
      command -v fusermount >/dev/null 2>&1
    else
      return 1
    fi
  else
    command -v fusermount3 >/dev/null 2>&1 || command -v fusermount >/dev/null 2>&1
  fi
}

find_icon() { # <extracted root> <icon name>
  local root=$1 name=$2 c=""
  if [[ -n $name ]]; then
    c=$(find "$root" -type f -name "$name.svg" 2>/dev/null | head -n1 || true)
    if [[ -z $c ]]; then
      c=$(find "$root" -type f -name "$name.png" -printf '%s %p\n' 2>/dev/null \
          | sort -rn | head -n1 | cut -d' ' -f2- || true)
    fi
  fi
  if [[ -z $c && -e $root/.DirIcon ]]; then
    c=$(readlink -f "$root/.DirIcon" 2>/dev/null || true)
    if [[ $c != "$(readlink -f "$root")"/* || ! -f $c ]]; then c=""; fi
  fi
  printf '%s' "$c"
}

# ---------- update sources ----------
# Canonical forms stored in metadata:
#   github|OWNER/REPO|TAG|ASSET_PATTERN
#   url|https://direct/download/link

source_describe() {
  local type=${1%%|*} rest=${1#*|} repo tag pat
  case $type in
    github) IFS='|' read -r repo tag pat <<<"$rest"; echo "GitHub $repo (tag: $tag, asset: $pat)" ;;
    url)    echo "URL $rest" ;;
    *)      echo "$1" ;;
  esac
}

# Reads the update info embedded in the AppImage; prints a canonical source,
# "unsupported|<raw>" or nothing.
detect_source() { # <appimage>
  local raw owner repo tag pat url
  raw=$("$1" --appimage-updateinformation 2>/dev/null) || raw=""
  raw=${raw%%$'\n'*}
  [[ $raw =~ ^[a-z0-9-]+\| ]] || raw=""      # ignore anything that doesn't look like update info
  case $raw in
    gh-releases-zsync\|*)
      IFS='|' read -r _ owner repo tag pat <<<"$raw"
      pat=${pat%.zsync}
      printf 'github|%s/%s|%s|%s\n' "$owner" "$repo" "${tag:-latest}" "$pat" ;;
    zsync\|*)
      url=${raw#zsync|}; url=${url%.zsync}
      printf 'url|%s\n' "$url" ;;
    "") ;;
    *) printf 'unsupported|%s\n' "$raw" ;;
  esac
}

offer_source() { # <slug> <appimage>
  local found
  found=$(detect_source "$2")
  case $found in
    "")
      info "no update source found in this AppImage (add one: appimgr source $1 set ...)" ;;
    unsupported\|*)
      info "update info found, but its type is not supported: ${found#unsupported|}"
      info "add one manually: appimgr source $1 set ..." ;;
    *)
      info "update source found: $(source_describe "$found")"
      if confirm "Save it for 'appimgr update'?" y; then
        meta_set "$1" source "$found"; info "update source saved"
      else
        info "not saved (add it later: appimgr source $1 set ...)"
      fi ;;
  esac
}

parse_source_args() { # <type> <args...> -> canonical source on stdout
  local kind=${1:-} repo pat tag
  case $kind in
    github)
      repo=${2:-}; pat=${3:-}; tag=${4:-latest}; pat=${pat%.zsync}
      [[ $repo =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { warn "github needs OWNER/REPO (e.g. PrismLauncher/PrismLauncher)"; return 1; }
      [[ -n $pat ]] || { warn "github needs an asset pattern (e.g. 'Foo-*-x86_64.AppImage')"; return 1; }
      printf 'github|%s|%s|%s\n' "$repo" "$tag" "$pat" ;;
    url)
      [[ ${2:-} =~ ^https?://[^[:space:]]+$ ]] || { warn "url needs a full http(s) link"; return 1; }
      printf 'url|%s\n' "$2" ;;
    *) warn "unknown source type '$kind' (use: github or url)"; return 1 ;;
  esac
}

# Pulls tag + assets out of GitHub's release JSON without needing jq.
# Output lines: TAG<TAB>tag, PRE<TAB>true|false   and   ASSET<TAB>name<TAB>size<TAB>digest<TAB>url   ('-' = empty)
gh_parse() { # [multi]  (multi=1: report every release of a releases list, not only the first)
  awk -v multi="${1:-0}" '
    function val(s) { sub(/^[^:]*:[ \t]*"?/, "", s); sub(/"?[},\][{ \t\r]*$/, "", s); return s }
    /"tag_name"[ \t]*:/ && (multi || !gottag) { gottag=1; print "TAG\t" val($0); next }
    /^[ \t]*"prerelease"[ \t]*:/ && (multi || !gotpre) { gotpre=1; print "PRE\t" val($0); next }
    /^[ \t]*"name"[ \t]*:/   { name=val($0); next }
    /^[ \t]*"size"[ \t]*:/   { size=val($0); next }
    /^[ \t]*"digest"[ \t]*:/ { digest=val($0); next }
    /^[ \t]*"browser_download_url"[ \t]*:/ {
      print "ASSET\t" (name==""?"-":name) "\t" (size==""?"-":size) "\t" (digest==""||digest=="null"?"-":digest) "\t" val($0)
      name=""; size=""; digest=""; next
    }'
}

# One request to api.github.com. Success: 0, the JSON is in GH_BODY. Failure: 1 after a
# warning that says why, and GH_ERR = network | auth | ratelimit | forbidden | notfound | http.
# The token goes in through a curl config on a pipe, so it never shows up in the process
# list, and it is sent only to the API address given here (never to asset downloads).
# Called directly (not inside $(...)) so that GH_ERR and GH_RESET reach the caller.
GH_SENT=$'\n@@gh@@'
gh_api() { # <url>
  local url=$1 out meta body code rem reset rc=0
  local fmt="$GH_SENT|%{http_code}|%header{x-ratelimit-remaining}|%header{x-ratelimit-reset}"
  GH_BODY=""; GH_ERR=""; GH_RESET=""
  if [[ -n $GH_TOKEN ]]; then
    out=$(curl -sSL --connect-timeout 15 --max-time 60 -H 'Accept: application/vnd.github+json' \
          -K <(printf 'header = "Authorization: Bearer %s"\n' "$GH_TOKEN") -w "$fmt" "$url" 2>/dev/null) || rc=$?
  else
    out=$(curl -sSL --connect-timeout 15 --max-time 60 -H 'Accept: application/vnd.github+json' \
          -w "$fmt" "$url" 2>/dev/null) || rc=$?
  fi
  if (( rc )) || [[ $out != *"$GH_SENT"* ]]; then
    GH_ERR=network
    warn "could not reach GitHub (network problem${rc:+, curl exit $rc})"
    return 1
  fi
  meta=${out##*"$GH_SENT"}; meta=${meta#|}
  body=${out%"$GH_SENT"*}
  IFS='|' read -r code rem reset <<<"$meta" || true
  case $code in
    200) GH_BODY=$body; return 0 ;;
    401) GH_ERR=auth; if (( ! RL_QUIET )); then warn "GitHub rejected the token (HTTP 401): check GITHUB_TOKEN"; fi ;;
    403|429)
      if [[ $rem == 0 || $body == *"rate limit"* ]]; then
        GH_ERR=ratelimit
        if [[ $reset =~ ^[0-9]+$ ]]; then GH_RESET=$(date -d "@$reset" +%H:%M 2>/dev/null || true); fi
        if (( ! RL_QUIET )); then
          warn "GitHub API rate limit reached${GH_RESET:+ (resets at $GH_RESET)}"
          if [[ -z $GH_TOKEN ]]; then warn "set GITHUB_TOKEN to raise the limit from 60 to 5000 requests per hour"; fi
        fi
      else
        GH_ERR=forbidden; warn "GitHub refused the request (HTTP $code)"
      fi ;;
    404) GH_ERR=notfound; warn "not found on GitHub (HTTP 404): wrong repo or tag?" ;;
    *)   GH_ERR=http; warn "GitHub answered HTTP ${code:-?}" ;;
  esac
  return 1
}

# Closing line after a failed query (gh_api has already said why). Silent for a rate limit or a
# rejected token inside the parallel check jobs: the parent reports those once for all apps.
gh_fail() { # <OWNER/REPO> <tag>
  if [[ $GH_ERR == ratelimit || $GH_ERR == auth ]] && (( RL_QUIET )); then return 0; fi
  warn "could not query GitHub for $1 (tag: $2)"
}

# Fetches a release's JSON and leaves the gh_parse lines in GH_PARSED. Returns 1 on failure.
gh_fetch() { # <OWNER/REPO> <tag|latest>
  local api json lines
  GH_PARSED=""
  if [[ $2 == latest ]]; then api="https://api.github.com/repos/$1/releases/latest"
  else api="https://api.github.com/repos/$1/releases/tags/$2"; fi
  gh_api "$api" || return 1
  json=$GH_BODY
  lines=$(printf '%s\n' "$json" | wc -l)
  if (( lines < 5 )); then   # compact JSON -> one key per line
    json=$(printf '%s' "$json" | sed -E 's/,"/,\n"/g; s/\{"/{\n"/g; s/\["/[\n"/g')
  fi
  GH_PARSED=$(printf '%s\n' "$json" | gh_parse)
}

# For repos that publish several kinds of releases (e.g. bitwarden/clients: Desktop, Web, Browser, CLI)
# the "latest" release may not be the one that has your app. gh_scan walks the recent releases
# (newest first, prereleases skipped). For each it fills SC_TAG / SC_NAMES / SC_URLS / SC_DIGS and
# calls the test function "$2"; it stops at the first release where that returns 0.
SC_TAG=""; SC_NAMES=(); SC_URLS=(); SC_DIGS=()
gh_scan() { # <OWNER/REPO> <test function>
  local pg json parsed kind a b c d have=0 pre=0
  for pg in 1 2 3; do
    gh_api "https://api.github.com/repos/$1/releases?per_page=30&page=$pg" || return 1
    json=$GH_BODY
    if (( $(printf '%s\n' "$json" | wc -l) < 5 )); then
      json=$(printf '%s' "$json" | sed -E 's/,"/,\n"/g; s/\{"/{\n"/g; s/\["/[\n"/g')
    fi
    parsed=$(printf '%s\n' "$json" | gh_parse 1)
    [[ -n $parsed ]] || return 1
    have=0
    while IFS=$'\t' read -r kind a b c d; do
      case $kind in
        TAG)
          if (( have && ! pre )) && "$2"; then return 0; fi
          SC_TAG=$a; SC_NAMES=(); SC_URLS=(); SC_DIGS=(); have=1; pre=0 ;;
        PRE)   if [[ $a == true ]]; then pre=1; fi ;;
        ASSET) SC_NAMES+=("$a"); SC_URLS+=("$d"); SC_DIGS+=("$c") ;;
      esac
    done <<<"$parsed"
    if (( have && ! pre )) && "$2"; then return 0; fi
  done
  return 1
}

hdr_last() { # <header block> <name> -> value of the last such header
  printf '%s\n' "$1" | awk -v k="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]'):" \
    'index(tolower($0), k)==1 {v=$0} END {sub(/^[^:]*:[ ]*/, "", v); print v}'
}

# gh_scan test for latest_info (reads $pat from latest_info): take the release if it has a matching asset.
li_test() {
  local i n=0
  L_URL=""; L_NAME=""; L_SIZE=""; L_DIGEST=""
  for i in "${!SC_NAMES[@]}"; do
    # shellcheck disable=SC2053
    if [[ ${SC_NAMES[i]} == $pat ]]; then
      n=$((n+1))
      if [[ -z $L_URL ]]; then
        L_NAME=${SC_NAMES[i]}; L_URL=${SC_URLS[i]}
        if [[ ${SC_DIGS[i]} == sha256:* ]]; then L_DIGEST=${SC_DIGS[i]#sha256:}; fi
      fi
    fi
  done
  if (( n == 0 )); then return 1; fi
  L_VERSION=$SC_TAG; L_MATCHES=$n
  return 0
}

# Fills L_* for the given canonical source. Returns 1 (after a message) on failure.
latest_info() { # <canonical source>
  local type=${1%%|*} rest=${1#*|}
  L_VERSION=""; L_URL=""; L_NAME=""; L_SIZE=""; L_DIGEST=""; L_ETAG=""; L_MATCHES=0
  case $type in
    github)
      local repo tag pat parsed kind a b c d n=0 names=()
      IFS='|' read -r repo tag pat <<<"$rest"
      if gh_fetch "$repo" "$tag"; then parsed=$GH_PARSED; else gh_fail "$repo" "$tag"; return 1; fi
      while IFS=$'\t' read -r kind a b c d; do
        case $kind in
          TAG) L_VERSION=$a ;;
          ASSET)
            names+=("$a")
            # shellcheck disable=SC2053
            if [[ $a == $pat ]]; then
              n=$((n+1))
              if [[ -z $L_URL ]]; then
                L_NAME=$a; L_URL=$d
                if [[ $b != - ]]; then L_SIZE=$b; fi
                if [[ $c == sha256:* ]]; then L_DIGEST=${c#sha256:}; fi
              fi
            fi ;;
        esac
      done <<<"$parsed"
      L_MATCHES=$n
      if [[ -z $L_VERSION ]]; then warn "unexpected response from GitHub for $repo"; return 1; fi
      if [[ -z $L_URL && $tag == latest ]]; then
        if gh_scan "$repo" li_test; then
          n=$L_MATCHES   # the newest release had no matching asset; an older one does
        elif [[ -n $GH_ERR ]]; then
          gh_fail "$repo" "$tag"; return 1   # the API failed: do not claim that nothing matches
        fi
      fi
      if [[ -z $L_URL ]]; then
        warn "no asset in release '$L_VERSION' matches '$pat'"
        if ((${#names[@]})); then warn "assets found: ${names[*]}"; else warn "this release has no assets"; fi
        if [[ $tag == latest ]]; then warn "also searched the 90 newest releases: none has a matching asset"; fi
        return 1
      fi
      if (( n > 1 )); then warn "pattern matches $n assets, using $L_NAME - make the pattern more specific"; fi ;;
    url)
      local hdr lm
      hdr=$(curl -fsSIL --connect-timeout 15 --max-time 60 "$rest") || { warn "could not reach $rest"; return 1; }
      hdr=$(printf '%s\n' "$hdr" | tr -d '\r')
      L_URL=$rest
      L_NAME=${rest%%\?*}; L_NAME=${L_NAME##*/}
      if [[ -z $L_NAME ]]; then L_NAME="download.AppImage"; fi
      L_ETAG=$(hdr_last "$hdr" etag)
      L_SIZE=$(hdr_last "$hdr" content-length)
      lm=$(hdr_last "$hdr" last-modified)
      L_VERSION=${lm:-$L_ETAG} ;;
    *) warn "unsupported update source type: $type"; return 1 ;;
  esac
}

# Sets STATUS to uptodate | update | unknown by comparing the installed file with L_*.
check_status() { # <slug> <path> <canonical source>
  local slug=$1 path=$2 type=${3%%|*} sver size sum petag
  sver=$(meta_get "$slug" version)
  size=$(stat -c %s -- "$path")
  STATUS=unknown
  case $type in
    github)
      if [[ -n $L_DIGEST ]]; then
        sum=$(sha256sum -- "$path" | cut -d' ' -f1)
        if [[ $sum == "$L_DIGEST" ]]; then STATUS=uptodate; else STATUS=update; fi
      elif [[ -n $sver ]]; then
        if [[ $sver == "$L_VERSION" ]]; then STATUS=uptodate; else STATUS=update; fi
      elif [[ -n $L_SIZE ]]; then
        if [[ $L_SIZE == "$size" ]]; then STATUS=uptodate; else STATUS=update; fi
      fi ;;
    url)
      petag=$(meta_get "$slug" etag)
      if [[ -n $petag && -n $L_ETAG ]]; then
        if [[ $petag == "$L_ETAG" ]]; then STATUS=uptodate; else STATUS=update; fi
      elif [[ -n $L_SIZE ]]; then
        if [[ $L_SIZE == "$size" ]]; then STATUS=uptodate; else STATUS=update; fi
      fi ;;
  esac
}

# Downloads one file (sets DL_ETAG when curl is used). aria2c if installed, else curl.
download() { # <url> <outfile>
  local hdr
  DL_ETAG=""
  if use_aria; then
    if aria2c -x4 -s4 -k1M -c --file-allocation=none --allow-overwrite=true --auto-file-renaming=false \
         --console-log-level=warn --summary-interval=0 --download-result=hide \
         -d "$(dirname -- "$2")" -o "$(basename -- "$2")" -- "$1"; then
      return 0
    fi
    warn "aria2c failed, trying curl"
    rm -f -- "$2" "$2.aria2"
  fi
  hdr=$(mktemp)
  if ! curl -fL --retry 2 --progress-bar -D "$hdr" -o "$2" "$1"; then
    rm -f -- "$hdr" "$2"; warn "download failed: $1"; return 1
  fi
  DL_ETAG=$(tr -d '\r' <"$hdr" | awk 'index(tolower($0), "etag:")==1 {v=$0} END {sub(/^[^:]*:[ ]*/, "", v); print v}')
  rm -f -- "$hdr"
}

# Checks the downloaded file against the release's sha256 digest (L_DIGEST), when there is one.
verify_download() { # <slug> <file>
  local sum
  if [[ -n $L_DIGEST ]]; then
    sum=$(sha256sum -- "$2" | cut -d' ' -f1)
    if [[ $sum != "$L_DIGEST" ]]; then warn "$1: checksum mismatch - aborting, nothing changed"; return 1; fi
    info "sha256 verified"
  fi
}

# ---------- custom icons ----------
icon_ext() { # <file> -> png|svg, or return 1 if the type is not usable in a launcher
  local m
  m=$(file -b --mime-type -- "$1" 2>/dev/null || echo unknown)
  case $m in
    image/png)     echo png ;;
    image/svg+xml) echo svg ;;
    *) if [[ ${1,,} == *.svg ]] && grep -qa '<svg' "$1"; then echo svg; else return 1; fi ;;
  esac
}

set_desktop_icon() { # <desktop file> <icon path or name>; touches only [Desktop Entry]
  local t
  t=$(mktemp "$DESKTOP_DIR/.tmp.XXXXXX")
  IC="$2" awk '
    function flush() { if (main && !done) { print "Icon=" ENVIRON["IC"]; done=1 } }
    function out(l)  { printf "%s", pend; pend=""; print l }
    /^[ \t]*$/ { pend = pend $0 "\n"; next }          # hold blank lines so a new Icon= lands before them
    /^\[/ { flush(); main = ($0 == "[Desktop Entry]" && !seen); if (main) seen=1 }
    main && /^Icon=/ { if (!done) { out("Icon=" ENVIRON["IC"]); done=1 } ; next }
    { out($0) }
    END { flush(); printf "%s", pend }
  ' "$1" > "$t"
  chmod 644 "$t"; mv -f -- "$t" "$1"
}

embedded_icon() { # <appimage> <workdir> -> prints the path of the icon inside it ('' if none)
  local f=$1 w=$2 root=$2/squashfs-root d n="" c p
  (cd "$w" && "$f" --appimage-extract '*.desktop' >/dev/null 2>&1) || true
  d=$(find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1 || true)
  if [[ -n $d ]]; then n=$(grep -m1 '^Icon=' "$d" 2>/dev/null | cut -d= -f2- || true); fi
  for p in '.DirIcon' "$n.svg" "$n.png" 'usr/share/icons/*'; do
    (cd "$w" && "$f" --appimage-extract "$p" >/dev/null 2>&1) || true
  done
  c=$(find_icon "$root" "$n")
  if [[ -z $c ]]; then
    (cd "$w" && "$f" --appimage-extract >/dev/null 2>&1) || true
    d=$(find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1 || true)
    if [[ -n $d ]]; then n=$(grep -m1 '^Icon=' "$d" 2>/dev/null | cut -d= -f2- || true); fi
    c=$(find_icon "$root" "$n")
  fi
  printf '%s' "$c"
}

# ---------- remote add (download) ----------
R_FILE=""; R_SOURCE=""; R_VERSION=""; R_GENERIC=""; R_ASSET=""
G_REPO=""; G_TAG=""; G_FILE=""

# Recognises GitHub release links. Sets G_REPO, G_TAG ('' = latest), G_FILE ('' = a page, not a file).
gh_link_parse() { # <url>
  local u=${1%%[?#]*} r1 r2 r3 r4
  r1='^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/releases/download/([^/]+)/([^/]+)$'
  r2='^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)/releases/latest/download/([^/]+)$'
  r3='^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(/releases(/latest|/tag/([^/]+))?)?/?$'
  G_REPO=""; G_TAG=""; G_FILE=""
  if [[ $u =~ $r1 ]]; then
    G_REPO=${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}; G_TAG=${BASH_REMATCH[3]}; G_FILE=${BASH_REMATCH[4]}
  elif [[ $u =~ $r2 ]]; then
    G_REPO=${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}; G_FILE=${BASH_REMATCH[3]}
  elif [[ $u =~ $r3 ]]; then
    G_REPO=${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}; G_TAG=${BASH_REMATCH[5]:-}
  else
    return 1
  fi
}

# "Foo-1.2.3-x86_64.AppImage" -> "Foo-*-x86_64.AppImage" (version = the release tag if it appears
# in the name, else the first dotted number). No version found -> the exact name.
derive_pattern() { # <asset name> <tag>
  local name=$1 ver=${2#[vV]}
  if [[ -n $ver && $ver == *[0-9]* && $name == *"$ver"* ]]; then
    printf '%s' "${name//"$ver"/*}"
  elif [[ $name =~ [0-9]+(\.[0-9]+)+ ]]; then
    printf '%s' "${name/"${BASH_REMATCH[0]}"/*}"
  else
    printf '%s' "$name"
  fi
}

# Fills idx[] with the indexes in names[] that are candidates (reads names, asset_arg from fetch_remote).
pick_assets() {
  local i lower m
  idx=(); keep=()
  for i in "${!names[@]}"; do
    if [[ -n $asset_arg ]]; then
      # shellcheck disable=SC2053
      if [[ ${names[i]} == $asset_arg ]]; then idx+=("$i"); fi
    else
      lower=${names[i],,}
      if [[ $lower == *.appimage ]]; then idx+=("$i"); fi
    fi
  done
  if [[ -z $asset_arg ]] && ((${#idx[@]} > 1)); then   # prefer the asset for this CPU
    case $(uname -m) in
      x86_64)  m='x86_64|amd64|x64' ;;
      aarch64) m='aarch64|arm64' ;;
      *)       m=$(uname -m) ;;
    esac
    for i in "${idx[@]}"; do
      lower=${names[i],,}
      if [[ $lower =~ ($m) ]]; then keep+=("$i"); fi
    done
    if ((${#keep[@]})); then idx=("${keep[@]}"); fi
  fi
}

# gh_scan test for fetch_remote: take the release if it has a candidate asset.
fr_test() {
  names=("${SC_NAMES[@]}")
  pick_assets
  ((${#idx[@]} > 0))
}

# Downloads into $DL_DIR and fills R_FILE / R_SOURCE (candidate) / R_VERSION / R_GENERIC / R_ASSET. Returns 1 after a message on failure.
fetch_remote() { # <link or ''> <OWNER/REPO or ''> <asset pattern> <tag> <nosource 0|1>
  local link=$1 repo=$2 asset_arg=$3 tag_arg=$4 nosource=$5
  local url="" name="" digest="" ver="" pre=0 rtag="" parsed kind a b c d sum i lower m
  local names=() urls=() digs=() idx=() keep=()
  R_FILE=""; R_SOURCE=""; R_VERSION=""; R_GENERIC=""; R_ASSET=""
  need_cmd curl

  if [[ -n $link ]]; then
    if gh_link_parse "$link"; then
      repo=$G_REPO; rtag=$G_TAG
      if [[ -n $G_FILE ]]; then url=${link%%[#]*}; name=$G_FILE; fi
    else
      url=${link%%[#]*}; name=${url%%\?*}; name=${name##*/}
      [[ -n $name ]] || name="download.AppImage"
      R_GENERIC=$url
    fi
  else
    rtag=$tag_arg
  fi

  # --- GitHub release metadata (needed to pick an asset; best effort for a direct file link) ---
  if [[ -n $repo ]]; then
    if gh_fetch "$repo" "${rtag:-latest}"; then parsed=$GH_PARSED; else parsed=""; fi
    if [[ -z $parsed ]]; then
      if [[ -z $url ]]; then
        gh_fail "$repo" "${rtag:-latest}"
        return 1
      fi
      info "could not read release info from GitHub - skipping checksum and update source"
    fi
    while IFS=$'\t' read -r kind a b c d; do
      case $kind in
        TAG)   ver=$a ;;
        PRE)   if [[ $a == true ]]; then pre=1; fi ;;
        ASSET) names+=("$a"); urls+=("$d"); digs+=("$c") ;;
      esac
    done <<<"$parsed"

    if [[ -z $url ]]; then   # repo mode: choose the asset
      pick_assets
      if ((${#idx[@]} == 0)) && [[ -z $rtag || $rtag == latest ]] && gh_scan "$repo" fr_test; then
        names=("${SC_NAMES[@]}"); urls=("${SC_URLS[@]}"); digs=("${SC_DIGS[@]}"); ver=$SC_TAG
        info "newest release has no matching asset - using $ver instead"
      fi
      if ((${#idx[@]} == 0)); then
        if [[ -n $GH_ERR ]]; then return 1; fi   # the API failed while searching; gh_api said why
        if [[ -n $asset_arg ]]; then warn "no asset in release '$ver' matches '$asset_arg'"
        else warn "no .AppImage asset in release '$ver'"; fi
        if ((${#names[@]})); then warn "assets found: ${names[*]}"; else warn "this release has no assets"; fi
        return 1
      fi
      if ((${#idx[@]} > 1)); then
        if [[ -n $asset_arg ]]; then
          warn "pattern matches ${#idx[@]} assets, using ${names[${idx[0]}]} - make it more specific"
        else
          warn "several AppImage assets in '$ver' - choose one with --asset 'PATTERN':"
          for i in "${idx[@]}"; do warn "  ${names[i]}"; done
          return 1
        fi
      fi
      i=${idx[0]}; name=${names[i]}; url=${urls[i]}
    fi
    for i in "${!names[@]}"; do   # digest of the file we are about to download
      if [[ ${names[i]} == "$name" && ${digs[i]} == sha256:* ]]; then digest=${digs[i]#sha256:}; fi
    done
    if [[ -z $ver ]]; then ver=$rtag; fi
  fi

  # --- download ---
  mkdir -p "$APPS_DIR"
  DL_DIR=$(mktemp -d "$APPS_DIR/.appimgr-dl.XXXXXX")
  info "downloading $name"
  download "$url" "$DL_DIR/$name" || return 1
  if [[ -n $digest ]]; then
    sum=$(sha256sum -- "$DL_DIR/$name" | cut -d' ' -f1)
    if [[ $sum != "$digest" ]]; then warn "checksum mismatch - aborting, nothing changed"; return 1; fi
    info "sha256 verified"
  fi
  R_FILE="$DL_DIR/$name"; R_VERSION=$ver; R_ASSET=$name

  # --- update source (GitHub only; other links may be version-specific) ---
  if [[ -z $repo || $nosource == 1 ]]; then return 0; fi
  if (( pre )); then
    warn "release '$ver' is a pre-release; 'latest' only tracks stable releases, so no update source was saved"
    return 0
  fi
  local pat stag
  pat=${asset_arg:-$(derive_pattern "$name" "${ver:-$rtag}")}
  if [[ -n $tag_arg ]]; then stag=$tag_arg
  elif [[ -z $rtag || ${ver:-$rtag} == *[0-9]* ]]; then stag=latest
  else stag=${ver:-$rtag}; fi
  R_SOURCE="github|$repo|$stag|$pat"   # a candidate only; choose_source checks it
}

# Is this source certain to keep working? Sets SURE_WHY when not. (GitHub only; see header.)
source_sure() { # <canonical source> <installed asset name or ''>
  local type=${1%%|*} rest=${1#*|} repo tag pat
  SURE_WHY=""
  case $type in
    github)
      IFS='|' read -r repo tag pat <<<"$rest"
      if [[ $tag == latest && $pat != *\** ]]; then
        SURE_WHY="the pattern '$pat' has no * (version placeholder), so it can only ever match this exact release and never a newer one"; return 1
      fi
      if ! latest_info "$1" 2>/dev/null; then
        SURE_WHY="GitHub could not confirm it (network problem, or no asset in the latest release matches '$pat')"; return 1
      fi
      if (( L_MATCHES != 1 )); then
        SURE_WHY="the pattern '$pat' matches $L_MATCHES assets in $L_VERSION (e.g. several CPU architectures), so updates could pick the wrong file"; return 1
      fi
      # shellcheck disable=SC2053
      if [[ -n ${2:-} && $2 != $pat ]]; then
        SURE_WHY="the file you installed ('$2') does not match the pattern '$pat', so it was probably not the file this source tracks"; return 1
      fi ;;
    url) SURE_WHY="a plain download link cannot be verified: if it always serves the newest version, updates will work; if it points at one fixed version, 'update' will always say up to date"; return 1 ;;
    *)   SURE_WHY="unknown source type"; return 1 ;;
  esac
}

# Decides what to do about the update source after 'add'. Certain -> saved silently, else asked.
choose_source() { # <slug> <appimage> <link candidate or ''> <nosource 0|1> <installed asset name or ''>
  local slug=$1 dest=$2 link=$3 nosource=$4 asset=$5 emb="" cur
  local link_ok=0 emb_ok=0 link_why="" emb_why="" pick="" n=0 a b
  if (( nosource )); then return 0; fi
  cur=$(meta_get "$slug" source)
  if [[ -z $link && -n $cur ]]; then return 0; fi   # keep what is there (e.g. during 'update')

  emb=$(detect_source "$dest")
  if [[ $emb == unsupported\|* ]]; then
    info "AppImage update info found, but its type is not supported: ${emb#unsupported|}"; emb=""
  fi
  if [[ -z $link && -z $emb ]]; then
    info "no update source found in this AppImage (add one: appimgr source $slug set ...)"; return 0
  fi

  if [[ -n $link ]]; then
    if source_sure "$link" "$asset"; then link_ok=1; else link_why=$SURE_WHY; fi
  fi
  if [[ -n $emb ]]; then
    if [[ $emb == "$link" ]]; then emb_ok=$link_ok; emb_why=$link_why
    elif source_sure "$emb" "$asset"; then emb_ok=1; else emb_why=$SURE_WHY; fi
  fi

  if (( link_ok )); then
    pick=$link
    if [[ -n $emb && $emb != "$link" ]]; then
      if (( emb_ok )); then info "the AppImage's own update info differs; using the one from your link"
      else info "AppImage's own update info skipped: $emb_why"; fi
    fi
  elif (( emb_ok )); then
    pick=$emb
    if [[ -n $link ]]; then info "update source from the link skipped: $link_why"; fi
  fi

  if [[ -n $pick ]]; then   # certain -> no question, unless it would replace a different source
    if [[ -n $cur && $cur != "$pick" ]]; then
      info "current update source: $(source_describe "$cur")"
      if ! confirm "Replace it with: $(source_describe "$pick")?" n; then info "kept the current update source"; return 0; fi
    fi
    meta_set "$slug" source "$pick"
    info "update source saved: $(source_describe "$pick")"
    return 0
  fi

  # nothing is certain -> a human has to decide (default: save nothing)
  info "update source found - asking because I cannot be sure it will keep working:"
  a=$link; b=$emb
  if [[ -n $a ]]; then n=$((n+1)); echo "   $n) from the link:     $(source_describe "$a")"; echo "      -> $link_why"; fi
  if [[ -n $b && $b != "$a" ]]; then n=$((n+1)); echo "   $n) from the AppImage: $(source_describe "$b")"; echo "      -> $emb_why"; fi
  if [[ -n $cur ]]; then info "current update source (would be replaced): $(source_describe "$cur")"; fi
  if [[ ! -t 0 ]]; then
    info "not saved (non-interactive) - set one yourself: appimgr source $slug set ..."; return 0
  fi
  if (( n == 1 )); then ask "   Save it anyway? [1/N] (Enter = no): " || return 0
  else ask "   Save which anyway? [1/2/N] (Enter = none): " || return 0; fi
  case $REPLY in
    1) if [[ -n $a ]]; then pick=$a; else pick=$b; fi ;;
    2) if (( n == 2 )); then pick=$b; fi ;;
  esac
  if [[ -z $pick ]]; then info "not saved (add one later: appimgr source $slug set ...)"; return 0; fi
  meta_set "$slug" source "$pick"; info "update source saved: $(source_describe "$pick")"
}

# ---------- add ----------
cmd_add() {
  local src="" name="" extra="" move=1 nofuse=0 forced=0 slug_force="" icon_arg="" asked=0
  local repo_arg="" asset_arg="" tag_arg="" nosource=0 remote=0 portable=0
  while (($#)); do
    case $1 in
      -n|--name)  name=${2:?missing value for $1}; shift 2 ;;
      -a|--args)  extra=${2:?missing value for $1}; shift 2 ;;
      -i|--icon)  icon_arg=${2:?missing value for $1}; shift 2 ;;
      --slug)     slug_force=${2:?}; shift 2 ;;
      --move)     move=1; shift ;;
      --no-move)  move=0; shift ;;
      --no-fuse)  nofuse=1; forced=1; shift ;;
      --no-aria2) USE_ARIA=0; shift ;;
      --portable) portable=1; shift ;;
      --repo)     repo_arg=${2:?missing value for $1}; shift 2 ;;
      --asset)    asset_arg=${2:?missing value for $1}; shift 2 ;;
      --tag)      tag_arg=${2:?missing value for $1}; shift 2 ;;
      --no-source) nosource=1; shift ;;
      -*)         die "unknown option: $1" ;;
      *)          src=$1; shift ;;
    esac
  done
  [[ -n $src || -n $repo_arg ]] || { usage; exit 1; }
  if [[ -n $repo_arg ]]; then
    [[ -z $src ]] || die "give either a link/file or --repo, not both"
    [[ $repo_arg =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "--repo needs OWNER/REPO (e.g. PrismLauncher/PrismLauncher)"
  fi
  R_SOURCE=""; R_VERSION=""; R_GENERIC=""; R_ASSET=""
  if [[ -n $repo_arg || $src =~ ^https?://[^[:space:]]+$ ]]; then
    remote=1
    fetch_remote "$src" "$repo_arg" "$asset_arg" "$tag_arg" "$nosource" || exit 1
    src=$R_FILE
  elif [[ -n $asset_arg || -n $tag_arg ]]; then
    die "--asset and --tag only work with a download link or --repo"
  fi
  [[ -f $src ]] || die "file not found: $src"
  [[ $(head -c4 "$src" | tail -c3) == ELF ]] || die "not an ELF/AppImage file: $src"
  if [[ -n $icon_arg ]]; then
    [[ -f $icon_arg ]] || die "icon file not found: $icon_arg"
    icon_ext "$icon_arg" >/dev/null || die "icon does not look like a PNG or SVG file: $icon_arg"
  fi

  mkdir -p "$APPS_DIR" "$ICONS_DIR" "$DESKTOP_DIR"
  TMP_DIR=$(mk_tmp)
  STAGE_FILE="$APPS_DIR/.appimgr-stage.$$"
  local tmp=$TMP_DIR stage=$STAGE_FILE

  cp -- "$src" "$stage"
  chmod +x "$stage"

  # --- extract only what we need (extraction does not require FUSE) ---
  local work="$tmp/x" root="$tmp/x/squashfs-root" full=0
  mkdir -p "$work"
  run_extract() { (cd "$work" && "$stage" --appimage-extract "$@" >/dev/null 2>&1) || true; }
  full_extract() { rm -rf "$work"; mkdir -p "$work"; run_extract; full=1; }

  run_extract '*.desktop'
  local deskfile=""
  find_desktop() {
    [[ -d $root ]] || return 0
    find "$root" -maxdepth 1 -name '*.desktop' 2>/dev/null | head -n1 || true
  }
  deskfile=$(find_desktop)
  if [[ -z $deskfile ]]; then
    full_extract; deskfile=$(find_desktop)
  elif [[ ! -e $deskfile ]]; then
    # root entry is a symlink into usr/share/applications - extract its target too
    local target
    target=$(readlink "$deskfile" || true); target=${target#./}
    if [[ -n $target && $target != /* ]]; then run_extract "$target"; fi
    if [[ ! -e $deskfile ]]; then full_extract; deskfile=$(find_desktop); fi
  fi
  [[ -d $root ]] || die "extraction failed - is this a valid type-2 AppImage?"

  local iconname="" dname=""
  if [[ -n $deskfile ]]; then
    iconname=$(grep -m1 '^Icon=' "$deskfile" | cut -d= -f2- || true)
    dname=$(grep -m1 '^Name=' "$deskfile" | cut -d= -f2- || true)
  fi

  local icon_src=""
  if (( ! full )) && [[ -n $iconname ]]; then
    local p
    for p in '.DirIcon' "$iconname.svg" "$iconname.png" 'usr/share/icons/*'; do run_extract "$p"; done
  fi
  icon_src=$(find_icon "$root" "$iconname")
  if [[ -z $icon_src ]] && (( ! full )); then
    full_extract
    icon_src=$(find_icon "$root" "$iconname")
  fi

  # --- FUSE check ---
  if (( ! nofuse )) && ! fuse_ready "$stage"; then
    nofuse=1
    info "FUSE not usable for this AppImage -> extract-and-run mode (install fuse2 for normal, faster launching)"
  fi

  # --- names / paths ---
  local display slug dest fbase
  display="${name:-${dname:-$(name_from_file "$src")}}"
  slug="${slug_force:-$(slugify "$display")}"
  if [[ -z $slug ]]; then   # name without Latin letters: use the file name instead
    slug=$(slugify "$(name_from_file "$src")")
  fi
  if [[ -z $slug ]]; then
    fbase=${src##*/}; fbase=${fbase%.[Aa]pp[Ii]mage}
    slug=$(slugify "$fbase")
  fi
  [[ -n $slug ]] || slug="app"
  dest="$APPS_DIR/$slug.AppImage"

  # --- custom icon: --icon always wins; we only ask when the AppImage has none ---
  local custom_icon="" cext=""
  if [[ -z $icon_arg && -z $icon_src && -t 0 && -z $(meta_get "$slug" iconasked) ]]; then
    asked=1; REPLY=""
    ask "   No icon found in this AppImage. Path to a PNG/SVG icon (Enter = generic icon): " || true
    if [[ -n $REPLY ]]; then
      icon_arg=$(clean_path "$REPLY")
      if [[ ! -f $icon_arg ]] || ! icon_ext "$icon_arg" >/dev/null; then
        warn "not a usable PNG/SVG file: $icon_arg - using generic icon"; icon_arg=""
      fi
    fi
  fi
  if [[ -n $icon_arg ]]; then
    cext=$(icon_ext "$icon_arg")
    cp -- "$icon_arg" "$tmp/custom.$cext"; custom_icon="$tmp/custom.$cext"
  fi
  local src_real dest_real
  src_real=$(readlink -f -- "$src"); dest_real="$(readlink -f -- "$APPS_DIR")/$slug.AppImage"
  if [[ -e $dest ]]; then
    info "replacing existing $dest (previous version kept for: appimgr rollback $slug)"
    mkdir -p "$BACKUP_DIR"
    mv -f -- "$dest" "$BACKUP_DIR/$slug.AppImage"
  fi
  mv -f "$stage" "$dest"

  # --- portable mode: the AppImage runtime uses <file>.AppImage.home as $HOME when it exists ---
  if (( portable )); then
    mkdir -p -- "$dest.home"
    info "portable mode: the app's data goes to $(tilde "$dest.home")"
  fi

  # --- icon (stored next to the AppImages, referenced by absolute path) ---
  local icon_id="application-x-executable"
  find "$ICONS_DIR" -maxdepth 1 -name "$slug.*" -delete 2>/dev/null || true
  rm -f -- "$ICONS_DIR/custom/$slug".*
  if [[ -n $custom_icon ]]; then
    mkdir -p "$ICONS_DIR/custom"
    icon_id="$ICONS_DIR/custom/$slug.$cext"
    install -m644 "$custom_icon" "$icon_id"
    info "using custom icon"
  elif [[ -n $icon_src ]]; then
    local mime ext=""
    mime=$(file -b --mime-type "$icon_src" 2>/dev/null || echo unknown)
    case $mime in
      image/svg+xml) ext=svg ;;
      image/png)     ext=png ;;
      *) info "icon type '$mime' not supported, using generic icon" ;;
    esac
    if [[ -n $ext ]]; then
      install -m644 "$icon_src" "$ICONS_DIR/$slug.$ext"
      icon_id="$ICONS_DIR/$slug.$ext"
    fi
  elif (( ! asked )); then
    info "no icon found in AppImage, using generic icon (set one: appimgr icon $slug FILE)"
  fi

  # --- desktop entry ---
  local exec_cmd="\"$dest\""
  if (( nofuse )); then exec_cmd="env APPIMAGE_EXTRACT_AND_RUN=1 $exec_cmd"; fi
  local out="$DESKTOP_DIR/appimage-$slug.desktop"

  if [[ -n $deskfile ]]; then
    EXEC_CMD="$exec_cmd" EXTRA="$extra" ICON="$icon_id" APPPATH="$dest" NAME_OVR="$name" \
    awk '
      BEGIN { cmd=ENVIRON["EXEC_CMD"]; extra=ENVIRON["EXTRA"]; icon=ENVIRON["ICON"]
              p=ENVIRON["APPPATH"]; nm=ENVIRON["NAME_OVR"] }
      /^\[Desktop Entry\]/ && !seen { print; print "X-AppImage-Managed=appimgr"; print "X-AppImage-Path=" p; seen=1; main=1; next }
      /^\[/ && !/^\[Desktop Entry\]/ { main=0 }
      /^(TryExec|X-AppImage-Integrate|X-AppImage-Managed|X-AppImage-Path)=/ { next }
      /^Name=/ && nm != "" && main { print "Name=" nm; next }
      /^Icon=/ && main { print "Icon=" icon; next }
      /^Exec=/ {
        rest=$0; sub(/^Exec=[ \t]*/, "", rest)
        if (rest ~ /^"/) sub(/^"[^"]*"[ \t]*/, "", rest); else sub(/^[^ \t]+[ \t]*/, "", rest)
        o="Exec=" cmd
        if (extra != "") o = o " " extra
        if (rest != "") o = o " " rest
        print o; next
      }
      { print }
    ' "$deskfile" > "$out"
  else
    info "no .desktop file inside AppImage, generating one"
    cat > "$out" <<EOF
[Desktop Entry]
X-AppImage-Managed=appimgr
X-AppImage-Path=$dest
Type=Application
Name=$display
Exec=$exec_cmd${extra:+ $extra}
Icon=$icon_id
Terminal=false
Categories=Utility;
EOF
  fi
  chmod 644 "$out"

  refresh
  if (( move )) && [[ $src_real != "$dest_real" ]]; then rm -f -- "$src"; fi

  # --- remember how it was installed (reused by 'update') ---
  meta_set "$slug" name "$name"
  meta_set "$slug" args "$extra"
  if (( forced )); then meta_set "$slug" nofuse 1; else meta_set "$slug" nofuse ""; fi
  meta_set "$slug" installed "$(date +%F)"
  meta_set "$slug" icon "${custom_icon:+$icon_id}"
  if (( asked )); then meta_set "$slug" iconasked 1; fi
  meta_set "$slug" version "$R_VERSION"
  meta_set "$slug" etag ""

  info "integrated: $display"
  echo "   slug:    $slug"
  echo "   binary:  $dest"
  if (( nofuse )); then echo "   mode:    extract-and-run (no FUSE)"; else echo "   mode:    normal (FUSE)"; fi
  if [[ -d $dest.home ]]; then echo "   data:    portable ($(tilde "$dest.home"))"; fi
  echo "   entry:   $out"

  choose_source "$slug" "$dest" "$R_SOURCE" "$nosource" "$R_ASSET"
  if [[ -n $R_GENERIC && -z $(meta_get "$slug" source) ]]; then
    info "if this link always serves the newest version: appimgr source $slug set url '$R_GENERIC'"
  fi

  rm -rf -- "$TMP_DIR"; TMP_DIR=""; STAGE_FILE=""
  if (( remote )); then rm -rf -- "$DL_DIR"; DL_DIR=""; fi
}

# ---------- update ----------
# Looks up the latest version of one app. Sets CK = nosource | error | uptodate | update | unknown,
# CK_SAVED (installed version label) and the L_* variables. Prints only warnings.
CK=""; CK_SAVED=""
check_one() { # <slug>
  local slug=$1 df src path
  df="$DESKTOP_DIR/appimage-$slug.desktop"   # (not in the local line: $slug would still be the caller's value there)
  CK=error; CK_SAVED=""; GH_ERR=""; GH_RESET=""
  [[ -f $df ]] || { warn "not integrated: $slug (see: appimgr list)"; return 0; }
  src=$(meta_get "$slug" source)
  if [[ -z $src ]]; then CK=nosource; return 0; fi
  path=$(desktop_path "$df")
  [[ -f $path ]] || { warn "$slug: binary missing: $path"; return 0; }
  need_cmd curl
  latest_info "$src" || return 0
  check_status "$slug" "$path" "$src"
  CK_SAVED=$(meta_get "$slug" version)
  CK=$STATUS
}

# Prints what a parallel check job found, as shell assignments (%q-quoted, so reading it back is safe).
dump_result() {
  local v
  for v in CK CK_SAVED L_VERSION L_URL L_NAME L_SIZE L_DIGEST L_ETAG GH_ERR GH_RESET; do
    printf '%s=%q\n' "$v" "${!v}"
  done
}

# Installs what the L_* variables describe for <slug>. With a third argument that file is used
# (already downloaded by prefetch_batch); otherwise it is downloaded here.
install_one() { # <slug> <canonical source> [<downloaded file>]
  local slug=$1 src=$2 file=${3:-} own=0 type
  if [[ -z $file ]]; then
    own=1
    mkdir -p "$APPS_DIR"
    DL_DIR=$(mktemp -d "$APPS_DIR/.appimgr-dl.XXXXXX")
    info "downloading $L_NAME"
    download "$L_URL" "$DL_DIR/$L_NAME" || return 1
    file=$DL_DIR/$L_NAME
  else
    DL_ETAG=""
  fi
  verify_download "$slug" "$file" || return 1

  saved_opts "$slug"
  cmd_add --slug "$slug" "${SAVED[@]}" "$file"
  meta_set "$slug" version "$L_VERSION"
  type=${src%%|*}
  if [[ $type == url ]]; then meta_set "$slug" etag "${DL_ETAG:-$L_ETAG}"; fi
  if (( own )); then rm -rf -- "$DL_DIR"; DL_DIR=""; fi
}

# Single app: check, show the result, ask, install.
update_one() { # <slug> <check_only 0|1> <yes 0|1> <quiet_if_no_source 0|1>
  local slug=$1 check=$2 yes=$3 quiet=$4
  check_one "$slug"
  case $CK in
    error)    return 1 ;;
    nosource) if (( ! quiet )); then info "$slug: no update source saved (see: appimgr source)"; fi; return 0 ;;
    uptodate) info "$slug: up to date${L_VERSION:+ ($L_VERSION)}"; return 0 ;;
    update)   info "$slug: update available: ${CK_SAVED:-installed} -> ${L_VERSION:-latest}  [$L_NAME]" ;;
    *)        info "$slug: cannot tell if this is newer (latest: ${L_VERSION:-?}  [$L_NAME])" ;;
  esac
  if (( check )); then return 0; fi
  if (( ! yes )); then
    if ! confirm "Download and install it?" n; then info "$slug: skipped"; return 0; fi
  fi
  install_one "$slug" "$(meta_get "$slug" source)"
}

# Downloads every pending update at once with a single aria2c run into BATCH_DIR/<index>/.
# Fills PF[i] with the finished file of app i; an app whose download failed gets no entry and is
# downloaded again with curl by install_one. Reads B_SLUG, B_URL, B_NAME, B_SIZE from update_batch.
prefetch_batch() {
  local i name list cnt=0 total=0 avail rc=0
  PF=()
  mkdir -p "$APPS_DIR"
  BATCH_DIR=$(mktemp -d "$APPS_DIR/.appimgr-dl.XXXXXX")
  list="$BATCH_DIR/aria2.in"
  : > "$list"
  for i in "${!B_SLUG[@]}"; do
    name=${B_NAME[i]}
    if [[ -z $name || $name == */* ]]; then continue; fi
    mkdir -p "$BATCH_DIR/$i"
    printf '%s\n  dir=%s\n  out=%s\n' "${B_URL[i]}" "$BATCH_DIR/$i" "$name" >> "$list"
    cnt=$((cnt+1))
    if [[ ${B_SIZE[i]} =~ ^[0-9]+$ ]]; then total=$((total + B_SIZE[i])); fi
  done
  if (( cnt == 0 )); then return 0; fi

  if (( total >= 1048576 )); then info "downloading $cnt file(s) with aria2c, about $((total / 1048576)) MiB"
  else info "downloading $cnt file(s) with aria2c"; fi
  if (( total > 0 )); then
    avail=$(df -B1 --output=avail -- "$APPS_DIR" 2>/dev/null | tail -n1 | tr -dc '0-9' || true)
    if [[ -n $avail ]] && (( avail < total + total / 2 )); then
      warn "low disk space: $((avail / 1048576)) MiB free in $APPS_DIR, the updates need about $((total / 1048576)) MiB plus room to install"
    fi
  fi
  aria2c -i "$list" -j 3 -x4 -s4 -k1M -c --file-allocation=none --allow-overwrite=true --auto-file-renaming=false \
    --console-log-level=warn --summary-interval=0 --download-result=hide || rc=$?
  for i in "${!B_SLUG[@]}"; do
    name=${B_NAME[i]}
    if [[ -f $BATCH_DIR/$i/$name && ! -e $BATCH_DIR/$i/$name.aria2 ]]; then PF[i]=$BATCH_DIR/$i/$name; fi
  done
  if (( rc )); then warn "aria2c reported problems; a missing file is downloaded again on its own"; fi
}

# All apps: check everything first (in parallel), list what is ready, ask ONCE, download
# everything together, then install them one by one.
update_batch() { # <check_only 0|1> <yes 0|1>
  local check=$1 yes=$2 f slug i n k ok=0 rc running=0 reset_hm=""
  local B_SLUG=() B_SRC=() B_URL=() B_NAME=() B_DIGEST=() B_VER=() B_ETAG=() B_SIZE=()
  local unk=() err=() failed=() rl=() slugs=() badtoken=0
  for f in "$DESKTOP_DIR"/appimage-*.desktop; do
    [[ -f $f ]] || continue
    grep -q '^X-AppImage-Managed=appimgr' "$f" || continue
    slug=${f##*/appimage-}; slugs+=("${slug%.desktop}")
  done
  k=${#slugs[@]}
  if (( k == 0 )); then info "nothing to update"; return 0; fi

  # --- phase 1: checks, JOBS at a time. Each job writes its messages and its result to files. ---
  SCRATCH=$(mktemp -d)
  if (( k > 1 )); then info "checking $k app(s), up to $JOBS at a time ..."; fi
  for i in "${!slugs[@]}"; do
    while (( running >= JOBS )); do wait -n || true; running=$((running - 1)); done
    ( RL_QUIET=1; check_one "${slugs[i]}"; dump_result >"$SCRATCH/$i.res" ) >"$SCRATCH/$i.msg" 2>&1 &
    running=$((running + 1))
  done
  wait || true

  # --- results, in app order ---
  for i in "${!slugs[@]}"; do
    slug=${slugs[i]}
    CK=error; CK_SAVED=""; GH_ERR=""; GH_RESET=""
    L_VERSION=""; L_URL=""; L_NAME=""; L_SIZE=""; L_DIGEST=""; L_ETAG=""
    if [[ -s $SCRATCH/$i.msg ]]; then cat -- "$SCRATCH/$i.msg" >&2; fi
    if [[ -f $SCRATCH/$i.res ]]; then
      # shellcheck source=/dev/null
      source "$SCRATCH/$i.res"
    else
      warn "$slug: the check did not finish"
    fi
    if [[ $CK == error && ( $GH_ERR == ratelimit || $GH_ERR == auth ) ]]; then
      rl+=("$slug"); reset_hm=${GH_RESET:-$reset_hm}
      if [[ $GH_ERR == auth ]]; then badtoken=1; fi
      continue
    fi
    case $CK in
      nosource) ;;
      error)    err+=("$slug") ;;
      uptodate) info "$slug: up to date${L_VERSION:+ ($L_VERSION)}" ;;
      update)
        info "$slug: update available: ${CK_SAVED:-installed} -> ${L_VERSION:-latest}"
        B_SLUG+=("$slug"); B_SRC+=("$(meta_get "$slug" source)"); B_URL+=("$L_URL"); B_NAME+=("$L_NAME")
        B_DIGEST+=("$L_DIGEST"); B_VER+=("$L_VERSION"); B_ETAG+=("$L_ETAG"); B_SIZE+=("$L_SIZE") ;;
      *)        unk+=("$slug") ;;
    esac
  done
  rm -rf -- "$SCRATCH"; SCRATCH=""

  if (( ${#rl[@]} )); then
    if (( badtoken )); then
      warn "GitHub rejected the token (HTTP 401), check GITHUB_TOKEN: could not check ${rl[*]}"
    else
      warn "GitHub API rate limit reached${reset_hm:+ (resets at $reset_hm)}: could not check ${rl[*]}"
      if [[ -z $GH_TOKEN ]]; then warn "set GITHUB_TOKEN to raise the limit from 60 to 5000 requests per hour"; fi
    fi
  fi
  if (( ${#err[@]} )); then warn "could not check: ${err[*]}"; fi
  if (( ${#unk[@]} )); then info "cannot tell if newer (skipped; force with 'appimgr update <slug>'): ${unk[*]}"; fi
  n=${#B_SLUG[@]}
  if (( n == 0 )); then
    if (( ${#rl[@]} + ${#err[@]} )); then info "no updates among the apps that could be checked"
    else info "nothing to update"; fi
    return 0
  fi
  if (( check )); then info "$n update(s) available: ${B_SLUG[*]}"; return 0; fi

  info "$n update(s) ready: ${B_SLUG[*]}"
  if (( ! yes )); then
    if ! confirm "Install all $n?" n; then info "skipped"; return 0; fi
  fi

  # --- phase 2: download everything together (aria2c), phase 3: install one by one ---
  PF=()
  if use_aria; then prefetch_batch; fi
  for (( i = 0; i < n; i++ )); do
    slug=${B_SLUG[i]}
    L_URL=${B_URL[i]}; L_NAME=${B_NAME[i]}; L_DIGEST=${B_DIGEST[i]}; L_VERSION=${B_VER[i]}; L_ETAG=${B_ETAG[i]}
    info "[$((i+1))/$n] $slug"
    # own subshell so one failing app (even a die) does not stop the others; it must not
    # clean up the shared download folder, so BATCH_DIR is blanked there
    set +e
    ( set -e; BATCH_DIR=""; SCRATCH=""; trap cleanup EXIT; install_one "$slug" "${B_SRC[i]}" "${PF[i]:-}" )
    rc=$?
    set -e
    if (( rc )); then failed+=("$slug"); else ok=$((ok+1)); fi
    if [[ -n $BATCH_DIR ]]; then rm -rf -- "$BATCH_DIR/$i"; fi
  done
  if [[ -n $BATCH_DIR ]]; then rm -rf -- "$BATCH_DIR"; BATCH_DIR=""; fi
  info "updated $ok of $n"
  if (( ${#failed[@]} )); then warn "failed: ${failed[*]}"; return 1; fi
  return 0
}

cmd_update() {
  local slug="" file="" all=0 check=0 yes=0 pass=()
  while (($#)); do
    case $1 in
      --all)      all=1; shift ;;
      --check)    check=1; shift ;;
      -y|--yes)   yes=1; shift ;;
      -j|--jobs)  set_jobs "${2:?missing value for $1}"; shift 2 ;;
      --no-aria2) USE_ARIA=0; shift ;;
      -n|--name|-a|--args|-i|--icon) pass+=("$1" "${2:?missing value for $1}"); shift 2 ;;
      --no-fuse|--no-move|--move|--portable) pass+=("$1"); shift ;;
      -*)         die "unknown option: $1" ;;
      *)
        if (( all )); then die "unexpected argument: $1"
        elif [[ -z $slug ]]; then slug=$1
        elif [[ -z $file ]]; then file=$1
        else die "unexpected argument: $1"; fi
        shift ;;
    esac
  done
  set_jobs "$JOBS"   # also checks APPIMGR_JOBS

  if [[ -z $slug ]]; then
    if (( ${#pass[@]} )); then die "options ${pass[0]} ... only work with: appimgr update <slug> <file>"; fi
    all=1   # no slug: same as --all
  fi

  if (( all )); then
    update_batch "$check" "$yes"
    return
  fi

  [[ -f $DESKTOP_DIR/appimage-$slug.desktop ]] || die "not integrated: $slug (see: appimgr list)"
  if [[ -n $file ]]; then
    saved_opts "$slug"
    cmd_add --slug "$slug" "${SAVED[@]}" "${pass[@]}" "$file"
  else
    update_one "$slug" "$check" "$yes" 0
  fi
}

cmd_rollback() {
  local slug=${1:-}
  [[ -n $slug ]] || { usage; exit 1; }
  local df="$DESKTOP_DIR/appimage-$slug.desktop" dest bak="$BACKUP_DIR/$slug.AppImage"
  [[ -f $df ]] || die "not integrated: $slug (see: appimgr list)"
  [[ -f $bak ]] || die "no previous version stored for $slug"
  dest=$(desktop_path "$df")
  [[ -f $dest ]] || die "AppImage binary missing: $dest"
  mv -f -- "$dest" "$dest.swap"
  mv -f -- "$bak" "$dest"
  mv -f -- "$dest.swap" "$bak"
  meta_set "$slug" version ""
  meta_set "$slug" etag ""
  info "$slug: swapped with the previous version (run 'appimgr rollback $slug' again to undo)"
}

# ---------- source ----------
cmd_source() {
  local slug=${1:-} action=${2:-} cur new
  if [[ -z $slug ]]; then source_help; return 0; fi
  [[ -f $DESKTOP_DIR/appimage-$slug.desktop ]] || die "not integrated: $slug (see: appimgr list)"
  case $action in
    "")
      cur=$(meta_get "$slug" source)
      if [[ -n $cur ]]; then echo "$slug: $(source_describe "$cur")"
      else echo "$slug: no update source saved (see: appimgr source)"; fi ;;
    clear)
      meta_set "$slug" source ""; info "$slug: update source removed" ;;
    set)
      shift 2
      new=$(parse_source_args "$@") || { echo >&2; source_help >&2; exit 1; }
      need_cmd curl
      info "checking source ..."
      latest_info "$new" || die "source check failed - not saved"
      info "OK: found $L_NAME (${L_VERSION:-version unknown})"
      meta_set "$slug" source "$new"
      info "$slug: saved update source: $(source_describe "$new")" ;;
    *) die "unknown action '$action' (use: set | clear)" ;;
  esac
}

# ---------- run / remove / list ----------
cmd_run() {
  local slug=${1:-} detach=0
  [[ -n $slug ]] || { usage; exit 1; }
  shift
  if [[ ${1:-} == -d || ${1:-} == --detach ]]; then detach=1; shift; fi

  local df="$DESKTOP_DIR/appimage-$slug.desktop" path line rest
  [[ -f $df ]] || die "not integrated: $slug (see: appimgr list)"
  path=$(desktop_path "$df")
  [[ -n $path && -x $path ]] || die "AppImage binary missing: ${path:-unknown}"

  # reuse launcher settings: extract-and-run mode and extra args from the Exec line
  local cmd=()
  line=$(grep -m1 '^Exec=' "$df" || true)
  if [[ $line == *APPIMAGE_EXTRACT_AND_RUN=1* ]]; then cmd=(env APPIMAGE_EXTRACT_AND_RUN=1); fi
  cmd+=("$path")
  rest=${line#*\"$path\"}
  if [[ $rest != "$line" ]]; then
    rest=${rest//%[UuFfDdNnickvm]/}      # drop desktop-entry field codes
    local extra=()
    read -ra extra <<<"$rest" || true
    cmd+=("${extra[@]}")
  fi
  cmd+=("$@")

  if (( detach )); then
    setsid -f "${cmd[@]}" >/dev/null 2>&1 </dev/null
  else
    exec "${cmd[@]}"
  fi
}

urlencode_path() { # percent-encode a path for .trashinfo
  local LC_ALL=C s=$1 out="" c h i
  for ((i=0; i<${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [A-Za-z0-9/._~-]) out+=$c ;;
      *) printf -v h '%%%02X' "'$c"; out+=$h ;;
    esac
  done
  printf '%s' "$out"
}

# Moves a file or folder into the freedesktop.org home Trash (restorable from file
# managers or with trash-cli). Prints the name it has in the Trash.
trash_file() { # <file or folder>
  local f=$1 tdir="$DATA_HOME/Trash" base target n=1
  mkdir -p "$tdir/files" "$tdir/info"
  base=$(basename -- "$f"); target=$base
  while [[ -e $tdir/files/$target || -e $tdir/info/$target.trashinfo ]]; do
    n=$((n+1))
    if [[ $base == ?*.* ]]; then target="${base%.*}.$n.${base##*.}"   # foo.AppImage -> foo.2.AppImage
    else target="$base.$n"; fi                                       # Foo / .foo   -> Foo.2 / .foo.2
  done
  printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' \
    "$(urlencode_path "$(readlink -f -- "$f")")" "$(date +%Y-%m-%dT%H:%M:%S)" > "$tdir/info/$target.trashinfo"
  if ! mv -- "$f" "$tdir/files/$target"; then
    rm -f -- "$tdir/info/$target.trashinfo"; return 1
  fi
  printf '%s' "$target"
}

# ---------- leftover data ----------
# Delete one data file/folder: caches for good (they can be rebuilt), the rest to the Trash
# unless permanent=1. Refuses anything that is not clearly inside your home or the AppImage folder.
discard() { # <path> <permanent 0|1>
  local p=$1 perm=${2:-0}
  [[ -n $p && ( $p == "$HOME"/?* || $p == "$APPS_DIR"/?* ) ]] || return 1
  [[ -e $p || -L $p ]] || return 0
  case $p in "${XDG_CACHE_HOME:-$HOME/.cache}"/*) perm=1 ;; esac
  if (( perm )); then
    rm -rf -- "$p"
  else
    trash_file "$p" >/dev/null || return 1
  fi
}

# Lowercase letters and digits only, result in REPLY: "Foo-Bar 2" -> "foobar2"
norm_name() { local s=${1,,}; REPLY=${s//[^[:alnum:]]/}; }

# Fills LEFT[] with folders/files that look like they belong to the app. The match is by name only
# (exact, ignoring case and punctuation), so it is a list to review, never an automatic deletion.
find_leftovers() { # <slug> <desktop file>
  local slug=$1 df=$2 c root e b key n want=" " seen=$'\n' entries=() cand=()
  LEFT=()
  cand+=("$slug")
  if [[ -f $df ]]; then
    cand+=("$(grep -m1 '^Name=' "$df" | cut -d= -f2- || true)")
    cand+=("$(grep -m1 '^StartupWMClass=' "$df" | cut -d= -f2- || true)")
  fi
  for c in "${cand[@]}"; do
    norm_name "$c"; n=$REPLY
    if (( ${#n} >= 3 )) && [[ $want != *" $n "* ]]; then want+="$n "; fi
  done
  [[ $want != " " ]] || return 0
  for root in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_CACHE_HOME:-$HOME/.cache}" \
              "$DATA_HOME" "${XDG_STATE_HOME:-$HOME/.local/state}" "$HOME"; do
    [[ -d $root ]] || continue
    if [[ $root == "$HOME" ]]; then entries=("$root"/.[!.]*); else entries=("$root"/*); fi
    for e in "${entries[@]}"; do
      [[ -e $e || -L $e ]] || continue
      [[ $e == "$APPS_DIR" || $e == "$APPS_DIR".* ]] && continue
      b=${e##*/}; key=${b#.}
      case ${key,,} in *.conf|*.ini|*.json|*.toml|*.cfg|*.yaml|*.yml) key=${key%.*} ;; esac
      norm_name "$key"; n=$REPLY
      [[ -n $n && $want == *" $n "* ]] || continue
      case $n in   # folders that belong to the system or to other tools, even if an app shares the name
        appimages|applications|autostart|systemd|dconf|fish|nvim|vim|gtk|gtk20|gtk30|gtk40|pulse|pipewire|wireplumber|\
        mime|icons|fonts|fontconfig|themes|trash|flatpak|keyrings|kde|kdeglobals|plasma|dolphin|niri|dms|quickshell|\
        snapper|git|ssh|gnupg|mozilla|chromium|config|cache|local|share|state|bin|var|steam|wine|python|pip|npm|\
        cargo|rustup|mesa|nvidia|thumbnails|userdirs|xdg|nautilus|environmentd) continue ;;
      esac
      if [[ $seen == *$'\n'"$e"$'\n'* ]]; then continue; fi
      seen+="$e"$'\n'
      LEFT+=("$e")
    done
  done
}

# After the app is gone: delete its portable data folder (certain), then offer the by-name list.
handle_data() { # <portable folder or ''> <permanent 0|1> <yes 0|1>
  local pdir=$1 purge=$2 yes=$3 i size p tok nums=() pick=()
  if [[ -n $pdir && -d $pdir ]]; then
    size=$(du -sh -- "$pdir" 2>/dev/null | cut -f1 || true)
    if discard "$pdir" "$purge"; then info "portable data removed (${size:-?}): $(tilde "$pdir")"
    else warn "could not remove the portable data folder: $pdir"; fi
  fi
  if (( ${#LEFT[@]} == 0 )); then
    info "no other leftover data found by name (an app can use any folder name: check ~/.config, ~/.cache and ~/.local/share yourself)"
    return 0
  fi
  info "possible leftover data, matched by name only:"
  for i in "${!LEFT[@]}"; do
    size=$(du -sh -- "${LEFT[i]}" 2>/dev/null | cut -f1 || true)
    printf '   %2d) %7s  %s\n' $((i+1)) "${size:-?}" "$(tilde "${LEFT[i]}")"
  done
  if (( yes )) || [[ ! -t 0 ]]; then
    info "none of these was deleted (a name match needs your choice); remove them by hand if they are the app's"
    return 0
  fi
  ask "   Delete which? numbers separated by spaces, a = all, Enter = none: " || return 0
  if [[ -z $REPLY ]]; then info "nothing deleted"; return 0; fi
  if [[ $REPLY == [Aa] ]]; then
    pick=("${LEFT[@]}")
  else
    read -ra nums <<<"$REPLY" || true
    for tok in ${nums[@]+"${nums[@]}"}; do
      if [[ $tok =~ ^[0-9]{1,4}$ ]] && (( 10#$tok >= 1 && 10#$tok <= ${#LEFT[@]} )); then
        pick+=("${LEFT[10#$tok-1]}")
      else
        warn "ignored: $tok"
      fi
    done
  fi
  for p in ${pick[@]+"${pick[@]}"}; do
    if discard "$p" "$purge"; then info "removed: $(tilde "$p")"; else warn "could not remove: $p"; fi
  done
}

cmd_remove() {
  local slug="" yes=0 purge=0 pdata=0
  while (($#)); do
    case $1 in
      -y|--yes)    yes=1; shift ;;
      --purge)     purge=1; shift ;;
      --purge-data) pdata=1; shift ;;
      -*)          die "unknown option: $1" ;;
      *)           if [[ -z $slug ]]; then slug=$1; else die "unexpected argument: $1"; fi; shift ;;
    esac
  done
  [[ -n $slug ]] || { usage; exit 1; }
  local df="$DESKTOP_DIR/appimage-$slug.desktop" path="" name has_file=0 trashed="" pdir has_pdir=0
  [[ -f $df ]] || die "not integrated: $slug (see: appimgr list)"
  path=$(desktop_path "$df")
  name=$(grep -m1 '^Name=' "$df" | cut -d= -f2- || true)
  if [[ -n $path && $path == "$APPS_DIR"/* && -f $path ]]; then has_file=1; fi
  pdir=$(portable_dir "$slug")
  if [[ -d $pdir ]]; then has_pdir=1; fi

  if (( ! yes )); then
    info "remove '${name:-$slug}' ($slug)?"
    echo "   - launcher entry, icon and update settings are deleted"
    if (( has_file && purge )); then echo "   - the AppImage is deleted PERMANENTLY"
    elif (( has_file )); then echo "   - the AppImage is moved to the Trash (restorable)"; fi
    if [[ -f $BACKUP_DIR/$slug.AppImage ]]; then echo "   - the previous version (rollback copy) is deleted"; fi
    if (( has_pdir && pdata )); then echo "   - its portable data folder is deleted ($(tilde "$pdir"))"
    elif (( has_pdir )); then echo "   - its portable data folder is KEPT ($(tilde "$pdir")); add --purge-data to delete it"; fi
    if (( pdata )); then echo "   - you choose which leftover data found by name is deleted"; fi
    if ! confirm "Continue?" n; then info "cancelled (non-interactive? use -y)"; return 0; fi
    if (( ! pdata )) && [[ -t 0 ]]; then
      if confirm "Also look for leftover data (config, cache, ...)?" n; then pdata=1; fi
    fi
  fi

  if (( pdata )); then
    if command -v pgrep >/dev/null 2>&1 && [[ -n $path ]] && pgrep -f -- "$path" >/dev/null 2>&1; then
      die "$slug seems to be running: close it first (nothing was removed)"
    fi
    find_leftovers "$slug" "$df"   # reads the names from the launcher entry, so it must run before that is deleted
  fi

  if (( has_file )); then
    if (( purge )); then
      rm -f -- "$path"
    else
      trashed=$(trash_file "$path") || die "could not move $path to the Trash (use --purge to delete it)"
    fi
  fi
  rm -f -- "$df" "$BACKUP_DIR/$slug.AppImage" "$META_DIR/$slug.conf"
  find "$ICONS_DIR" -maxdepth 1 -name "$slug.*" -delete 2>/dev/null || true
  rm -f -- "$ICONS_DIR/custom/$slug".*
  refresh
  info "removed: $slug"
  if [[ -n $trashed ]]; then info "AppImage moved to Trash as '$trashed' (restore it from your file manager)"; fi

  if (( pdata )); then
    handle_data "$( if (( has_pdir )); then echo "$pdir"; fi )" "$purge" "$yes"
  elif (( has_pdir )); then
    info "its portable data folder was kept: $(tilde "$pdir") (delete it yourself, or next time use --purge-data)"
  fi
}

# ---------- portable mode ----------
cmd_portable() {
  local slug=${1:-} action=${2:-status} yes=0 df pdir size
  [[ -n $slug ]] || { usage; exit 1; }
  shift || true; shift || true
  while (($#)); do
    case $1 in
      -y|--yes) yes=1; shift ;;
      *)        die "unexpected argument: $1" ;;
    esac
  done
  df="$DESKTOP_DIR/appimage-$slug.desktop"
  [[ -f $df ]] || die "not integrated: $slug (see: appimgr list)"
  pdir=$(portable_dir "$slug")
  case $action in
    status)
      if [[ -d $pdir ]]; then
        size=$(du -sh -- "$pdir" 2>/dev/null | cut -f1 || true)
        echo "$slug: portable ($(tilde "$pdir"), ${size:-?})"
      else
        echo "$slug: not portable (the app uses your real home)"
      fi ;;
    on)
      if [[ -d $pdir ]]; then info "$slug: already portable ($(tilde "$pdir"))"; return 0; fi
      mkdir -p -- "$pdir"
      info "$slug: portable mode on. Data now goes to $(tilde "$pdir")"
      info "existing settings are not moved: the app starts empty, and it no longer sees your real home" ;;
    off)
      if [[ ! -d $pdir ]]; then info "$slug: already not portable"; return 0; fi
      size=$(du -sh -- "$pdir" 2>/dev/null | cut -f1 || true)
      if (( ! yes )); then
        if ! confirm "Move the portable data (${size:-?}) to the Trash and use your real home again?" n; then
          info "cancelled (non-interactive? use -y)"; return 0
        fi
      fi
      discard "$pdir" 0 || die "could not move $pdir to the Trash"
      info "$slug: portable mode off. The data folder is in the Trash" ;;
    *) die "unknown action '$action' (use: on | off | status)" ;;
  esac
}

print_long() { # <slug> <name> <path> <desktop file>
  local slug=$1 name=$2 path=$3 f=$4 size mode ver inst src args bak=no data pdir psize
  size=$(du -h -- "$path" 2>/dev/null | cut -f1 || true)
  if grep -q '^Exec=env APPIMAGE_EXTRACT_AND_RUN=1' "$f"; then mode="extract-and-run (no FUSE)"; else mode="normal (FUSE)"; fi
  ver=$(meta_get "$slug" version)
  inst=$(meta_get "$slug" installed)
  if [[ -z $inst && -f $path ]]; then inst=$(date -r "$path" +%F 2>/dev/null || true); fi
  args=$(meta_get "$slug" args)
  src=$(meta_get "$slug" source)
  if [[ -n $src ]]; then src=$(source_describe "$src"); else src="none (see: appimgr source)"; fi
  if [[ -f $BACKUP_DIR/$slug.AppImage ]]; then
    bak="yes ($(du -h -- "$BACKUP_DIR/$slug.AppImage" | cut -f1))"
  fi
  pdir=$(portable_dir "$slug")
  if [[ -d $pdir ]]; then
    psize=$(du -sh -- "$pdir" 2>/dev/null | cut -f1 || true)
    data="portable: $(tilde "$pdir")  [${psize:-?}]"
  else
    data="your home (see: appimgr remove --purge-data)"
  fi
  printf '%s  (%s)\n' "$slug" "$name"
  printf '   %-10s %s\n' "binary"    "$path${size:+  [$size]}"
  printf '   %-10s %s\n' "installed" "${inst:--}"
  printf '   %-10s %s\n' "version"   "${ver:--}"
  printf '   %-10s %s\n' "mode"      "$mode"
  printf '   %-10s %s\n' "args"      "${args:--}"
  printf '   %-10s %s\n' "source"    "$src"
  printf '   %-10s %s\n' "data"      "$data"
  printf '   %-10s %s\n' "rollback"  "$bak"
  printf '   %-10s %s\n' "entry"     "$f"
}

cmd_list() {
  local long=0 f slug name path n=0
  if [[ ${1:-} == -l || ${1:-} == --long ]]; then long=1; fi
  for f in "$DESKTOP_DIR"/appimage-*.desktop; do
    [[ -f $f ]] || continue
    grep -q '^X-AppImage-Managed=appimgr' "$f" || continue
    slug=${f##*/appimage-}; slug=${slug%.desktop}
    name=$(grep -m1 '^Name=' "$f" | cut -d= -f2- || true)
    path=$(desktop_path "$f")
    if (( long )); then
      print_long "$slug" "$name" "$path" "$f"
    else
      printf '%-22s %-28s %s\n' "$slug" "$name" "$path"
    fi
    n=$((n+1))
  done
  if (( n == 0 )); then echo "No integrated AppImages."; fi
}

# ---------- icon ----------
cmd_icon() {
  local slug=${1:-} arg=${2:-} df cur kind path icon ext
  [[ -n $slug ]] || { usage; exit 1; }
  df="$DESKTOP_DIR/appimage-$slug.desktop"
  [[ -f $df ]] || die "not integrated: $slug (see: appimgr list)"
  case $arg in
    "")
      cur=$(grep -m1 '^Icon=' "$df" | cut -d= -f2- || true)
      if [[ -n $(meta_get "$slug" icon) ]]; then kind="custom"
      elif [[ $cur == /* ]]; then kind="from the AppImage"
      else kind="generic"; fi
      echo "$slug: ${cur:-none}  ($kind)"
      echo "change: appimgr icon $slug FILE.png|svg     undo: appimgr icon $slug --reset" ;;
    --reset)
      path=$(desktop_path "$df")
      [[ -f $path ]] || die "AppImage binary missing: $path"
      TMP_DIR=$(mk_tmp)
      icon=$(embedded_icon "$path" "$TMP_DIR")
      if [[ -z $icon ]]; then
        if [[ -d $TMP_DIR/squashfs-root ]]; then die "no icon found inside this AppImage (nothing changed)"
        else die "could not extract the AppImage - is it runnable? (nothing changed)"; fi
      fi
      ext=$(icon_ext "$icon") || die "the icon inside the AppImage is not PNG/SVG (nothing changed)"
      find "$ICONS_DIR" -maxdepth 1 -name "$slug.*" -delete 2>/dev/null || true
      rm -f -- "$ICONS_DIR/custom/$slug".*
      install -m644 "$icon" "$ICONS_DIR/$slug.$ext"
      set_desktop_icon "$df" "$ICONS_DIR/$slug.$ext"
      meta_set "$slug" icon ""
      refresh; info "$slug: back to the icon inside the AppImage" ;;
    -*) die "unknown option: $arg" ;;
    *)
      [[ -f $arg ]] || die "file not found: $arg"
      ext=$(icon_ext "$arg") || die "icon does not look like a PNG or SVG file: $arg"
      TMP_DIR=$(mk_tmp)
      cp -- "$arg" "$TMP_DIR/new.$ext"
      mkdir -p "$ICONS_DIR/custom"
      find "$ICONS_DIR" -maxdepth 1 -name "$slug.*" -delete 2>/dev/null || true
      rm -f -- "$ICONS_DIR/custom/$slug".*
      install -m644 "$TMP_DIR/new.$ext" "$ICONS_DIR/custom/$slug.$ext"
      set_desktop_icon "$df" "$ICONS_DIR/custom/$slug.$ext"
      meta_set "$slug" icon "$ICONS_DIR/custom/$slug.$ext"
      refresh; info "$slug: custom icon set (kept across updates)" ;;
  esac
}

# ---------- interactive menu (no arguments, on a terminal) ----------
SLUGS=(); CANDS=(); PICKED=""

# fresh process: errors don't kill the menu. The token was removed from the environment at
# startup, so it is handed to this one child explicitly.
run_self() { GITHUB_TOKEN=$GH_TOKEN "$BASH" "$SELF" "$@" || true; }

ask() { # <prompt> -> REPLY (trimmed); returns 1 on EOF
  read -r -p "$1" REPLY || { echo; return 1; }
  REPLY=${REPLY#"${REPLY%%[![:space:]]*}"}
  REPLY=${REPLY%"${REPLY##*[![:space:]]}"}
}

unquote() { local p=$1; p=${p#[\'\"]}; p=${p%[\'\"]}; printf '%s' "$p"; }

clean_path() { # handles quotes, "\ " (drag & drop) and a leading ~
  local p
  p=$(unquote "$1"); p=${p//\\ / }; p=${p/#\~/$HOME}
  printf '%s' "$p"
}

load_slugs() {
  SLUGS=(); local f s
  for f in "$DESKTOP_DIR"/appimage-*.desktop; do
    [[ -f $f ]] || continue
    grep -q '^X-AppImage-Managed=appimgr' "$f" || continue
    s=${f##*/appimage-}; SLUGS+=("${s%.desktop}")
  done
}

find_candidates() { # AppImage files lying around that are not already in APPS_DIR
  CANDS=()
  local d f real seen=$'\n' apps_real
  apps_real=$(readlink -f -- "$APPS_DIR" 2>/dev/null || echo "$APPS_DIR")
  for d in "$HOME/Downloads" "$HOME/Desktop" "$PWD"; do
    [[ -d $d ]] || continue
    while IFS= read -r -d '' f; do
      real=$(readlink -f -- "$f")
      if [[ $real == "$apps_real"/* || $seen == *$'\n'"$real"$'\n'* ]]; then continue; fi
      seen+="$real"$'\n'
      CANDS+=("$real")
    done < <(find "$d" -maxdepth 1 -type f -iname '*.AppImage' -print0 2>/dev/null | sort -z)
  done
}

pick_app() { # <prompt> [all] -> PICKED (slug, or --all)
  local i s name
  PICKED=""; load_slugs
  if ((${#SLUGS[@]} == 0)); then info "no integrated AppImages yet - use 'Add' first"; return 1; fi
  for i in "${!SLUGS[@]}"; do
    s=${SLUGS[i]}
    name=$(grep -m1 '^Name=' "$DESKTOP_DIR/appimage-$s.desktop" | cut -d= -f2- || true)
    printf '   %2d) %-22s %s\n' $((i+1)) "$s" "$name"
  done
  if [[ ${2:-} == all ]]; then echo "    a) all"; fi
  ask "   $1 (Enter = cancel): " || return 1
  [[ -n $REPLY ]] || return 1
  if [[ ${2:-} == all && $REPLY == [Aa] ]]; then PICKED=--all; return 0; fi
  if [[ $REPLY =~ ^[0-9]{1,4}$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#SLUGS[@]})); then
    PICKED=${SLUGS[10#$REPLY-1]}; return 0
  fi
  for s in "${SLUGS[@]}"; do
    if [[ $REPLY == "$s" ]]; then PICKED=$s; return 0; fi
  done
  warn "invalid choice: $REPLY"; return 1
}

menu_add() {
  local i f size file="" tilde_c='~' args=() remote=0
  find_candidates
  if ((${#CANDS[@]})); then
    info "AppImage files found:"
    for i in "${!CANDS[@]}"; do
      f=${CANDS[i]}; size=$(du -h -- "$f" | cut -f1)
      printf '   %2d) %s  [%s]\n' $((i+1)) "${f/#$HOME/$tilde_c}" "$size"
    done
    ask "   Number, path to an .AppImage, download link or GitHub OWNER/REPO (Enter = cancel): " || return 0
  else
    ask "   Path to an .AppImage (drag & drop), download link or GitHub OWNER/REPO (Enter = cancel): " || return 0
  fi
  [[ -n $REPLY ]] || return 0
  if [[ $REPLY =~ ^[0-9]{1,4}$ ]] && ((10#$REPLY >= 1 && 10#$REPLY <= ${#CANDS[@]})); then
    file=${CANDS[10#$REPLY-1]}
  elif [[ $REPLY =~ ^https?://[^[:space:]]+$ ]]; then
    remote=1; file=$REPLY
  else
    file=$(clean_path "$REPLY")
    if [[ ! -e $file && $file =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
      remote=1; args+=(--repo "$file"); file=""
      ask "   Asset pattern, e.g. 'Foo-*-x86_64.AppImage' (Enter = auto-detect): " || return 0
      if [[ -n $REPLY ]]; then args+=(--asset "$(unquote "$REPLY")"); fi
    elif [[ ! -f $file ]]; then
      warn "file not found: $file"; return 0
    fi
  fi
  ask "   Display name (Enter = auto-detect): " || return 0
  if [[ -n $REPLY ]]; then args+=(--name "$REPLY"); fi
  ask "   Keep this app's data in its own folder (portable), so removing it leaves nothing behind? [y/N] " || return 0
  if [[ $REPLY == [Yy]* ]]; then args+=(--portable); fi
  if (( ! remote )) && ! confirm "Delete the original file after integrating?" y; then args+=(--no-move); fi
  if [[ -n $file ]]; then args+=("$file"); fi
  run_self add "${args[@]}"
}

menu_update() { # <check 0|1>
  local check=$1 a=()
  if ((check)); then pick_app "Check which app" all || return 0
  else pick_app "Update which app" all || return 0; fi
  if [[ $PICKED == --all ]]; then
    local s have=0
    for s in "${SLUGS[@]}"; do if [[ -n $(meta_get "$s" source) ]]; then have=1; fi; done
    if ((! have)); then info "none of your apps has an update source yet - use option 7 to set one"; return 0; fi
    a=(--all)
  else a=("$PICKED"); fi
  if ((check)); then a+=(--check); fi
  run_self update "${a[@]}"
}

menu_source() {
  local slug repo pat tag
  pick_app "Which app" || return 0
  slug=$PICKED
  run_self source "$slug"
  ask "   Set: [g]ithub, [u]rl, [c]lear (Enter = keep as is): " || return 0
  case $REPLY in
    g|G)
      ask "   GitHub repo (OWNER/REPO): " || return 0; repo=$REPLY
      ask "   Asset pattern, e.g. 'Foo-*-x86_64.AppImage': " || return 0; pat=$(unquote "$REPLY")
      ask "   Release tag (Enter = latest): " || return 0; tag=${REPLY:-latest}
      run_self source "$slug" set github "$repo" "$pat" "$tag" ;;
    u|U)
      ask "   Direct download URL: " || return 0
      run_self source "$slug" set url "$REPLY" ;;
    c|C) run_self source "$slug" clear ;;
    "") ;;
    *) warn "unknown choice: $REPLY" ;;
  esac
}

menu_icon() {
  local slug
  pick_app "Change icon of which app" || return 0
  slug=$PICKED
  run_self icon "$slug"
  ask "   New icon (PNG/SVG path), [r]eset to the AppImage's own, Enter = keep: " || return 0
  case $REPLY in
    "") ;;
    r|R) run_self icon "$slug" --reset ;;
    *)   run_self icon "$slug" "$(clean_path "$REPLY")" ;;
  esac
}

menu_portable() {
  local slug
  pick_app "Portable mode for which app" || return 0
  slug=$PICKED
  run_self portable "$slug" status
  ask "   [e]nable, [d]isable, Enter = keep as is: " || return 0
  case $REPLY in
    e|E|on)   run_self portable "$slug" on ;;
    d|D|off)  run_self portable "$slug" off ;;
    "") ;;
    *) warn "unknown choice: $REPLY" ;;
  esac
}

cmd_menu() {
  local first=1
  while true; do
    load_slugs; find_candidates
    echo
    printf 'appimgr v%s - %d integrated AppImage(s)\n' "$VERSION" "${#SLUGS[@]}"
    if ((first)); then
      first=0
      if ((${#SLUGS[@]})); then cmd_list; fi
    fi
    if ((${#CANDS[@]})); then
      info "${#CANDS[@]} .AppImage file(s) found in ~/Downloads, ~/Desktop or here - choose 1 to integrate"
    fi
    cat <<'EOF'

  1) Add / integrate an AppImage (file, link or GitHub repo)
  2) List apps (details)
  3) Run an app
  4) Check for updates
  5) Update apps
  6) Roll back to previous version
  7) Set update source
  8) Remove an app (and optionally its leftover data)
  9) Change an app's icon
 10) Portable mode (an app's data in its own folder)
  h) Full help        q) Quit (or Enter)
EOF
    ask "Choose: " || break
    case $REPLY in
      1|a|add)       menu_add ;;
      2|l|list)      run_self list -l ;;
      3|run)         if pick_app "Run which app"; then run_self run "$PICKED" -d && info "launched: $PICKED"; fi ;;
      4|check)       menu_update 1 ;;
      5|u|update)    menu_update 0 ;;
      6|rollback)    if pick_app "Roll back which app"; then run_self rollback "$PICKED"; fi ;;
      7|s|source)    menu_source ;;
      8|rm|remove)   if pick_app "Remove which app"; then run_self remove "$PICKED"; fi ;;
      9|i|icon)      menu_icon ;;
      10|p|portable) menu_portable ;;
      h|help|'?')    usage ;;
      q|Q|quit|exit|"") break ;;
      *)             warn "unknown choice: $REPLY" ;;
    esac
  done
}

init_token
if [[ ${APPIMGR_DOWNLOADER:-} == curl ]]; then USE_ARIA=0; fi

case "${1:-}" in
  add)               shift; cmd_add "$@" ;;
  update)            shift; cmd_update "$@" ;;
  rollback)          shift; cmd_rollback "$@" ;;
  icon)              shift; cmd_icon "$@" ;;
  source)            shift; cmd_source "$@" ;;
  portable)          shift; cmd_portable "$@" ;;
  run)               shift; cmd_run "$@" ;;
  remove|rm)         shift; cmd_remove "$@" ;;
  list|ls)           shift; cmd_list "$@" ;;
  version|-v|--version) echo "appimgr v$VERSION" ;;
  "")
    if [[ -t 0 && -t 1 ]]; then
      cmd_menu
    else
      cmd_list; echo "(non-interactive: run 'appimgr --help' for all commands)"
    fi ;;
  -h|--help|help)    usage ;;
  *)                 die "unknown command: $1 (try --help)" ;;
esac
