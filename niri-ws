#!/usr/bin/env python3
# niri-ws: save and restore Niri workspace layouts ("profiles"), each with its
# own shortcut. Stdlib-only Python, no background service.
#
# NEW IN THIS VERSION (2.2.0):
#   - Guided capture: numbered steps ("Step 2 of 5: ..."), a legend, then a summary
#     with a "Save? [Y/n]" confirmation.
#   - Window list in aligned columns (state, workspace, position, app name, title).
#   - Toggle several windows at once ("1 3 4", "2-4"); no more "e<N>" needed
#     (still accepted). Customizing asks for URL(s) first, then optional extra
#     arguments; replacing the whole command is an advanced, separate choice.
#   - Shortcut prompt suggests the next free Mod+Alt+<N>; Enter accepts it,
#     "none" skips.
#   - New `show <profile>` command (windows, URLs, exact launch commands).
#   - Optional colours (auto-off when piped or when NO_COLOR is set).
#   - Friendlier errors with a next step; shorter Niri-version notice with a
#     [d]etails choice; progress lines when restoring from a terminal.
#   Earlier: 2.1.0 several URLs per window; 2.0.0 rename to niri-ws, uninstall, debug.
#
VERSION="2.2.0"
NAME="niri-ws"
LEGACY="niri-profiles"

import argparse, json, os, re, shlex, shutil, subprocess, sys, time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
NIRI_DIR = HOME / ".config" / "niri"
CONFIG = NIRI_DIR / "config.kdl"
DIR = NIRI_DIR / NAME
PROFILES = DIR / "profiles"
MAIN = DIR / "main.kdl"
STATE = DIR / "state.json"
BACKUPS = DIR / "backups"
BIN = HOME / ".local" / "bin" / NAME
MARK_BEGIN = f"// >>> {NAME} (managed block, do not edit) >>>"
MARK_END = f"// <<< {NAME} <<<"
INCLUDE_LINE = f'include "{NAME}/main.kdl"'
LEGACY_DIR = NIRI_DIR / LEGACY
LOG = DIR / "logs" / "debug.log"
DEBUG = False          # --debug: also echo log lines to stderr
PERSIST_DEBUG = False  # `debug on`: always log to the file
NOLOG = False
DRY = False

# Fallback app-id -> Flatpak ID when no .desktop match is found.
KNOWN_FLATPAK = {
    "brave-browser": "com.brave.Browser", "com.brave.browser": "com.brave.Browser",
    "zen": "app.zen_browser.zen", "zen-browser": "app.zen_browser.zen",
    "app.zen_browser.zen": "app.zen_browser.zen",
}
BROWSER_RE = re.compile(r"brave|zen_browser|\bzen\b|firefox|chrom|vivaldi|librewolf", re.I)
COMBO_RE = re.compile(r"^(?:(?:Mod|Ctrl|Control|Shift|Alt|Super|Win|ISO_Level3_Shift|ISO_Level5_Shift)\+)*[A-Za-z0-9_]+$")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")

RELEVANT = [
    "`include` directive (config.kdl, nested includes with relative paths)",
    "`binds {}` syntax incl. hotkey-overlay-title",
    "`niri validate`",
    "`niri msg --json` windows / workspaces / outputs (fields: pid, app_id, is_floating,",
    "    workspace_id, layout.pos_in_scrolling_layout, layout.window_size, layout.tile_pos_in_workspace_view)",
    "actions: move-window-to-workspace (--window-id, --focus), focus-window --id, focus-monitor,",
    "    move-column-to-index, consume-window-into-column, set-column-width, set-window-width/height,",
    "    move-window-to-floating, move-floating-window",
]


# ---------------------------------------------------------------- helpers
def _color_on(stream):
    return stream.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def paint(code, text, stream=None):
    return f"\033[{code}m{text}\033[0m" if _color_on(stream or sys.stdout) else text


def bold(t): return paint("1", t)
def dim(t): return paint("2", t)
def green(t): return paint("32", t)
def yellow(t): return paint("33", t)


def step(n, total, title):
    print("\n" + bold(f"Step {n} of {total}: {title}"))


def log(msg, force=False):
    """Debug log. Written when --debug or `debug on` is active; force=True always
    logs (used for errors) but only once the data dir exists."""
    if NOLOG or not (DEBUG or PERSIST_DEBUG or (force and DIR.exists())):
        return
    now = datetime.now()
    line = f"{now:%H:%M:%S.%f}"[:-3] + f" [{os.getpid()}] {msg}"
    if DEBUG:
        print("debug:", line, file=sys.stderr)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        if LOG.exists() and LOG.stat().st_size > 1_000_000:
            os.replace(LOG, LOG.with_name("debug.log.1"))
        with open(LOG, "a") as f:
            f.write(f"{now:%Y-%m-%d} {line}\n")
    except OSError:
        pass


def die(msg, code=1):
    log(f"ERROR: {msg}", force=True)
    print(f"{paint('31', NAME + ':', sys.stderr)} {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    log(f"$ {shlex.join(cmd)} -> rc={r.returncode}")
    if r.stdout.strip():
        log("    stdout: " + r.stdout.strip()[:20000])
    if r.stderr.strip():
        log("    stderr: " + r.stderr.strip()[:2000])
    return r


def ask(prompt, default=""):
    try:
        s = input(prompt).strip()
    except EOFError:
        return default
    return s or default


def write(path, text):
    real = Path(os.path.realpath(path))
    log(f"write {real} ({len(text)} bytes)")
    real.parent.mkdir(parents=True, exist_ok=True)
    tmp = real.with_name(real.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, real)


def niri_json(what):
    r = sh(["niri", "msg", "--json", what])
    if r.returncode:
        die(f"`niri msg --json {what}` failed (is Niri running?): {r.stderr.strip()}")
    return json.loads(r.stdout)


def niri_version():
    r = sh(["niri", "--version"])
    m = re.search(r"(\d+\.\d+(?:\.\d+)?)", r.stdout)
    return m.group(1) if m else (r.stdout.strip() or "unknown")


def validate():
    r = sh(["niri", "validate"])
    return r.returncode == 0, (r.stdout + r.stderr).strip()


def is_setup():
    try:
        return DIR.is_dir() and MARK_BEGIN in CONFIG.read_text()
    except OSError:
        return False


# ---------------------------------------------------------------- state
def load_state():
    try:
        s = json.loads(STATE.read_text())
    except Exception:
        s = {}
    s.setdefault("bind_mode", "nested")
    s.setdefault("confirmed", [])
    s.setdefault("flagged", [])
    s.setdefault("debug", False)
    return s


def save_state(s):
    write(STATE, json.dumps(s, indent=2) + "\n")


def check_version(interactive=True):
    cur, st = niri_version(), load_state()
    if cur in st["confirmed"]:
        return True
    if cur in st["flagged"]:
        print(yellow(f"! Niri {cur} is flagged as NOT supported (you marked it earlier)."))
        if interactive and ask("  Mark it supported now? [y/N]: ").lower() == "y":
            st["flagged"].remove(cur)
            st["confirmed"].append(cur)
            save_state(st)
            return True
        return False
    last = st["confirmed"][-1] if st["confirmed"] else "none"
    print(yellow(f"! Niri is {cur}; last confirmed version: {last}. Check the release notes."))
    if not interactive:
        return False
    while True:
        a = ask("  Does this version work? [y]es / [n]o / [d]etails / [l]ater (default l): ", "l").lower()
        if a.startswith("d"):
            print("  Features this script depends on:")
            for line in RELEVANT:
                print(f"    - {line}" if not line.startswith("    ") else f"  {line}")
            continue
        break
    if a.startswith("y"):
        st["confirmed"].append(cur)
        save_state(st)
        print(f"  Recorded Niri {cur} as supported.")
        return True
    if a.startswith("n"):
        st["flagged"].append(cur)
        save_state(st)
        print(f"  Recorded Niri {cur} as NOT supported.")
    return False


# ---------------------------------------------------------------- snapshots / rollback
def snapshot():
    BACKUPS.mkdir(parents=True, exist_ok=True)
    dst = BACKUPS / datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    dst.mkdir()
    if CONFIG.exists():
        shutil.copy2(CONFIG, dst / "config.kdl")
    for f in ("main.kdl", "state.json"):
        if (DIR / f).exists():
            shutil.copy2(DIR / f, dst / f)
    if PROFILES.exists():
        shutil.copytree(PROFILES, dst / "profiles")
    for old in sorted(p for p in BACKUPS.iterdir() if p.is_dir())[:-10]:
        shutil.rmtree(old)
    log(f"snapshot -> {dst}")
    return dst


def rollback(dst):
    log(f"ROLLBACK from {dst}", force=True)
    if (dst / "config.kdl").exists():
        shutil.copy2(dst / "config.kdl", Path(os.path.realpath(CONFIG)))
    for f in ("main.kdl", "state.json"):
        if (dst / f).exists():
            shutil.copy2(dst / f, DIR / f)
        elif (DIR / f).exists():
            (DIR / f).unlink()
    if PROFILES.exists():
        shutil.rmtree(PROFILES)
    if (dst / "profiles").exists():
        shutil.copytree(dst / "profiles", PROFILES)


# ---------------------------------------------------------------- profiles + KDL generation
def pfile(name):
    return PROFILES / f"{name}.json"


def profile_names():
    return sorted(f.stem for f in PROFILES.glob("*.json")) if PROFILES.is_dir() else []


def load_profile(name):
    try:
        return json.loads(pfile(name).read_text())
    except FileNotFoundError:
        return None


def save_profile(p):
    write(pfile(p["name"]), json.dumps(p, indent=2) + "\n")


def kdl_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def profile_kdl(p, ver):
    out = [f"// {NAME} v{VERSION} | profile: {p['name']} | generated for niri {ver}",
           "// Managed file: change it through the script."]
    if p.get("bind"):
        title = kdl_str("Workspace profile: " + p["name"])
        out += ["binds {",
                f'    {p["bind"]} hotkey-overlay-title={title} '
                f'{{ spawn {kdl_str(str(BIN))} "restore" {kdl_str(p["name"])}; }}',
                "}"]
    else:
        out.append("// (no shortcut assigned)")
    return "\n".join(out) + "\n"


def write_all(state, ver):
    names = profile_names()
    profs = [load_profile(n) for n in names]
    for p in profs:
        write(PROFILES / f"{p['name']}.kdl", profile_kdl(p, ver))
    for f in PROFILES.glob("*.kdl"):
        if f.stem not in names:
            f.unlink()
    lines = [f"// {NAME} v{VERSION} hub file | niri {ver} | mode: {state['bind_mode']}",
             "// One line per enabled profile. Remove a line to disable it."]
    for p in profs:
        if not p.get("enabled", True):
            continue
        if state["bind_mode"] == "nested":
            lines.append(f'include "profiles/{p["name"]}.kdl"')
        else:
            lines.append((PROFILES / f"{p['name']}.kdl").read_text().rstrip("\n"))
    write(MAIN, "\n".join(lines) + "\n")


def rebuild_and_validate(state):
    ver, last = niri_version(), ""
    modes = [state["bind_mode"]] + (["flat"] if state["bind_mode"] == "nested" else [])
    for mode in modes:
        state["bind_mode"] = mode
        write_all(state, ver)
        ok, msg = validate()
        log(f"rebuild mode={mode} validate ok={ok} {msg}")
        if ok:
            save_state(state)
            return True, msg
        last = msg
    return False, last


def mutate(fn):
    """Run fn(state), regenerate files, validate with niri; roll back on failure."""
    ok, msg = validate()
    log(f"mutate: pre-validate ok={ok}")
    if not ok:
        die("your Niri config does not validate before any change; fix it first:\n" + msg)
    snap = snapshot()
    state = load_state()
    try:
        fn(state)
        ok, msg = rebuild_and_validate(state)
    except Exception as e:  # noqa
        ok, msg = False, f"{type(e).__name__}: {e}"
    if not ok:
        rollback(snap)
        die("`niri validate` failed, changes rolled back:\n" + msg)
    if state["bind_mode"] == "flat":
        print("  note: nested includes were rejected, using flat mode (main.kdl holds the binds directly).")
    return state


# ---------------------------------------------------------------- shortcut conflicts
ALIAS = {"control": "ctrl", "win": "super"}


def norm_combo(c):
    parts = c.split("+")
    mods = {ALIAS.get(m.lower(), m.lower()) for m in parts[:-1]}
    mods = {"mod" if m == "super" else m for m in mods}
    return "+".join(sorted(mods) + [parts[-1].lower()])


BIND_RE = re.compile(r'^\s*([A-Za-z0-9_+]+)(?:\s+[\w-]+=(?:"[^"]*"|\S+))*\s*\{')


def scan_binds(path):
    found, depth, in_binds = [], 0, False
    try:
        lines = path.read_text(errors="ignore").splitlines()
    except OSError:
        return found
    for raw in lines:
        line = raw.split("//", 1)[0]
        if depth == 0 and re.match(r"\s*binds\s*\{", line):
            in_binds = True
        elif in_binds and depth == 1:
            m = BIND_RE.match(line)
            if m:
                found.append(m.group(1))
        depth += line.count("{") - line.count("}")
        if in_binds and depth < 1:
            in_binds = False
    return found


def existing_binds(exclude=None):
    out = {}
    for f in NIRI_DIR.rglob("*.kdl"):
        if DIR in f.parents:
            continue
        for b in scan_binds(f):
            out.setdefault(norm_combo(b), f.name)
    for n in profile_names():
        if n == exclude:
            continue
        p = load_profile(n)
        if p and p.get("bind"):
            out[norm_combo(p["bind"])] = f"profile '{n}'"
    return out


def suggest_bind(taken):
    for n in range(1, 10):
        c = f"Mod+Alt+{n}"
        if norm_combo(c) not in taken:
            return c
    return None


def check_bind_free(bind, exclude=None):
    if not COMBO_RE.match(bind):
        die(f"invalid shortcut: {bind}. Use a format like Mod+Alt+1.")
    taken = existing_binds(exclude)
    where = taken.get(norm_combo(bind))
    if where:
        alt = suggest_bind(taken)
        die(f"shortcut {bind} is already used by {where}." + (f" Try {alt} instead." if alt else ""))


def ask_bind(exclude=None, current=None):
    taken = existing_binds(exclude)
    default = current or suggest_bind(taken)
    print("  Enter accepts the suggestion. Type 'none' for no shortcut, or your own combo")
    print("  (e.g. Mod+Shift+F2; `wev` shows key names).")
    while True:
        s = ask(f"  Shortcut{f' [{default}]' if default else ''}: ", default or "")
        if s.lower() in ("", "none", "-"):
            return None
        if not COMBO_RE.match(s):
            print("  Invalid. Use a format like Mod+Alt+1.")
            continue
        where = taken.get(norm_combo(s))
        if where and where.startswith("profile"):
            print(f"  Already used by {where}.")
            continue
        if where and ask(f"  {s} already exists in {where}. Use anyway? [y/N]: ").lower() != "y":
            continue
        return s


# ---------------------------------------------------------------- commands / desktop files
_idx = None
_names = {}


def desktop_index():
    global _idx
    if _idx is not None:
        return _idx
    idx = {}
    dirs = [HOME / ".local/share/applications", Path("/usr/share/applications"),
            Path("/usr/local/share/applications"),
            HOME / ".local/share/flatpak/exports/share/applications",
            Path("/var/lib/flatpak/exports/share/applications")]
    for d in dirs:
        if not d.is_dir():
            continue
        for f in d.glob("*.desktop"):
            exe = wm = nm = None
            try:
                for line in f.read_text(errors="ignore").splitlines():
                    if line.startswith("[") and line.strip() != "[Desktop Entry]":
                        break
                    if line.startswith("Exec=") and exe is None:
                        exe = line[5:]
                    elif line.startswith("StartupWMClass="):
                        wm = line[15:].strip()
                    elif line.startswith("Name=") and nm is None:
                        nm = line[5:].strip()
            except OSError:
                continue
            if exe:
                idx.setdefault(f.stem.lower(), exe)
                if nm:
                    _names.setdefault(f.stem.lower(), nm)
                if wm:
                    idx.setdefault(wm.lower(), exe)
                    if nm:
                        _names.setdefault(wm.lower(), nm)
    _idx = idx
    return idx


def app_label(aid):
    desktop_index()
    return _names.get((aid or "").lower()) or aid or "?"


def clean_exec(exe):
    try:
        toks = shlex.split(exe)
    except ValueError:
        return None
    out = [t for t in toks if not re.fullmatch(r"%[A-Za-z%]|@@[uf]?", t)]
    return out or None


def guess_cmd(w):
    c = _guess_cmd(w)
    log(f"launch command for app_id={w.get('app_id')} pid={w.get('pid')}: {c}")
    return c


def _guess_cmd(w):
    aid = (w.get("app_id") or "").lower()
    exe = desktop_index().get(aid)
    if exe:
        c = clean_exec(exe)
        if c:
            return c
    if aid in KNOWN_FLATPAK:
        return ["flatpak", "run", KNOWN_FLATPAK[aid]]
    pid = w.get("pid")
    if pid:
        try:
            for e in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
                if e.startswith(b"APPIMAGE="):
                    ai = e[9:].decode()
                    if ai and Path(ai).exists():
                        return [ai]
        except OSError:
            pass
        try:
            raw = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            c = [x.decode() for x in raw if x]
            if c and Path(c[0]).name != "bwrap":
                return c
        except OSError:
            pass
    return [w.get("app_id")] if w.get("app_id") else []


def build_launch(w):
    cmd = list(w["cmd"]) + shlex.split(w.get("args") or "")
    if w.get("url"):
        if any(BROWSER_RE.search(t) for t in w["cmd"]):
            cmd += ["--new-window", *w["url"].split()]
        else:
            cmd += w["url"].split()
    return cmd


# ---------------------------------------------------------------- capture
def ancestors():
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            pid = int(stat.rsplit(")", 1)[1].split()[1])
        except Exception:
            break
    return pids


def skey(it):
    return (it["workspace"]["idx"], 1 if it["floating"] else 0, it.get("column") or 0, it.get("tile") or 0)


def capture_windows():
    wins = niri_json("windows")
    wss = {w["id"]: w for w in niri_json("workspaces")}
    outs = niri_json("outputs")
    anc = ancestors()
    own = [w for w in wins if w.get("pid") in anc] or [w for w in wins if w.get("is_focused")]
    skip = {w["id"] for w in own}
    log(f"own-terminal windows excluded: {sorted(skip)} (ancestor pids: {sorted(anc)})")
    items = []
    for w in wins:
        ws = wss.get(w.get("workspace_id"))
        if not ws:
            continue
        lay = w.get("layout") or {}
        pos = lay.get("pos_in_scrolling_layout")
        out = ws.get("output")
        items.append({
            "app_id": w.get("app_id"), "label": app_label(w.get("app_id")), "title": w.get("title"),
            "cmd": guess_cmd(w), "url": None, "args": "",
            "workspace": {"idx": ws.get("idx"), "name": ws.get("name")},
            "output": out,
            "out_width": ((outs.get(out) or {}).get("logical") or {}).get("width") if out else None,
            "floating": bool(w.get("is_floating")),
            "column": pos[0] if pos else None, "tile": pos[1] if pos else None,
            "size": list(lay.get("window_size") or []),
            "pos": lay.get("tile_pos_in_workspace_view"),
            "_skip": w["id"] in skip,
        })
    items.sort(key=skey)
    return items


def pos_str(it):
    return "float" if it["floating"] else f"col{it['column']}.{it['tile']}"


def row(i, it, skipped=None):
    ws = str(it["workspace"]["name"] or it["workspace"]["idx"])
    label = (it.get("label") or it.get("app_id") or "?")[:22]
    out = f"{i:>3}  "
    if skipped is not None:
        txt = f"{'skip' if skipped else 'keep':<5} "
        out += dim(txt) if skipped else green(txt)
    out += f"{ws[:4]:<4} {pos_str(it):<8} {label:<22} {(it.get('title') or '')[:30]}"
    if it.get("url"):
        out += f"  -> {it['url']}"
    if it.get("args"):
        out += f"  + {it['args']}"
    if any(t.startswith("/tmp/.mount_") for t in it["cmd"]):
        out += "  " + yellow("[!] temp AppImage path: customize this window to set the real one")
    return out


def print_rows(items, with_state=False):
    head = f"{'#':>3}  " + (f"{'State':<5} " if with_state else "") + f"{'WS':<4} {'Position':<8} {'App':<22} Title / opens"
    print(bold(head))
    for i, it in enumerate(items, 1):
        print(row(i, it, it.get("_skip", False) if with_state else None))


def edit_window(it):
    print(f"\n{bold(it.get('label') or it.get('app_id') or 'window')}: {it.get('title') or ''}")
    print(dim(f"  runs: {shlex.join(it['cmd'])}"))
    cu = it.get("url") or ""
    s = ask(f"  URL(s) to open, space-separated [{cu or 'none'}] (Enter keeps, '-' clears): ")
    if s == "-":
        it["url"] = None
    elif s:
        it["url"] = s
    ca = it.get("args") or ""
    s = ask(f"  Extra arguments added after the command [{ca or 'none'}] (Enter keeps, '-' clears): ")
    if s == "-":
        it["args"] = ""
    elif s:
        try:
            shlex.split(s)
            it["args"] = s
        except ValueError as e:
            print(f"  Not saved ({e}).")
    if ask("  Replace the whole launch command? (advanced) [y/N]: ").lower() == "y":
        s = ask("  New command (Enter keeps the current one): ")
        if s:
            try:
                it["cmd"] = shlex.split(s)
            except ValueError as e:
                print(f"  Not saved ({e}).")


def parse_numbers(s, n):
    out = []
    for t in s.replace(",", " ").split():
        m = re.fullmatch(r"(\d+)-(\d+)", t)
        out += list(range(int(m[1]), int(m[2]) + 1)) if m else ([int(t)] if t.isdigit() else [0])
    return out if out and all(1 <= x <= n for x in out) else None


def choose_windows(items):
    print("Type numbers to flip keep/skip (e.g. 1 3 4 or 2-4), then Enter. Enter alone = the list is right.")
    while True:
        print_rows(items, True)
        s = ask("> ")
        if not s:
            return
        m = re.fullmatch(r"e\s*(\d+)", s)
        if m and 1 <= int(m[1]) <= len(items):
            edit_window(items[int(m[1]) - 1])
            continue
        nums = parse_numbers(s, len(items))
        if nums is None:
            print(f"  Use window numbers from 1 to {len(items)}, like: 1 3 4  or  2-4")
            continue
        for n in nums:
            items[n - 1]["_skip"] = not items[n - 1]["_skip"]


def customize(items):
    print("Set what a window opens (URLs) or extra arguments. Type its number, or Enter to continue.")
    while True:
        print_rows(items)
        s = ask("Customize window > ")
        if not s:
            return
        if s.isdigit() and 1 <= int(s) <= len(items):
            edit_window(items[int(s) - 1])
        else:
            print(f"  Type a number from 1 to {len(items)}, or press Enter.")


def summary(p):
    print(f"  Name     : {p['name']}")
    print(f"  Shortcut : {p.get('bind') or 'none'}")
    print_rows(p["windows"])


def require_setup():
    if not is_setup():
        if LEGACY_DIR.exists():
            die(f"an old {LEGACY} install was found. Run: {NAME} setup (it migrates it)")
        die(f"not set up yet. Run: {NAME} setup")


def cmd_capture(name=None, bind=None, yes=False, recapture=False):
    require_setup()
    old = load_profile(name) if recapture else None
    if recapture and not old:
        die(f"no such profile: {name}. Run `{NAME} list` to see your profiles.")
    interactive = not yes
    if interactive and not sys.stdin.isatty():
        die("interactive input needed (or use --yes with a name)")
    items = capture_windows()
    if old:  # carry over edited commands/URLs by app_id
        pool = list(old["windows"])
        for it in items:
            m = next((o for o in pool if o["app_id"] == it["app_id"]), None)
            if m:
                pool.remove(m)
                it["cmd"], it["url"], it["args"] = m["cmd"], m.get("url"), m.get("args", "")
    total = 3 if recapture else 5
    if interactive:
        step(1, total, "Choose which windows to include")
        choose_windows(items)
    items = [{k: v for k, v in it.items() if k != "_skip"} for it in items if not it["_skip"]]
    if not items:
        die("no windows selected. Run it again and keep at least one window.")
    if interactive:
        step(2, total, "Customize windows (optional)")
        customize(items)
    if not recapture:
        if interactive:
            step(3, total, "Name the profile")
        while True:
            name = name or (ask("  Profile name (letters, digits, - and _): ") if interactive else "")
            if not NAME_RE.match(name or ""):
                if not interactive:
                    die("a valid profile name is required (letters, digits, - and _)")
                print("  Use letters, digits, - and _ only.")
                name = None
                continue
            if load_profile(name):
                if not interactive:
                    die(f"profile '{name}' already exists")
                print("  That name already exists.")
                name = None
                continue
            break
        if bind is None and interactive:
            step(4, total, "Choose a shortcut")
            bind = ask_bind()
        elif bind:
            check_bind_free(bind)
    p = old or {"name": name, "bind": bind, "enabled": True, "existing": "move", "timeout": 20}
    p["windows"], p["captured_with"] = items, niri_version()
    if interactive:
        step(total, total, "Review and save")
        summary(p)
        if ask("Save this profile? [Y/n]: ", "y").lower().startswith("n"):
            print("Cancelled, nothing saved.")
            return
    mutate(lambda s: save_profile(p))
    how = f"Press {p['bind']} to restore it, or run" if p.get("bind") else "No shortcut set. Restore it with"
    print(f"Saved profile '{p['name']}' ({len(items)} windows). {how}: {NAME} restore {p['name']}")
    print(f"Preview first with: {NAME} restore {p['name']} --dry-run")


# ---------------------------------------------------------------- restore
def act(fails, *args):
    if DRY:
        print("  would run: niri msg action " + shlex.join(args))
        return True
    r = sh(["niri", "msg", "action", *args])
    if r.returncode:
        fails.append(f"{' '.join(args)}: {r.stderr.strip()}")
        log(f"ACTION FAILED: {' '.join(args)}: {r.stderr.strip()}", force=True)
    return r.returncode == 0


def same_app(x, w):
    a = (x.get("app_id") or "").lower()
    return bool(a) and a == (w.get("app_id") or "").lower()


def cmd_restore(name, dry=False):
    global DRY
    DRY = dry
    p = load_profile(name)
    if not p:
        die(f"no such profile: {name}. Run `{NAME} list` to see your profiles.")
    log(f"restore '{name}' dry={dry} windows={len(p['windows'])} existing={p.get('existing', 'move')}")
    wins = sorted(p["windows"], key=skey)
    before = niri_json("windows")
    base = {w["id"] for w in before}
    claimed, fails = {}, []
    for i, w in enumerate(wins):
        if p.get("existing", "move") == "move" and not w.get("url"):
            used = set(claimed.values())
            m = next((x for x in before if x["id"] not in used and same_app(x, w)), None)
            if m:
                claimed[i] = m["id"]
                log(f"reuse existing window {m['id']} for {w['app_id']}")
                if dry:
                    print(f"reuse existing window {m['id']} ({w['app_id']})")
                continue
        cmd = build_launch(w)
        if dry:
            print("would launch:", shlex.join(cmd))
            continue
        log(f"launch: {shlex.join(cmd)}")
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            fails.append(f"launch {cmd[:1]}: {e}")
    pending = [i for i in range(len(wins)) if i not in claimed]
    if dry:
        for i in pending:
            claimed[i] = f"<new:{wins[i]['app_id']}#{i}>"
        pending = []
    total, tty = len(pending), sys.stdout.isatty() and not dry
    if tty and total:
        print(f"Launching {total} app(s) and waiting for their windows...")
    deadline = time.time() + p.get("timeout", 20)
    while pending and time.time() < deadline:
        time.sleep(0.3)
        for x in niri_json("windows"):
            if x["id"] in base or x["id"] in claimed.values():
                continue
            hit = next((i for i in pending if same_app(x, wins[i])), None)
            if hit is not None:
                claimed[hit] = x["id"]
                pending.remove(hit)
                log(f"new window {x['id']} ({x.get('app_id')}) matched profile window #{hit}")
                if tty:
                    print(f"  found {wins[hit].get('label') or wins[hit]['app_id']} ({total - len(pending)} of {total})")
    log(f"matching done; unmatched={[wins[i]['app_id'] for i in pending]}")
    outs = niri_json("outputs")
    groups = {}
    for i in sorted(claimed):
        w = wins[i]
        ws = w["workspace"]
        groups.setdefault((w.get("output"), ws["idx"], ws["name"]), []).append((w, claimed[i]))
    first = None
    for (out, idx, wsname), members in sorted(groups.items(), key=lambda kv: (str(kv[0][0]), kv[0][1])):
        ref = str(wsname or idx)
        if out in outs:
            act(fails, "focus-monitor", out)
        cur_w = ((outs.get(out) or {}).get("logical") or {}).get("width")
        for w, wid in members:
            if not act(fails, "move-window-to-workspace", "--window-id", str(wid), "--focus", "false", ref):
                act(fails, "focus-window", "--id", str(wid))
                act(fails, "move-window-to-workspace", ref)
        tiled = [(w, wid) for w, wid in members if not w["floating"]]
        for k, (w, wid) in enumerate(tiled, 1):
            act(fails, "focus-window", "--id", str(wid))
            act(fails, "move-column-to-index", str(k))
        cols = {}
        for w, wid in tiled:
            cols.setdefault(w["column"], []).append((w, wid))
        for its in cols.values():
            if len(its) > 1:
                act(fails, "focus-window", "--id", str(its[0][1]))
                for _ in its[1:]:
                    act(fails, "consume-window-into-column")
        for its in cols.values():
            w0, id0 = its[0]
            scale = (cur_w / w0["out_width"]) if cur_w and w0.get("out_width") else 1
            act(fails, "focus-window", "--id", str(id0))
            if len(w0["size"]) == 2:
                act(fails, "set-column-width", str(int(w0["size"][0] * scale)))
            if len(its) > 1:
                for w, wid in its[:-1]:
                    if len(w["size"]) == 2:
                        act(fails, "focus-window", "--id", str(wid))
                        act(fails, "set-window-height", str(int(w["size"][1])))
        for w, wid in members:
            if not w["floating"]:
                continue
            scale = (cur_w / w["out_width"]) if cur_w and w.get("out_width") else 1
            act(fails, "focus-window", "--id", str(wid))
            act(fails, "move-window-to-floating")
            if len(w["size"]) == 2:
                act(fails, "set-window-width", str(int(w["size"][0] * scale)))
                act(fails, "set-window-height", str(int(w["size"][1])))
            if w.get("pos"):
                act(fails, "move-floating-window", "-x", str(max(0, int(w["pos"][0] * scale))),
                    "-y", str(max(0, int(w["pos"][1]))))
        if first is None and members:
            first = members[0][1]
    if first is not None:
        act(fails, "focus-window", "--id", str(first))
    if dry:
        print("(dry run) nothing was changed.")
        return
    msgs = [f"not found: {wins[i]['app_id']} ({shlex.join(wins[i]['cmd'])})" for i in pending] + fails
    if msgs:
        log("restore problems: " + " | ".join(msgs), force=True)
        print(f"Restored '{name}' with {len(msgs)} problem(s):", file=sys.stderr)
        for m in msgs:
            print("  -", m, file=sys.stderr)
        sys.exit(2)
    print(f"Restored '{name}' ({len(claimed)} windows).")


# ---------------------------------------------------------------- management
def need_profile(name):
    p = load_profile(name)
    if not p:
        die(f"no such profile: {name}. Run `{NAME} list` to see your profiles.")
    return p


def cmd_setup():
    if not shutil.which("niri"):
        die("`niri` not found in PATH")
    if not CONFIG.exists():
        die(f"{CONFIG} not found")
    check_version()

    def change(state):
        src = Path(os.path.realpath(__file__))
        BIN.parent.mkdir(parents=True, exist_ok=True)
        if not BIN.exists() or Path(os.path.realpath(BIN)) != src:
            shutil.copy2(src, BIN)
        BIN.chmod(0o755)
        PROFILES.mkdir(parents=True, exist_ok=True)
        if LEGACY_DIR.exists():
            log(f"migrating {LEGACY_DIR} -> {DIR}")
            shutil.copytree(LEGACY_DIR, DIR, dirs_exist_ok=True, ignore=shutil.ignore_patterns("backups", "logs"))
            state.update(load_state())
        text = CONFIG.read_text()
        new = strip_block(text, LEGACY)
        if MARK_BEGIN not in new:
            new = new.rstrip("\n") + f"\n\n{MARK_BEGIN}\n{INCLUDE_LINE}\n{MARK_END}\n"
        if new != text:
            write(CONFIG, new)

    mutate(change)
    if LEGACY_DIR.exists():
        shutil.rmtree(LEGACY_DIR)
        print(f"Migrated the old {LEGACY} install. You can delete the old script: rm {BIN.with_name(LEGACY)}")
    print(f"Setup done. Script installed at {BIN}; data in {DIR}.")
    if str(BIN.parent) not in os.environ.get("PATH", "").split(":"):
        print(f"  (~/.local/bin is not in PATH; shortcuts use the full path, so they still work.)")


def strip_block(text, name):
    pat = re.compile(r"\n*// >>> " + re.escape(name) + r" \(managed block.*?// <<< " + re.escape(name) + r" <<<\n?", re.S)
    out = pat.sub("\n", text)
    return out if out == text else out.rstrip("\n") + "\n"


def cmd_uninstall(yes=False):
    global NOLOG
    text = CONFIG.read_text() if CONFIG.exists() else ""
    stripped = strip_block(strip_block(text, NAME), LEGACY)
    dirs = [d for d in (DIR, LEGACY_DIR) if d.exists()]
    if stripped == text and not dirs:
        print("Nothing to remove.")
        return
    print("This will remove:")
    if stripped != text:
        print(f"  - the {NAME} include block in {CONFIG}")
    for d in dirs:
        print(f"  - {d}  (profiles, state, backups, logs)")
    print(f"The script itself ({BIN}) is left in place.")
    if not yes and ask("Proceed? [y/N]: ").lower() != "y":
        print("Cancelled.")
        return
    if stripped != text:
        have_niri = bool(shutil.which("niri"))
        ok_before = validate()[0] if have_niri else True
        write(CONFIG, stripped)
        if have_niri:
            ok, msg = validate()
            if ok_before and not ok:
                write(CONFIG, text)
                die("`niri validate` failed after removing the include; config restored, nothing deleted:\n" + msg)
    log("uninstall: deleting data dirs")
    NOLOG = True
    for d in dirs:
        shutil.rmtree(d)
    print(f"Uninstalled. To remove the script itself: rm {BIN}")


def cmd_debug(action=None):
    if action in ("on", "off"):
        require_setup()
        st = load_state()
        st["debug"] = action == "on"
        save_state(st)
        print(f"Persistent debug logging: {action}. Log: {LOG}")
    elif action == "show":
        if not LOG.exists():
            print(f"No log yet ({LOG}). Run a command with --debug, or `{NAME} debug on`.")
            return
        print(f"# {LOG}")
        print("\n".join(LOG.read_text(errors="ignore").splitlines()[-80:]))
    elif action == "clear":
        for f in (LOG, LOG.with_name("debug.log.1")):
            if f.exists():
                f.unlink()
        print("Log cleared.")
    else:
        print(f"Persistent debug logging: {'on' if load_state().get('debug') else 'off'}")
        print(f"Log file: {LOG}" + ("" if LOG.exists() else " (none yet)"))
        print(f"Use `{NAME} debug show`, or add --debug to any command.")


def cmd_list():
    names = profile_names()
    if not names:
        print("No profiles yet.")
    for n in names:
        p = load_profile(n)
        print(f"{n:<16} {p.get('bind') or '(no shortcut)':<18} {len(p['windows'])} windows"
              f"{'' if p.get('enabled', True) else '  [disabled]'}")


def cmd_rebind(name, bind=None):
    p = need_profile(name)
    if bind is None:
        bind = ask_bind(exclude=name, current=p.get("bind"))
    elif bind != "none":
        check_bind_free(bind, exclude=name)
    if bind == "none":
        bind = None
    p["bind"] = bind
    mutate(lambda s: save_profile(p))
    print(f"'{name}' shortcut: {bind or 'none'}")


def cmd_rename(old, new):
    p = need_profile(old)
    if not NAME_RE.match(new):
        die("invalid name")
    if load_profile(new):
        die("target name exists")

    def change(s):
        pfile(old).unlink()
        p["name"] = new
        save_profile(p)

    mutate(change)
    print(f"Renamed '{old}' -> '{new}'.")


def cmd_edit(name):
    p = need_profile(name)
    wins = p["windows"]
    print(bold(f"Editing '{name}'"))
    print("Type a window number to customize it, d<N> to delete one, m to change how already-open")
    print("windows are handled, or Enter to save.")
    while True:
        print_rows(wins)
        print(f"  Already-open windows: {'moved into place' if p.get('existing', 'move') == 'move' else 'always launch new ones'}")
        s = ask("> ")
        if not s:
            break
        if s == "m":
            p["existing"] = "spawn" if p.get("existing", "move") == "move" else "move"
        elif re.fullmatch(r"d\d+", s) and 1 <= int(s[1:]) <= len(wins):
            del wins[int(s[1:]) - 1]
        elif s.isdigit() and 1 <= int(s) <= len(wins):
            edit_window(wins[int(s) - 1])
        else:
            print(f"  Type a number from 1 to {len(wins)}, d<N>, m, or Enter.")
    mutate(lambda st: save_profile(p))
    print("Saved.")


def cmd_show(name):
    p = need_profile(name)
    print(bold(p["name"]) + f"   shortcut: {p.get('bind') or 'none'}" + ("   (disabled)" if not p.get("enabled", True) else ""))
    print(f"captured with niri {p.get('captured_with', '?')}; already-open windows: "
          f"{'moved into place' if p.get('existing', 'move') == 'move' else 'always launch new ones'}")
    wins = sorted(p["windows"], key=skey)
    print_rows(wins)
    print("\nLaunch commands:")
    for i, w in enumerate(wins, 1):
        print(f"  {i}. {shlex.join(build_launch(w))}")


def cmd_enable(name, on):
    p = need_profile(name)
    p["enabled"] = on
    mutate(lambda s: save_profile(p))
    print(f"'{name}' {'enabled' if on else 'disabled'}.")


def cmd_delete(name, yes=False):
    need_profile(name)
    if not yes and ask(f"Delete '{name}'? [y/N]: ").lower() != "y":
        return

    def change(s):
        pfile(name).unlink()

    mutate(change)
    print(f"Deleted '{name}'.")


def cmd_confirm(unsupported=False):
    cur, st = niri_version(), load_state()
    for k in ("confirmed", "flagged"):
        if cur in st[k]:
            st[k].remove(cur)
    st["flagged" if unsupported else "confirmed"].append(cur)
    save_state(st)
    print(f"Niri {cur} recorded as {'NOT supported' if unsupported else 'supported'}.")


def cmd_status():
    st = load_state()
    print(f"{NAME} v{VERSION}")
    print(f"niri version : {niri_version()}")
    print(f"confirmed    : {', '.join(st['confirmed']) or 'none'}")
    print(f"flagged      : {', '.join(st['flagged']) or 'none'}")
    print(f"set up       : {'yes' if is_setup() else 'no'} (include mode: {st['bind_mode']})")
    print(f"profiles     : {len(profile_names())}")
    check_version(interactive=sys.stdin.isatty())


# ---------------------------------------------------------------- menu
def pick_profile(prompt="Profile"):
    names = profile_names()
    if not names:
        print("No profiles yet.")
        return None
    for i, n in enumerate(names, 1):
        p = load_profile(n)
        print(f"  {i}) {n}  [{p.get('bind') or 'no shortcut'}]")
    s = ask(f"{prompt} (number or name): ")
    if s.isdigit() and 1 <= int(s) <= len(names):
        return names[int(s) - 1]
    return s if s in names else None


def menu():
    print(bold(f"{NAME} v{VERSION}"))
    if not is_setup():
        print("Not set up yet.")
        if ask("Run setup now? [Y/n]: ", "y").lower().startswith("y"):
            cmd_setup()
        else:
            return
    else:
        check_version()
    while True:
        print(f"\n{bold(f'{NAME} v{VERSION}')}  (niri {niri_version()})\n"
              " 1) Capture the current layout as a new profile\n"
              " 2) List profiles\n 3) Show a profile (windows and launch commands)\n"
              " 4) Restore a profile\n 5) Change shortcut\n 6) Rename\n"
              " 7) Edit windows (URLs, arguments, delete)\n 8) Re-capture a profile's layout\n"
              " 9) Enable / disable\n10) Delete\n11) Setup / repair\n12) Status & Niri version\n"
              "13) Debug & logs\n14) Uninstall\n 0) Quit")
        c = ask("> ")
        try:
            if c == "1":
                cmd_capture()
            elif c == "2":
                cmd_list()
            elif c in ("3", "4", "5", "6", "7", "8", "9", "10"):
                n = pick_profile()
                if not n:
                    continue
                if c == "3":
                    cmd_show(n)
                elif c == "4":
                    cmd_restore(n)
                elif c == "5":
                    cmd_rebind(n)
                elif c == "6":
                    cmd_rename(n, ask("New name: "))
                elif c == "7":
                    cmd_edit(n)
                elif c == "8":
                    cmd_capture(n, recapture=True)
                elif c == "9":
                    cmd_enable(n, not load_profile(n).get("enabled", True))
                elif c == "10":
                    cmd_delete(n)
            elif c == "11":
                cmd_setup()
            elif c == "12":
                cmd_status()
            elif c == "13":
                cmd_debug(ask("on / off / show / clear (Enter = status): ") or None)
            elif c == "14":
                cmd_uninstall()
                if not is_setup():
                    return
            elif c in ("0", "q"):
                return
        except SystemExit as e:
            if e.code not in (0, None):
                print("(action failed, see message above)")
        except KeyboardInterrupt:
            print()


# ---------------------------------------------------------------- CLI
class Parser(argparse.ArgumentParser):
    def print_help(self, file=None):
        print(f"{NAME} v{VERSION}", file=file or sys.stdout)
        super().print_help(file)


def main():
    ap = Parser(prog=NAME, formatter_class=argparse.RawDescriptionHelpFormatter,
                description="Save and restore Niri workspace layouts, each with its own shortcut.\n"
                            "Run without arguments for an interactive menu.")
    ap.add_argument("--version", action="version", version=f"{NAME} v{VERSION}")
    ap.add_argument("--debug", action="store_true",
                    help="log every niri call and decision (stderr + log file); works anywhere on the line")
    sub = ap.add_subparsers(dest="cmd", metavar="COMMAND", parser_class=Parser)
    sub.add_parser("setup", help="install script, create config dir, add include to config.kdl")
    c = sub.add_parser("capture", help="record the current layout as a new profile")
    c.add_argument("name", nargs="?")
    c.add_argument("--bind", help="shortcut, e.g. Mod+Alt+1")
    c.add_argument("--yes", action="store_true", help="no prompts (needs NAME)")
    sub.add_parser("recapture", help="replace a profile's layout with the current one").add_argument("name")
    r = sub.add_parser("restore", help="launch and place a profile's windows")
    r.add_argument("name")
    r.add_argument("--dry-run", action="store_true", help="print every launch and niri action, change nothing")
    sub.add_parser("list", help="list profiles")
    sub.add_parser("show", help="show a profile's windows and exact launch commands").add_argument("name")
    b = sub.add_parser("rebind", help="change a profile's shortcut")
    b.add_argument("name")
    b.add_argument("bind", nargs="?")
    rn = sub.add_parser("rename", help="rename a profile")
    rn.add_argument("old")
    rn.add_argument("new")
    sub.add_parser("edit", help="edit a profile's window commands / URLs").add_argument("name")
    sub.add_parser("enable", help="enable a profile").add_argument("name")
    sub.add_parser("disable", help="disable a profile (keeps its files)").add_argument("name")
    d = sub.add_parser("delete", help="delete a profile")
    d.add_argument("name")
    d.add_argument("--yes", action="store_true")
    cf = sub.add_parser("confirm", help="record the installed Niri version as supported")
    cf.add_argument("--no", action="store_true", help="record it as NOT supported")
    ud = sub.add_parser("uninstall", help="remove the config include and everything this script created")
    ud.add_argument("--yes", action="store_true")
    dg = sub.add_parser("debug", help="debug logging: on | off | show | clear (no argument = status)")
    dg.add_argument("action", nargs="?", choices=["on", "off", "show", "clear"])
    sub.add_parser("status", help="show setup state and Niri version tracking")
    global DEBUG, PERSIST_DEBUG
    if "--debug" in sys.argv[1:]:
        DEBUG = True
        sys.argv = [x for x in sys.argv if x != "--debug"]
    if STATE.exists():
        PERSIST_DEBUG = bool(load_state().get("debug"))
    a = ap.parse_args()
    if DEBUG or PERSIST_DEBUG:
        log(f"run: {NAME} v{VERSION} args={sys.argv[1:]} niri={niri_version() if shutil.which('niri') else 'missing'}")

    if not a.cmd:
        if not sys.stdin.isatty():
            ap.print_help()
            return
        return menu()
    if a.cmd not in ("restore", "uninstall", "debug") and not shutil.which("niri"):
        die("`niri` not found in PATH")
    if a.cmd in ("capture", "recapture", "rebind", "rename", "edit", "enable", "disable",
                 "delete", "list", "restore", "show"):
        require_setup()
    if a.cmd == "setup":
