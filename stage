# ---------------------------------------------------------------- interface (gum)
GUM_CANCEL = (0, 1, 130)


def have_gum():
    return bool(shutil.which("gum"))


def need_gum():
    if not have_gum():
        die("the interface needs gum. Install it with: sudo pacman -S gum")


def clear():
    if sys.stdout.isatty():
        print("\033[2J\033[H", end="")


def pause(msg="Press Enter to continue..."):
    try:
        input(dim("\n" + msg))
    except EOFError:
        pass


def notice(msg, secs=1.5):
    print(yellow(msg))
    time.sleep(secs)


def clean(t):
    return re.sub(r"[,\r\n\t]+", " ", t).strip()


def _gum(args):
    r = subprocess.run(["gum", *args], stdout=subprocess.PIPE, text=True)
    log(f"gum {shlex.join(args)[:300]} -> rc={r.returncode} out={r.stdout.strip()[:300]!r}")
    if r.returncode not in GUM_CANCEL:
        print(f"gum exited with code {r.returncode}; see the message above.", file=sys.stderr)
        pause()
    return r


def ui_choose(header, items, selected=None, multi=False):
    """Single choice -> str, multi -> list of str. None when cancelled (Esc)."""
    rows = max(3, min(len(items), shutil.get_terminal_size().lines - 8))
    args = ["choose", "--header", header, "--height", str(rows), "--cursor", "> ", "--show-help"]
    if multi:
        args += ["--no-limit", "--cursor-prefix", "[ ] ", "--selected-prefix", "[x] ", "--unselected-prefix", "[ ] "]
        if selected:
            args += ["--selected", ",".join(selected)]
    r = _gum(args + list(items))
    if r.returncode:
        return None
    out = [x.rstrip() for x in r.stdout.split("\n") if x.strip()]
    return out if multi else (out[0] if out else None)


def ui_input(header, value="", placeholder=""):
    cols = shutil.get_terminal_size().columns
    args = ["input", "--header", header, "--placeholder", placeholder, "--prompt", "> ",
            "--char-limit", "2000", "--width", str(max(30, cols - 6))]
    if value:
        args += ["--value", value]
    r = _gum(args)
    return None if r.returncode else r.stdout.rstrip("\n")


def ui_confirm(question, default=True):
    return _gum(["confirm", question, f"--default={'true' if default else 'false'}"]).returncode == 0


def banner():
    clear()
    subprocess.run(["gum", "style", "--border", "rounded", "--padding", "0 2", "--bold",
                    f"{NAME} v{VERSION}   niri {niri_version()}"])


def run_action(fn, *a, wait=True):
    try:
        fn(*a)
    except SystemExit:
        pass  # die() already printed the reason
    if wait:
        pause()


# ---- window lists
def window_item(i, it):
    ws = str(it["workspace"]["name"] or it["workspace"]["idx"])
    label = (it.get("label") or it.get("app_id") or "?")[:20]
    return clean(f"{i:<3}{label:<20} ws{ws:<3} {pos_str(it):<8} {(it.get('title') or '')[:34]}")


def edit_line(i, it):
    s = f"{i:<3}{(it.get('label') or it.get('app_id') or '?')[:20]:<20} {(it.get('title') or '')[:30]}"
    if it.get("url"):
        s += f"  -> {it['url']}"
    if it.get("args"):
        s += f"  + {it['args']}"
    return clean(s)


def choose_windows_ui(items):
    lines = [window_item(i, it) for i, it in enumerate(items, 1)]
    pre = [l for l, it in zip(lines, items) if not it["_skip"]]
    out = ui_choose("Which windows belong in this profile?\nx or Tab = toggle   Enter = confirm   Esc = cancel",
                    lines, selected=pre, multi=True)
    if out is None:
        return None
    keep = {int(re.match(r"(\d+)", l)[1]) for l in out}
    return [it for i, it in enumerate(items, 1) if i in keep]


def window_menu(it):
    """Returns 'remove' if the window should be dropped, else 'ok'."""
    opts = ["Set URL(s) to open", "Set extra arguments", "Edit the launch command (advanced)",
            "Remove this window from the profile", "Back"]
    while True:
        warn = "\n!! temp AppImage path: use 'Edit the launch command' to set the real one" \
            if any(t.startswith("/tmp/.mount_") for t in it["cmd"]) else ""
        head = (f"{it.get('label') or it.get('app_id')}: {it.get('title') or ''}\n"
                f"runs: {shlex.join(it['cmd'])}\n"
                f"URL(s): {it.get('url') or '-'}    extra arguments: {it.get('args') or '-'}{warn}")
        c = ui_choose(head, opts)
        if c is None or c == opts[4]:
            return "ok"
        if c == opts[0]:
            v = ui_input("URL(s) to open. Several URLs = several tabs, separated by spaces. Empty clears.",
                         value=it.get("url") or "", placeholder="https://example.com")
            if v is not None:
                it["url"] = v.strip() or None
        elif c == opts[1]:
            v = ui_input("Extra arguments added after the command. Empty clears.",
                         value=it.get("args") or "", placeholder="--incognito")
            if v is not None:
                try:
                    shlex.split(v)
                    it["args"] = v.strip()
                except ValueError as e:
                    notice(f"Not saved: {e}")
        elif c == opts[2]:
            v = ui_input("Launch command (replaces the detected one)", value=shlex.join(it["cmd"]))
            if v is not None and v.strip():
                try:
                    it["cmd"] = shlex.split(v)
                except ValueError as e:
                    notice(f"Not saved: {e}")
        elif c == opts[3] and ui_confirm("Remove this window from the profile?", False):
            return "remove"


def edit_windows_ui(items, done, header):
    """Pick a window to customize. Returns the edited list, or None if cancelled."""
    items = [dict(it) for it in items]
    ok_label, cancel_label = f"[ {done} ]", "[ Cancel ]"
    while True:
        lines = [edit_line(i, it) for i, it in enumerate(items, 1)] + [ok_label, cancel_label]
        c = ui_choose(header + "\nPick a window to change it.", lines)
        if c is None or c == cancel_label:
            return None
        if c == ok_label:
            return items
        m = re.match(r"(\d+)", c)
        if m and 1 <= int(m[1]) <= len(items):
            if window_menu(items[int(m[1]) - 1]) == "remove":
                del items[int(m[1]) - 1]
                if not items:
                    return items


# ---- shortcut picker
def pick_bind_ui(exclude=None, current=None):
    """Returns (True, bind-or-None) or (False, None) if cancelled."""
    taken = existing_binds(exclude)
    sugg = [c for c in (f"Mod+Alt+{n}" for n in range(1, 10)) if norm_combo(c) not in taken][:4]
    keep = f"Keep current ({current})" if current else None
    own, none = "Type my own...", "No shortcut"
    opts = ([keep] if keep else []) + sugg + [own, none]
    while True:
        c = ui_choose("Choose a shortcut for this profile (your keyboard can't be recorded in a terminal)", opts)
        if c is None:
            return False, None
        if c == keep:
            return True, current
        if c == none:
            return True, None
        if c != own:
            return True, c
        v = ui_input("Type a shortcut like Mod+Shift+F2 (run `wev` to see key names)", placeholder="Mod+Alt+1")
        if not v:
            continue
        v = v.strip()
        if not COMBO_RE.match(v):
            notice("Invalid. Use a format like Mod+Alt+1.")
            continue
        where = taken.get(norm_combo(v))
        if where and where.startswith("profile"):
            notice(f"{v} is already used by {where}.")
            continue
        if where and not ui_confirm(f"{v} is already used in {where}. Use it anyway?", False):
            continue
        return True, v


# ---- capture wizard
def ui_capture(name=None, recapture=False):
    require_setup()
    old = load_profile(name) if recapture else None
    if recapture and not old:
        die(f"no such profile: {name}")
    clear()
    print("Reading your open windows...")
    items = capture_windows()
    if not items:
        notice("No windows found.")
        return None
    if old:  # carry over edited commands/URLs by app_id
        pool = list(old["windows"])
        for it in items:
            m = next((o for o in pool if o["app_id"] == it["app_id"]), None)
            if m:
                pool.remove(m)
                it["cmd"], it["url"], it["args"] = m["cmd"], m.get("url"), m.get("args", "")
    total = 3 if recapture else 5
    while True:
        clear()
        step(1, total, "Choose which windows to include")
        kept = choose_windows_ui(items)
        if kept is None:
            return None
        if kept:
            break
        notice("Pick at least one window (x or Tab toggles).")
    clear()
    step(2, total, "Customize windows (optional)")
    kept = edit_windows_ui(kept, "Continue", "Set URLs or extra arguments where you want them.")
    if not kept:
        return None
    if not recapture:
        while True:
            clear()
            step(3, total, "Name the profile")
            name = ui_input("Name this profile (letters, digits, - and _)", placeholder="work")
            if name is None:
                return None
            name = name.strip()
            if not NAME_RE.match(name):
                notice("Use letters, digits, - and _ only.")
            elif load_profile(name):
                notice("A profile with that name already exists.")
            else:
                break
        clear()
        step(4, total, "Choose a shortcut")
        ok, bind = pick_bind_ui()
        if not ok:
            return None
    p = old or {"name": name, "bind": bind, "enabled": True, "existing": "move", "timeout": 20}
    p["windows"], p["captured_with"] = strip_internal(kept), niri_version()
    clear()
    step(total, total, "Review and save")
    print(f"  Name     : {p['name']}")
    print(f"  Shortcut : {p.get('bind') or 'none'}")
    print_rows(p["windows"])
    print()
    if not ui_confirm("Save this profile?"):
        print("Cancelled, nothing saved.")
        return None
    save_new(p)
    return p["name"]


# ---- screens
def ui_edit(name):
    p = need_profile(name)
    res = edit_windows_ui(p["windows"], "Save changes", f"Editing '{name}'")
    if res is None:
        return
    if not res:
        notice("A profile needs at least one window. Use Delete to remove the whole profile.")
        return
    p["windows"] = res
    mutate(lambda s: save_profile(p))
    print("Saved.")
    pause()


def ui_rename(name):
    v = ui_input("New name (letters, digits, - and _)", value=name)
    if v is None or v.strip() in ("", name):
        return name
    v = v.strip()
    if not NAME_RE.match(v) or load_profile(v):
        notice("That name is invalid or already used.")
        return name
    run_action(cmd_rename, name, v)
    return v


def ui_profile(name):
    while True:
        p = load_profile(name)
        if not p:
            return
        on = p.get("enabled", True)
        policy = "move it into place" if p.get("existing", "move") == "move" else "launch a new one"
        actions = [("Restore now", "restore"), ("Preview what restore would do (dry run)", "preview"),
                   ("Show windows and launch commands", "show"),
                   ("Edit windows (URLs, arguments, remove)", "edit"), ("Change shortcut", "bind"),
                   ("Rename", "rename"), ("Re-capture the layout from the windows open now", "recap"),
                   (f"If a window is already open: {policy} (switch)", "policy"),
                   ("Disable" if on else "Enable", "toggle"), ("Delete", "delete"), ("Back", "back")]
        banner()
        c = ui_choose(f"{name}    shortcut: {p.get('bind') or 'none'}    {len(p['windows'])} windows"
                      + ("    (disabled)" if not on else ""), [a for a, _ in actions])
        chosen = dict(actions).get(c, "back")
        if chosen == "back":
            return
        if chosen == "restore":
            run_action(cmd_restore, name)
        elif chosen == "preview":
            run_action(cmd_restore, name, True)
        elif chosen == "show":
            run_action(cmd_show, name)
        elif chosen == "edit":
            run_action(ui_edit, name, wait=False)
        elif chosen == "bind":
            ok, b = pick_bind_ui(exclude=name, current=p.get("bind"))
            if ok:
                run_action(cmd_rebind, name, b or "none", True)
        elif chosen == "rename":
            name = ui_rename(name)
        elif chosen == "recap":
            run_action(ui_capture, name, True)
        elif chosen == "policy":
            p["existing"] = "spawn" if p.get("existing", "move") == "move" else "move"
            run_action(mutate, lambda s: save_profile(p))
        elif chosen == "toggle":
            run_action(cmd_enable, name, not on)
        elif chosen == "delete" and ui_confirm(f"Delete profile '{name}'? This can't be undone.", False):
            run_action(cmd_delete, name)
            return


def ui_settings():
    while True:
        banner()
        dbg = load_state().get("debug")
        opts = ["Niri version status", f"Debug logging is {'ON' if dbg else 'off'} (select to switch)",
                "Show the debug log", "Clear the debug log", f"Uninstall {NAME}...", "Back"]
        c = ui_choose("Settings and maintenance", opts)
        if c is None or c == opts[5]:
            return
        if c == opts[0]:
            run_action(cmd_status)
        elif c == opts[1]:
            run_action(cmd_debug, "off" if dbg else "on")
        elif c == opts[2]:
            run_action(cmd_debug, "show")
        elif c == opts[3]:
            run_action(cmd_debug, "clear")
        elif c == opts[4]:
            run_action(cmd_uninstall, False, lambda: ui_confirm("Remove all of that?", False))
            if not is_setup():
                return


def profile_line(n):
    p = load_profile(n)
    return clean(f"{n:<16}{(p.get('bind') or '-'):<16}{len(p['windows'])} windows"
                 + ("  (disabled)" if not p.get("enabled", True) else ""))


def ui_home():
    new, sett, quit_ = "+ New profile from the windows open now", "Settings and maintenance", "Quit"
    while True:
        banner()
        names = profile_names()
        lines = {profile_line(n): n for n in names}
        head = ("Your profiles. Enter opens one." if names
                else "No profiles yet. Arrange your windows the way you like, then choose 'New profile'.")
        c = ui_choose(head, list(lines) + [new, sett, quit_])
        if c is None or c == quit_:
            return
        if c == new:
            run_action(ui_capture, wait=True)
        elif c == sett:
            ui_settings()
            if not is_setup():
                return
        elif c in lines:
            ui_profile(lines[c])


def run_ui():
    need_gum()
    if not shutil.which("niri"):
        die("`niri` not found in PATH")
    if not is_setup():
        banner()
        print(f"{NAME} is not set up yet. Setup will:")
        print(f"  - copy this script to {BIN}")
        print(f"  - add one include line to your Niri config (backed up and validated first)")
        print(f"  - create {DIR}")
        if LEGACY_DIR.exists():
            print(yellow(f"  - migrate your existing {LEGACY} profiles"))
        print()
        if not ui_confirm("Set up now?"):
            return
        run_action(cmd_setup)
        if not is_setup():
            return
    else:
        check_version()
    ui_home()


# ---------------------------------------------------------------- CLI
class Parser(argparse.ArgumentParser):
    def print_help(self, file=None):
        print(f"{NAME} v{VERSION}", file=file or sys.stdout)
        super().print_help(file)


def main():
    global DEBUG, PERSIST_DEBUG
    ap = Parser(prog=NAME, formatter_class=argparse.RawDescriptionHelpFormatter,
                description="Save your Niri window layouts as one-key profiles and bring them back later.\n"
                            "Run with no arguments for the interactive interface (needs gum).")
    ap.add_argument("--version", action="version", version=f"{NAME} v{VERSION}")
    ap.add_argument("--debug", action="store_true",
                    help="log every niri call and decision (stderr + log file); works anywhere on the line")
    sub = ap.add_subparsers(dest="cmd", metavar="COMMAND", parser_class=Parser)
    sub.add_parser("setup", help="install to ~/.local/bin, create the config dir, add one include line to config.kdl")
    c = sub.add_parser("capture", help="with NAME: save every open window (no prompts); without: guided capture")
    c.add_argument("name", nargs="?")
    c.add_argument("--bind", help="shortcut for NAME, e.g. Mod+Alt+1")
    r = sub.add_parser("restore", help="launch and place a profile's windows (what shortcuts call)")
    r.add_argument("name")
    r.add_argument("--dry-run", action="store_true", help="print every launch and niri action, change nothing")
    sub.add_parser("list", help="list profiles")
    sub.add_parser("show", help="show a profile's windows and exact launch commands").add_argument("name")
    cf = sub.add_parser("confirm", help="record the installed Niri version as supported")
    cf.add_argument("--no", action="store_true", help="record it as NOT supported")
    sub.add_parser("status", help="show setup state and Niri version tracking")
    dg = sub.add_parser("debug", help="debug logging: on | off | show | clear (no argument = status)")
    dg.add_argument("action", nargs="?", choices=["on", "off", "show", "clear"])
    ud = sub.add_parser("uninstall", help="remove the config include and everything this script created")
    ud.add_argument("--yes", action="store_true")
    if "--debug" in sys.argv[1:]:
        DEBUG = True
        sys.argv = [x for x in sys.argv if x != "--debug"]
    if STATE.exists():
        PERSIST_DEBUG = bool(load_state().get("debug"))
    a = ap.parse_args()
    if DEBUG or PERSIST_DEBUG:
        log(f"run: {NAME} v{VERSION} args={sys.argv[1:]} niri={niri_version() if shutil.which('niri') else 'missing'}")
    if not a.cmd:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            ap.print_help()
            return
        return run_ui()
    if a.cmd not in ("restore", "uninstall", "debug") and not shutil.which("niri"):
        die("`niri` not found in PATH")
    if a.cmd in ("capture", "list", "restore", "show"):
        require_setup()
    if a.cmd == "setup":
        cmd_setup()
    elif a.cmd == "capture":
        if a.name:
            cmd_capture(a.name, a.bind)
        else:
            need_gum()
            run_action(ui_capture)
    elif a.cmd == "restore":
        cmd_restore(a.name, a.dry_run)
    elif a.cmd == "list":
        cmd_list()
    elif a.cmd == "show":
        cmd_show(a.name)
    elif a.cmd == "confirm":
        cmd_confirm(a.no)
    elif a.cmd == "status":
        cmd_status()
    elif a.cmd == "debug":
        cmd_debug(a.action)
    elif a.cmd == "uninstall":
        cmd_uninstall(a.yes)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
