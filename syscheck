# =====================================================================================
# 9. PRIVACY MASKING (runs on the temp file, then the clean copy is saved)
# =====================================================================================
N_IP4=0; N_IP6=0; N_MAC=0; N_NAME=0; N_SER=0; N_UUID=0

# unique matches, longest first (so 192.168.1.10 is replaced before 192.168.1.1)
uniq_matches() { # file, ERE
    grep -oiE "$2" "$1" | sort -u | awk '{print length, $0}' | sort -rn | cut -d' ' -f2-
}
esc_re() { printf '%s' "$1" | sed -e 's/[]\/$*.^[(){}+?|]/\\&/g'; }
redact_literal() { # file, literal, label, [nob = no word boundaries]
    local e; e="$(esc_re "$2")"
    if [ "$4" = "nob" ]; then
        sed -E -i "s/${e}/$3/g" "$1"
    else
        sed -E -i "s/\\b${e}\\b/$3/g" "$1"
    fi
}

mask_report() {
    local L=() i H MID REALNAME

    # MAC addresses
    mapfile -t L < <(uniq_matches "$RAW" '\b([0-9a-f]{2}:){5}[0-9a-f]{2}\b')
    for i in "${!L[@]}"; do sed -E -i "s/${L[$i]}/MAC-ADDR-$((i+1))/Ig" "$RAW"; done
    N_MAC=${#L[@]}

    # Private / link-local IPv4
    mapfile -t L < <(uniq_matches "$RAW" '\b(10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|169\.254\.[0-9]+\.[0-9]+)\b')
    for i in "${!L[@]}"; do redact_literal "$RAW" "${L[$i]}" "LAN-IP-$((i+1))"; done
    N_IP4=${#L[@]}

    # IPv6: link-local, unique-local, global
    mapfile -t L < <(uniq_matches "$RAW" '\b(fe80|f[cd][0-9a-f]{2}|[23][0-9a-f]{3})(:[0-9a-f]{0,4}){2,7}')
    for i in "${!L[@]}"; do redact_literal "$RAW" "${L[$i]}" "IPV6-ADDR-$((i+1))" nob; done
    N_IP6=${#L[@]}

    # Hostname (skip generic defaults, masking those would damage normal text)
    for H in "$(hostname 2>/dev/null)" "$(hostnamectl hostname 2>/dev/null)" "$(hostnamectl --static 2>/dev/null)"; do
        case "$H" in ""|fedora|archlinux|arch|archiso|localhost|localhost.localdomain) continue ;; esac
        if grep -qF -- "$H" "$RAW"; then redact_literal "$RAW" "$H" "HOSTNAME"; N_NAME=$((N_NAME+1)); fi
    done

    # Username and real name
    if [ -n "$USER" ] && [ "$USER" != "root" ]; then
        sed -E -i "s#/home/$(esc_re "$USER")(/|\\b)#/home/USER\\1#g" "$RAW"
        # systemd-escaped paths, e.g. app-\x2fhome\x2fNAME\x2f...
        sed -E -i "s#(home\\\\x2f)$(esc_re "$USER")#\\1USER#g" "$RAW"
        if [ "${#USER}" -ge 4 ] && grep -qw -- "$USER" "$RAW"; then
            redact_literal "$RAW" "$USER" "USER"; N_NAME=$((N_NAME+1))
        fi
        REALNAME="$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)"
        if [ "${#REALNAME}" -ge 3 ] && grep -qF -- "$REALNAME" "$RAW"; then
            redact_literal "$RAW" "$REALNAME" "REAL-NAME" nob; N_NAME=$((N_NAME+1))
        fi
    fi

    # Saved Wi-Fi / VPN profile names
    if have nmcli; then
        mapfile -t L < <(nmcli -t -f NAME connection show 2>/dev/null | sed 's/\\:/:/g' | awk 'length($0)>=4' \
            | grep -vE '^(Wired connection [0-9]+|lo|docker[0-9]*|virbr[0-9]*|br-.*)$' | sort -u)
        for i in "${!L[@]}"; do
            if grep -qF -- "${L[$i]}" "$RAW"; then
                redact_literal "$RAW" "${L[$i]}" "NET-NAME-$((i+1))" nob; N_NAME=$((N_NAME+1))
            fi
        done
    fi

    # Serial numbers / service tags
    N_SER=$(grep -ciE '^[[:space:]]*(serial number|serial|service tag)[[:space:]]*:' "$RAW")
    sed -E -i 's/^([[:space:]]*(serial number|serial|service tag)[[:space:]]*:[[:space:]]*).*/\1[REDACTED]/I' "$RAW"

    # Machine ID and filesystem/partition UUIDs
    MID="$(cat /etc/machine-id 2>/dev/null)"
    if [ -n "$MID" ] && grep -qF -- "$MID" "$RAW"; then
        redact_literal "$RAW" "$MID" "MACHINE-ID" nob; N_NAME=$((N_NAME+1))
    fi
    mapfile -t L < <(uniq_matches "$RAW" '\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b')
    for i in "${!L[@]}"; do sed -E -i "s/${L[$i]}/UUID-$((i+1))/Ig" "$RAW"; done
    N_UUID=${#L[@]}
}

# =====================================================================================
# 10. THE REPORT: every section and check, in order
# =====================================================================================
# The h_* helpers are copied into every check, so collect their text now (all definitions are above).
HELPER_DEFS="$(declare -f $(compgen -A function h_))"

{
    echo "SYSTEM CHECK REPORT"
    echo "Generated: $(date)"
    echo "Script: $NAME v$VERSION (bash $BASH_VERSION)"
    if [ "$FULL" -eq 1 ]; then echo "Mode: FULL (every detail included)"
    elif [ "$SUMONLY" -eq 1 ]; then echo "Mode: summary only (one line per check; run without --summary for details of problems)"
    else echo "Mode: default (healthy checks are one line, problems keep full details; --summary is shorter, --full is longer)"; fi
    echo "Other modes: re-run 'syscheck --full' (aliases --detailed, --detail, --verbose) for every detail of every check,"
    echo "or 'syscheck --summary' for one line per check. An OK line means the script judged that check healthy by a fixed"
    echo "rule; if you doubt a verdict or need the raw evidence, ask for a --full report."
    echo "Deadlines: ordinary checks ${DL_LOCAL}s, heavy local checks ${DL_SLOW}s, internet checks up to ${DL_NET}s each (${NET_BUDGET}s in total); a check that reaches its limit is marked [CHECK] as timed out."
    echo "Privacy: IPs, MACs, hostname, username, Wi-Fi/VPN names, serials, machine-id and UUIDs were masked automatically."
    [ "$UPTIME_S" -lt 300 ] && echo "WARNING: taken ${UPTIME_S}s after boot, so load, CPU clocks and memory figures are NOT representative."
    echo
    echo "@@SUMMARY@@"
} > "$RAW"

