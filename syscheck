    if grep -q "OFF BY CHOICE" <<<"$out"; then
        MSG="service disabled by choice ($(head -1 <<<"$out"))"
        grep -q "errors this boot[^:]*: 0$" <<<"$out"
    elif grep -q "NO ADAPTER" <<<"$out"; then
        WHYMSG="NO ADAPTER: service enabled but no adapter detected (BIOS/UEFI switch? else disable bluetooth.service)"
        return 1
    else
        MSG="controller powered on, no kernel errors this boot"
        grep -q "Powered: yes" <<<"$out" && grep -q "errors this boot[^:]*: 0$" <<<"$out"
    fi
}
