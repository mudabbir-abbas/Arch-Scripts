    ! grep -qE "(8[5-9]|9[0-9]|100)%" <<<"$out"
}

c_smart() {
    local s q du ph
    s=$(smartctl -a /dev/nvme0n1)
    echo "$s" | grep -E "Model Number|Critical Warning|^Temperature|Available Spare:|Percentage Used|Data Units Written|Power On Hours|Unsafe Shutdowns|Media and Data Integrity|Error Information Log Entries"
    q=$(echo "$s" | grep -cE "Model Number:.*BC501")
    echo "$s" | awk -v q="$q" -F: '/^Available Spare:/{v=$2; gsub(/[^0-9]/,"",v); if (v+0<100) print "WARNING: available spare fell to " v "%: the drive is remapping worn blocks. Back up and plan a replacement."} /Percentage Used/{v=$2; gsub(/[^0-9]/,"",v); if (q>0) { if (v+0>=70) print "NOTE: the drive reports " v "% wear, but the BC501 family is known to over-report it; judged by Available Spare, media errors and Critical Warning instead." } else if (v+0>=90) print "CRITICAL: " v "% of rated endurance used. Back up now and replace the drive."; else if (v+0>=70) print "WARNING: " v "% of rated endurance used. Keep a real backup (snapshots are not backups) and plan a replacement."}'
    du=$(echo "$s" | sed -nE "s/^Data Units Written: +([0-9,]+).*/\1/p" | tr -d ,)
    ph=$(echo "$s" | sed -nE "s/^Power On Hours: +([0-9,]+).*/\1/p" | tr -d ,)
    [ -n "$du" ] && [ "${ph:-0}" -gt 0 ] && echo "lifetime average: $(( du * 512000 / ph / 1000000 )) MB written per power-on hour (includes any previous OS/owner)"
    true
}
t_smart() {
    if grep -q "^NOTE" <<<"$out"; then
        MSG="$(grep -m1 "^Percentage Used" <<<"$out" | tr -s " ") reported, but the BC501 over-reports it; spare, media errors and critical warning are clean"
    fi
    ! grep -qE "^(WARNING|CRITICAL)" <<<"$out" && grep -qE "Critical Warning: +0x00" <<<"$out" && grep -qE "Media and Data Integrity Errors: +0$" <<<"$out"
}
c_smart_missing() { echo "not installed"; }

c_btrfs() {
