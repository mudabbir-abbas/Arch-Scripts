# ---------- 12. Updates and packages ----------
c_repo_updates() {
    local o r
    if ! command -v checkupdates >/dev/null; then echo "checkupdates missing (sudo pacman -S pacman-contrib)"; return; fi
    o=$(checkupdates 2>&1); r=$?
    case $r in
        2) echo "No repo updates available" ;;
        0) printf "%s\n" "$o" | head -15; echo "($(printf "%s\n" "$o" | grep -c .) pending; apply with: sudo pacman -Syu)" ;;
        *) echo "checkupdates failed (exit $r): $o" | head -5 ;;
    esac
}
# Pending updates are only a problem when the system has not had a full upgrade for UPDATE_AGE_DAYS.
# (pacman.log tells when the last -Syu ran; nothing is stored by this script.)
t_repo_updates() {
    local n days
    if grep -q "No repo updates available" <<<"$out"; then MSG="no repo updates available"; return 0; fi
    n=$(sed -nE 's/^\(([0-9]+) pending;.*/\1/p' <<<"$out")
    [ -n "$n" ] || return 1                 # checkupdates failed or is missing
    days=$(h_days_since_upgrade)
    if [ -z "$days" ]; then MSG="$n repo update(s) pending (no full upgrade found in pacman.log, age unknown)"; return 0; fi
    if [ "$days" -ge "$UPDATE_AGE_DAYS" ]; then
        WHYMSG="$n repo update(s) pending; last full upgrade ${days} days ago (apply with: sudo pacman -Syu)"
        return 1
    fi
    MSG="$n repo update(s) available; last full upgrade ${days} day(s) ago (attention after ${UPDATE_AGE_DAYS})"
}

c_aur_updates() {
