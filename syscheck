c_bluetooth() {
    local en ac adapter n o
    en=$(systemctl is-enabled bluetooth 2>&1); ac=$(systemctl is-active bluetooth 2>&1)
    adapter=$(ls /sys/class/bluetooth 2>/dev/null | tr "\n" " ")
    echo "service: $ac, unit file: $en"
    echo "adapter present in kernel: ${adapter:-none}"
    echo "rfkill: $(rfkill list bluetooth 2>&1 | grep -E "Soft blocked" | tr -s " " | tr "\n" ";")"
    n=$(journalctl -k -b --no-pager | grep -E "Bluetooth: hci[0-9]+: .*(failed|error|tx timeout)" | grep -vcF "Reading supported features failed (-16)")
    echo "kernel errors this boot (harmless Intel -16 feature query excluded): $n"
    case "$en/$ac" in
        disabled/inactive|masked/inactive|static/inactive) echo "OFF BY CHOICE";;
        *)
            if [ -z "$adapter" ]; then
                echo "NO ADAPTER: Bluetooth may be disabled in BIOS/UEFI; if intentional, disable bluetooth.service"
            else
                o=$(timeout 8 bluetoothctl show 2>&1)
                echo "controller: $(echo "$o" | grep -E "Powered:" | tr -s " " | head -1)"
                [ -z "$(echo "$o" | grep Powered)" ] && echo "controller: NOT ANSWERING"
            fi;;
    esac
}
