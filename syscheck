#!/usr/bin/env bash
# (made for a Dell Latitude 5400: systemd-boot + UKI + Plymouth, Btrfs + Snapper, zram,
#  power-profiles-daemon, greetd + dms-greeter)
#
# Usage:
#   syscheck                    save the report in the current folder
#                               (falls back to ~/Documents if that isn't writable)
#   syscheck -d DIR             save the report in DIR (created if missing)
#   syscheck --directory DIR    same as -d DIR  (--directory=DIR also works)
#   syscheck -s, --summary      one line per check, even for problems (shortest report)
#   syscheck -f, --full         every detail for every check
#                               (aliases: --detailed, --detail, --details, --verbose)
#   syscheck -h, --help         show this help
#   syscheck -v, --version      print the name and version, then exit
#
# Output modes:
#   default    healthy checks get one "OK" line; checks that need attention keep their
#              full details (marked [CHECK]). The top of the report lists them.
#   --summary  every check gets one line, problems included, with a short reason.
#   --full     nothing is condensed.
#
# Deadlines: every check has a time limit (ordinary 60 s, heavy local 300 s, internet 240 s each and
#   10 min in total); one that hits it is stopped, marked [CHECK] "timed out", and the run goes on.
#   Offline, internet checks are skipped. Slow link? DL_NET=400 syscheck (max 600 s per limit;
#   variables: DL_LOCAL, DL_SLOW, DL_NET, NET_BUDGET)
#
# NEW IN THIS VERSION (4.4.0):
#   - New: pending repo updates become an attention item only when the last full upgrade
#     (from pacman.log) is UPDATE_AGE_DAYS (7) or more days old. A fresh update is just
#     information. Nothing is stored on disk, so the script stays strictly read-only.
#   - AUR and Flatpak updates are informational (names shown) but a helper error is still flagged.
#   - "Network listeners" is informational, and prints (none) when empty.
#   - Bluetooth: an enabled service with no adapter is reported (BIOS/UEFI switch?).
#   - One shared list of known-benign log messages (BENIGN_RE) now feeds "Errors this boot",
#     "Kernel errors" and "Recurring errors"; new entries: duplicate Dolphin FileManager1 name,
#     greetd keyring notices, archlinux-keyring refresh probe.
#   - Unclean-shutdown detection (clean_end) is kept in "Per-boot problems".
#   - A check can now set its own failure reason for the summary (WHYMSG).
#   - Code: every check is a named function (c_* prints, t_* judges), and the report at the
#     bottom of the file lists them in order. Developer notes are above the engine.
NAME="syscheck"
VERSION="4.4.0"
#
# Read-only: it changes nothing and installs nothing.
# Privacy: hostname, username, real name, LAN IPs, MAC addresses, Wi-Fi/VPN
# profile names, serial numbers, machine-id and UUIDs are masked automatically before the final
# report is written. The unmasked data only ever exists in a private temp file
# that is deleted when the script ends.

usage() {
    echo "$NAME v$VERSION"
    echo
    awk 'NR>1 { if ($0 ~ /^(NAME|VERSION)=/) next; if ($0 !~ /^#/) exit; sub(/^# ?(DESC: *)?/,""); print }' "$0"
}

# =====================================================================================
# 1. OPTIONS
# =====================================================================================
DIR=""
DIR_GIVEN=0
FULL=0
SUMONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)      usage; exit 0 ;;
        -v|--version)   echo "$NAME v$VERSION"; exit 0 ;;
        -f|--full|--detailed|--detail|--details|--verbose) FULL=1; shift ;;
        -s|--summary)   SUMONLY=1; shift ;;
        -d|--directory)
            if [ -z "$2" ]; then echo "syscheck: $1 needs a folder name (try --help)" >&2; exit 2; fi
            DIR="$2"; DIR_GIVEN=1; shift 2 ;;
        --directory=*)  DIR="${1#*=}"; DIR_GIVEN=1; shift ;;
        -d?*)           DIR="${1#-d}"; DIR_GIVEN=1; shift ;;
        *)              echo "syscheck: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
done

if [ "$FULL" -eq 1 ] && [ "$SUMONLY" -eq 1 ]; then
    echo "syscheck: --summary and --full contradict each other, pick one (try --help)" >&2; exit 2
fi

# =====================================================================================
# 2. SETTINGS
# =====================================================================================
# Deadlines (seconds). Override from the environment. DL_MAX is the hard ceiling.
DL_LOCAL="${DL_LOCAL:-60}"            # ordinary checks
DL_SLOW="${DL_SLOW:-300}"             # heavy local checks (package verification, journal scans)
DL_NET="${DL_NET:-240}"               # each check that needs the internet
NET_BUDGET="${NET_BUDGET:-600}"       # all internet checks together
DL_MAX=600
for _v in DL_LOCAL DL_SLOW DL_NET NET_BUDGET; do
    case "${!_v}" in
        ''|*[!0-9]*) echo "syscheck: $_v must be a whole number of seconds, got '${!_v}' (try --help)" >&2; exit 2 ;;
    esac
    printf -v "$_v" '%s' "$((10#${!_v}))"                 # "060" is 60, not octal
    [ "${!_v}" -lt 5 ] && printf -v "$_v" '%s' 5
    [ "${!_v}" -gt "$DL_MAX" ] && printf -v "$_v" '%s' "$DL_MAX"
done
NET_USED=0; NET_MIN=10

# Pending repo updates are only an attention item when the last full upgrade is this old.
UPDATE_AGE_DAYS=7

# Log messages that are known to be harmless on this machine. One list, used by every
# journal/dmesg check. Written as an ERE, so it must work after the "recurring errors"
# check has replaced digits by "#". Add new entries here, nowhere else.
BENIGN_RE='SGX disabled|TDX not supported|multicast RX registrations|Touch jump|touchpad-jumping-cursors'
BENIGN_RE+='|libinput bug: invalid gesture event|log rate limit exceeded|text-to-speech plug-in'
BENIGN_RE+='|pam_unix\(sudo:auth\): (conversation failed|auth could not identify password)'
BENIGN_RE+='|Reading supported features failed \(-[0-9#]+\)|Error reading debug features|btd_adv_monitor_power_down'
BENIGN_RE+='|Ignoring duplicate name .org.freedesktop.FileManager'
BENIGN_RE+='|gkr-pam: (couldn.t unlock the login keyring|unable to locate daemon control file)'
BENIGN_RE+='|Failed to start Refresh existing keys of archlinux-keyring'

# =====================================================================================
# 3. TERMINAL HELPERS AND CLEANUP
# =====================================================================================
if [ -t 1 ]; then
    IS_TTY=1
    C_OK=$'\033[32m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_WARN=$'\033[33m'; C_OFF=$'\033[0m'
else
    IS_TTY=0; C_OK=""; C_DIM=""; C_BOLD=""; C_WARN=""; C_OFF=""
fi
clear_line() { [ "$IS_TTY" -eq 1 ] && printf '\r\033[K'; }

RAW="$(mktemp /tmp/syscheck-raw.XXXXXX)"      # the unmasked report (private, deleted at exit)
SUMF="$(mktemp /tmp/syscheck-sum.XXXXXX)"     # the summary block
CHK="$(mktemp /tmp/syscheck-chk.XXXXXX)"      # output of the check that is running
chmod 600 "$RAW" "$SUMF" "$CHK"
KEEPALIVE=""; TPID=""
cleanup() {
    rm -f "$RAW" "$SUMF" "$CHK"
    [ -n "$KEEPALIVE" ] && kill "$KEEPALIVE" 2>/dev/null
    [ -n "$TPID" ] && kill "$TPID" 2>/dev/null
}
trap cleanup EXIT
trap 'clear_line; echo "Interrupted. Nothing was saved."; exit 130' INT TERM

have() { command -v "$1" >/dev/null 2>&1; }
net_up() { ip route show default 2>/dev/null | grep -q .; }

# =====================================================================================
# 4. START-UP: banner, where to save, sudo
# =====================================================================================
echo "${C_BOLD}System check (Arch + Niri)${C_OFF} ${C_DIM}$NAME v$VERSION${C_OFF}  (read-only, nothing is changed)"
echo
if ! grep -qiE '^(ID|ID_LIKE)=.*arch' /etc/os-release 2>/dev/null; then
    echo "${C_WARN}Note: this does not look like Arch or an Arch derivative. Package checks will fail;"
    echo "use the Fedora version of the script instead.${C_OFF}"
    echo
fi

# a report taken right after boot is skewed (high load, boosted clocks, services still settling)
UPTIME_S="$(cut -d. -f1 /proc/uptime 2>/dev/null)"; UPTIME_S="${UPTIME_S:-9999}"
if [ "$UPTIME_S" -lt 300 ]; then
    echo "${C_WARN}Note: the system booted only ${UPTIME_S}s ago. CPU clocks, load and memory will not be"
    echo "representative. For a fair health check, run this again after ~5 minutes of normal use.${C_OFF}"
    echo
fi

if [ "$DIR_GIVEN" -eq 1 ]; then
    if [ -z "$DIR" ]; then echo "syscheck: empty folder name for -d (try --help)" >&2; exit 2; fi
    # explicit -d: honour it exactly, never silently save somewhere else
    DIR="${DIR/#\~/$HOME}"                      # expand a quoted ~
    [ "$DIR" != "/" ] && DIR="${DIR%/}"
    if ! { mkdir -p "$DIR" 2>/dev/null && [ -w "$DIR" ]; }; then
        echo "${C_WARN}syscheck: can't write to '$DIR'.${C_OFF}" >&2
        exit 1
    fi
    WHERE="folder you chose"
elif [ -d "$PWD" ] && [ -w "$PWD" ]; then
    DIR="$PWD"
    WHERE="current folder"
else
    DIR="$HOME/Documents"
    if ! { mkdir -p "$DIR" 2>/dev/null && [ -w "$DIR" ]; }; then
        echo "${C_WARN}syscheck: current folder and ~/Documents are both unwritable. Use -d DIR.${C_OFF}" >&2
        exit 1
    fi
    WHERE="~/Documents, because the current folder is not writable"
fi
DIR="$(cd "$DIR" && pwd)"                        # make it absolute
OUT="$DIR/syscheck-$(date +%Y%m%d-%H%M%S).txt"
echo "Report will be saved to: $OUT"
echo "                         ($WHERE)"
echo

# sudo once, kept alive in the background
HAVE_SUDO=0
echo "Some checks (SMART, dmesg, firewall) need sudo. Asking once:"
if sudo -v; then
    HAVE_SUDO=1
    ( while true; do
          sudo -n true 2>/dev/null || exit
          sleep 45
          kill -0 $$ 2>/dev/null || exit
      done ) &
    KEEPALIVE=$!
else
    echo "${C_WARN}No sudo, those checks will be skipped.${C_OFF}"
fi
echo

# =====================================================================================
# 5. DEVELOPER NOTES
# =====================================================================================
# HOW A CHECK IS BUILT
#   c_NAME   prints the facts. It runs in its own bash (with a deadline), so it cannot
#            change variables here. It may use h_* helpers and the exported variables
#            KNOWN_TPM, TPMFILT, THR0, BENIGN_RE.
#   t_NAME   decides "healthy?" from $out (the output) and $rc (the exit code):
#            return 0 = healthy, 1 = needs attention. It runs in this shell. It may set
#            MSG (the text of the OK line) or WHYMSG (the reason shown in the summary
#            when the check fails).
#   h_NAME   a helper that c_* functions can call. Defined here, copied into each check.
#
# HOW TO ADD A CHECK
#   1. Write c_NAME (and t_NAME if it can judge itself) in the CHECK LIBRARY below.
#   2. Add one line to the REPORT at the bottom, inside the right `section`:
#        run   "title" c_NAME                           always show the output
#        runq  "title" c_NAME t_NAME "OK message"       one OK line unless t_NAME fails
#        srun / srunq                                    same, but as root (sudo)
#        netrunq                                        same, needs the internet
#      Put CHECK_DL=$DL_SLOW in front for a heavy check (e.g. CHECK_DL=$DL_SLOW runq ...).
#   Ready-made verdicts: t_empty (no output), t_none (output is "none"), t_rc0, t_no_review.
#
# THE ENGINE
#   _exec runs c_NAME in `bash -c` with the helpers and the function text prepended
#   (with root: through `sudo -n`). runq/srunq/netrunq call t_NAME afterwards, keep the
#   output only when it fails (or in --full), and list failures in the summary.

# =====================================================================================
# 6. ENGINE
# =====================================================================================
_dl() { # deadline for the next check: CHECK_DL if set, else DL_LOCAL; never above DL_MAX
    local d="${CHECK_DL:-$DL_LOCAL}"
    [ "$d" -gt "$DL_MAX" ] && d="$DL_MAX"
    [ "$d" -lt 5 ] && d=5
    echo "$d"
}

TOTAL="$(grep -c '^section "' "$0" 2>/dev/null)"
[ "${TOTAL:-0}" -gt 0 ] || TOTAL=14
CUR_N=0; CUR_TITLE=""; CUR_START=0; NOISE=0
BAD=(); WHY=(); OK_N=0; out=""; rc=0; MSG=""; WHYMSG=""; TIMED_OUT=0; LAST_DL=0
HELPER_DEFS=""      # text of all h_* functions, filled in right before the report starts

section_end() {
    [ -n "$CUR_TITLE" ] || return
    local t=$((SECONDS - CUR_START))
    if [ "$IS_TTY" -eq 1 ]; then
        clear_line
        printf '%s[%2d/%d]%s %s %s(%ss)%s\n' "$C_OK" "$CUR_N" "$TOTAL" "$C_OFF" "$CUR_TITLE" "$C_DIM" "$t" "$C_OFF"
    fi
}

section() {
    section_end
    CUR_N=$((CUR_N + 1))
    CUR_TITLE="$1"
    CUR_START=$SECONDS
    {
        echo
        echo "=============================================================="
        echo "## $CUR_N. $1"
        echo "=============================================================="
    } >> "$RAW"
    if [ "$IS_TTY" -eq 0 ]; then
        printf '[%2d/%d] %s\n' "$CUR_N" "$TOTAL" "$1"
    fi
}

# the command line that runs one check: helpers + the function + the call
_fncmd() { printf '%s\n%s\n%s\n' "$HELPER_DEFS" "$(declare -f "$1")" "$1"; }

# _exec "what this check is" FUNCTION  -> sets $out and $rc  (ROOT=1 in front = run through sudo)
_exec() {
    local desc="$1" fn="$2" dl t0 note="" cmd grace=0
    dl="$(_dl)"; LAST_DL="$dl"; TIMED_OUT=0; t0=$SECONDS
    cmd="$(_fncmd "$fn")"
    if [ "${ROOT:-0}" = 1 ]; then
        # the root-level timeout inside sudo gets a head start (grace) on the outer one
        cmd="sudo -n $SUDO_ENV timeout -k 5 $dl bash -c $(printf '%q' "$cmd")"; grace=15
    fi
    [ "$dl" -gt "$DL_LOCAL" ] && note=" (may take up to ${dl}s)"
    if [ "$IS_TTY" -eq 1 ]; then
        printf '\r\033[K%s[%2d/%d]%s %s %s> %s%s%s' "$C_DIM" "$CUR_N" "$TOTAL" "$C_OFF" "$CUR_TITLE" "$C_DIM" "$desc" "$note" "$C_OFF"
    fi
    # Deadline: timeout runs the check in its own process group and stops everything it started when the
    # limit is reached. It runs in the background and we wait for it, so Ctrl+C reaches our trap at once.
    timeout -k 10 "$((dl + grace))" bash -c "$cmd" < /dev/null > "$CHK" 2>&1 &
    TPID=$!
    wait "$TPID"; rc=$?
    TPID=""
    out="$(cat "$CHK")"
    if { [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; } && [ $((SECONDS - t0)) -ge $((dl - 1)) ]; then
        TIMED_OUT=1
        out="${out:+$out$'\n'}check timed out after ${dl}s (deadline reached): the result is unknown"
    fi
    # pacman repeats this warning on every call when a repo in pacman.conf was never synced.
    # Hide the repeats (they bury real output) and report it once at the end instead.
    if printf '%s\n' "$out" | grep -qE "^warning: database file for .* does not exist"; then
        NOISE=$((NOISE + 1))
        out="$(printf '%s\n' "$out" | grep -vE "^warning: database file for .* does not exist")"
    fi
}

# _emit "desc" FUNCTION [tag] : write the full output of the last _exec to the report
_emit() {
    {
        echo
        echo "--- $1${3:+  [$3]}"
        [ "$FULL" -eq 1 ] && echo "\$ $2"
        [ -n "$out" ] && printf '%s\n' "$out"
        [ "$FULL" -eq 1 ] && echo "[exit code: $rc]"
    } >> "$RAW"
}

# _note "desc" "text" : a report entry without running anything (used for skipped checks)
_note() { { echo; echo "--- $1"; echo "$2"; } >> "$RAW"; }

# short reason for a failed check: the check's own WHYMSG, else the first line that looks like a problem
why() {
    local l
    if [ "$TIMED_OUT" -eq 1 ]; then printf 'timed out after %ss, result unknown' "$LAST_DL"; return; fi
    if [ -n "$WHYMSG" ]; then printf '%s' "$WHYMSG" | cut -c1-110; return; fi
    l="$(printf '%s\n' "$out" | grep -m1 -E "WARNING|CRITICAL|^LOW|^HIGH|MISSING|^LARGE|^OLD|^SLOW|^REVIEW|NOT |NO FIREWALL|FAILED|failed|missing|error|degraded|timed out" )"
    [ -n "$l" ] || l="$(printf '%s\n' "$out" | grep -m1 .)"
    printf '%s' "${l:-no output (exit code $rc)}" | cut -c1-110
}

# run "desc" c_fn : always show the output (information the script cannot judge by itself)
run() {
    _exec "$1" "$2"
    local tag=""
    WHYMSG=""
    if [ "$TIMED_OUT" -eq 1 ]; then
        tag="CHECK"
        if [ "$FULL" -eq 0 ]; then BAD+=("$1"); WHY+=("$(why)"); fi
    fi
    _emit "$1" "$2" "$tag"
}

# runq "desc" c_fn t_fn "ok message"
# t_fn is called with $out and $rc; it may set MSG / WHYMSG. Healthy = one OK line only.
# Needs attention = full output is kept and the check is listed in the summary.
runq() {
    _exec "$1" "$2"
    MSG=""; WHYMSG=""
    if [ "$FULL" -eq 0 ] && [ "$TIMED_OUT" -eq 0 ] && "$3"; then
        OK_N=$((OK_N + 1))
        { echo; echo "--- $1"; echo "OK: ${MSG:-$4}"; } >> "$RAW"
    else
        if [ "$FULL" -eq 1 ]; then
            _emit "$1" "$2" "$([ "$TIMED_OUT" -eq 1 ] && echo CHECK)"
        else
            BAD+=("$1"); WHY+=("$(why)")
            if [ "$SUMONLY" -eq 1 ]; then
                { echo; echo "--- $1  [CHECK]"; echo "$(why)"; } >> "$RAW"
            else
                _emit "$1" "$2" "CHECK"
            fi
        fi
    fi
}

# same, but as root (non-interactive, uses the cached sudo)
srun()  { if [ "$HAVE_SUDO" -eq 1 ]; then ROOT=1 run  "$@"; else _note "$1 (skipped, no sudo)" "SKIPPED: needs sudo"; fi; }
srunq() { if [ "$HAVE_SUDO" -eq 1 ]; then ROOT=1 runq "$@"; else _note "$1 (skipped, no sudo)" "SKIPPED: needs sudo"; fi; }

# netrunq: runq for checks that need the internet. Each gets up to DL_NET seconds, but all of them together
# at most NET_BUDGET (10 minutes by default): a slow link still works, a dead one cannot stall the report.
# With no default route they are skipped at once; NET_OFFLINE_OK=1 netrunq ... keeps a check that also
# works from cached data (it still counts against the budget).
netrunq() {
    local left=$((NET_BUDGET - NET_USED)) t0=$SECONDS d
    if [ "${NET_OFFLINE_OK:-0}" -ne 1 ] && ! net_up; then
        _note "$1 (skipped, offline)" "SKIPPED: no default route, so the internet is not reachable"
        return
    fi
    if [ "$left" -lt "$NET_MIN" ]; then
        _note "$1 (skipped, internet time used up)" "SKIPPED: all internet checks together may take ${NET_BUDGET}s at most, and that is used up"
        return
    fi
    d=$DL_NET; [ "$left" -lt "$d" ] && d=$left
    CHECK_DL="$d" runq "$@"
    NET_USED=$((NET_USED + SECONDS - t0))
}

# ---------- ready-made verdicts (t_*) ----------
t_empty()     { [ -z "$out" ]; }
t_none()      { [ "$out" = none ]; }
t_rc0()       { [ "$rc" -eq 0 ]; }
t_no_review() { ! grep -q "^REVIEW" <<<"$out"; }

# several output lines as one line: "a;b;c" -> "a, b, c"
join_lines() { printf '%s\n' "$1" | tr '\n' ';' | sed 's/;$//; s/;/, /g'; }

# =====================================================================================
# 7. KNOWN UPSTREAM ISSUE (detected once, used by several checks)
# =====================================================================================
# systemd 262 NvPCR units fail when the booted UKI carries no PCR public key
# (systemd#43848; fix proposed in systemd#43948). Harmless without TPM disk unlock/attestation.
# Detected only when EXACTLY those units failed and no PCR public key exists, so any other failure still shows.
KNOWN_TPM=0
_fl="$(systemctl --failed --plain --no-legend 2>/dev/null | awk '{print $1}')"
if [ -n "$_fl" ] && ! printf '%s\n' "$_fl" | grep -qvE '^(systemd-pcrlogin@[0-9]+\.service|systemd-pcrproduct\.service|systemd-tpm2-setup-early\.service)$' \
   && [ -z "$(systemctl --user --failed --plain --no-legend 2>/dev/null)" ] \
   && [ ! -e /run/systemd/tpm2-pcr-public-key.pem ] && [ ! -e /etc/systemd/tpm2-pcr-public-key.pem ]; then
    KNOWN_TPM=1
fi
if [ "$KNOWN_TPM" -eq 1 ]; then TPMFILT='NvPCR|Early TPM SRK Setup'; else TPMFILT='@@never-matches@@'; fi
THR0="$(cat /sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count 2>/dev/null || echo 0)"
export KNOWN_TPM TPMFILT THR0 BENIGN_RE
# sudo resets the environment, so hand the variables to root-run checks explicitly
SUDO_ENV="env $(printf '%q' "TPMFILT=$TPMFILT") $(printf '%q' "KNOWN_TPM=$KNOWN_TPM") $(printf '%q' "BENIGN_RE=$BENIGN_RE")"

# =====================================================================================
# 8. CHECK LIBRARY (grouped like the report below)
# =====================================================================================

# ---------- helpers shared by c_* functions ----------
# "1min 3.2s" / "850ms" -> seconds
h_tosec() {
    echo "$1" | awk '{ t=0; for (i=1; i<=NF; i++) { v=$i; if (v ~ /min$/) { sub(/min$/, "", v); t+=v*60 } else if (v ~ /ms$/) { sub(/ms$/, "", v); t+=v/1000 } else if (v ~ /us$/) { sub(/us$/, "", v); t+=v/1000000 } else if (v ~ /h$/) { sub(/h$/, "", v); t+=v*3600 } else if (v ~ /s$/) { sub(/s$/, "", v); t+=v } } printf "%.1f", t }'
}
# whole days since the last full system upgrade (-Syu) in pacman.log; prints nothing if unknown
h_days_since_upgrade() {
    local t s
    t=$(grep "starting full system upgrade" /var/log/pacman.log 2>/dev/null | tail -1 | cut -c2-25)
    [ -n "$t" ] || return 0
    s=$(date -d "$t" +%s 2>/dev/null) || return 0
    echo $(( ( $(date +%s) - s ) / 86400 ))
}
# "2026-11-20T10:00:00+0500" -> "2026-11-20 10:00 PKT (4 days ago)"
h_fmt_when() {
    [ -n "$1" ] || { echo "not found"; return; }
    echo "$(date -d "$1" "+%Y-%m-%d %H:%M %Z") ($(( ( $(date +%s) - $(date -d "$1" +%s) ) / 86400 )) days ago)"
}

# ---------- 1. OS, kernel, session ----------
c_os_kernel() {
    echo "$(. /etc/os-release; echo $PRETTY_NAME), kernel $(uname -r), uptime: $(uptime -p)"
    pacman -Q linux linux-lts linux-zen linux-hardened 2>/dev/null | tr "\n" ";"
    echo
}

c_session() {
    local dm
    echo "session=${XDG_SESSION_TYPE:-unset} desktop=${XDG_CURRENT_DESKTOP:-unset} wayland=${WAYLAND_DISPLAY:-unset}"
    echo "packages: $(pacman -Qq 2>/dev/null | grep -E "^(niri|quickshell|dms|dgop|matugen|greetd|xwayland-satellite)" | xargs -r pacman -Q 2>/dev/null | tr "\n" ";")"
    dm=$(systemctl list-units --type=service --state=active --no-legend 2>/dev/null | awk '$1 ~ /^(greetd|sddm|gdm|lightdm|lxdm|plasmalogin|ly)(@.*)?\.service$/ {print $1}' | tr "\n" " ")
    echo "display manager: ${dm:-none found}"
}

c_helper_tools() {
    local t c p
    for t in smartctl:smartmontools sensors:lm_sensors upower:upower checkupdates:pacman-contrib fwupdmgr:fwupd vainfo:libva-utils snapper:snapper btrfs:btrfs-progs lsusb:usbutils bluetoothctl:bluez-utils niri:niri powerprofilesctl:power-profiles-daemon nmcli:networkmanager; do
        c=${t%%:*}; p=${t##*:}
        command -v "$c" >/dev/null 2>&1 || echo "MISSING  $c   (sudo pacman -S $p)"
    done
}

c_kernel_installed() {
    local k
    k=$(uname -r)
    if [ -d "/usr/lib/modules/$k" ]; then
        echo "modules for $k present"
    else
        echo "REVIEW: modules for the running kernel ($k) are gone: it was upgraded since this boot. Reboot soon; until then USB, Wi-Fi, Bluetooth and new mounts may fail to load drivers"
    fi
}

c_install_dates() {
    pacman -Qi linux linux-lts systemd bluez bluez-utils linux-firmware linux-firmware-intel intel-ucode mesa networkmanager niri quickshell greetd power-profiles-daemon plymouth 2>/dev/null | grep -E "^(Name|Version|Install Date)" | paste - - -
}
c_cmdline() { cat /proc/cmdline; }

# ---------- 2. Niri, shell and greeter ----------
c_niri_version() {
    local i o c l
    i=$(pacman -Qq 2>/dev/null | grep -E "^niri(-git|-bin)?$" | xargs -r pacman -Q 2>/dev/null)
    echo "installed: ${i:-NOT INSTALLED}"
    if [ -z "$NIRI_SOCKET" ]; then
        echo "(not run from inside the niri session, so the running version cannot be compared)"
    else
        o=$(niri msg version 2>&1); echo "$o"
        c=$(echo "$o" | sed -n "s/^Compositor version: *//p")
        l=$(echo "$o" | sed -n "s/^CLI version: *//p")
        [ -n "$c" ] && [ -n "$l" ] && [ "$c" != "$l" ] && echo "REVIEW: the running compositor ($c) differs from the installed niri ($l): log out and back in to load the update"
    fi
    true
}
