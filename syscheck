    a=$(grep -a -o "LoaderInfo: systemd-boot [^ ]*" /usr/lib/systemd/boot/efi/systemd-bootx64.efi 2>/dev/null | head -1 | sed "s/LoaderInfo: //")
    b=$(grep -a -o "LoaderInfo: systemd-boot [^ ]*" "$esp/EFI/systemd/systemd-bootx64.efi" 2>/dev/null | head -1 | sed "s/LoaderInfo: //")
    echo "on the ESP: ${b:-unknown}; shipped by systemd: ${a:-unknown}; systemd-boot-update.service: $(systemctl is-enabled systemd-boot-update.service 2>&1)"
    [ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ] && echo "REVIEW: the ESP loader differs from the one systemd ships. Update it with: sudo bootctl update (or enable systemd-boot-update.service to do it every boot; the Arch Wiki documents both)"
