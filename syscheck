# ---------- 3. Boot time ----------
c_boot_time() {
    local o h f l
    o=$(systemd-analyze | head -2); echo "$o"
    h=$(echo "$o" | head -1)
    f=$(h_tosec "$(echo "$h" | sed -nE "s/.*( in | \+ )([^+]*) \(firmware\).*/\2/p")")
    l=$(h_tosec "$(echo "$h" | sed -nE "s/.*( in | \+ )([^+]*) \(loader\).*/\2/p")")
    awk -v f="${f:-0}" -v l="${l:-0}" 'BEGIN{ if (f>10) print "SLOW firmware phase (>10s): look at BIOS Fast Boot / POST settings"; if (l>3.5) print "SLOW loader phase (>3.5s): check UKI size on the ESP, loader.conf timeout, TPM measurement of the UKI" }'
}
t_boot_time() { MSG="$(head -1 <<<"$out" | sed "s/^Startup finished in //")"; grep -q "^Startup finished" <<<"$out" && ! grep -q "^SLOW" <<<"$out"; }

c_slow_units() {
    local cc l u
    cc=$(systemd-analyze critical-chain --no-pager 2>/dev/null)
    systemd-analyze blame --no-pager | grep -E "^ *[0-9.]+(s|min) " | head -8 | while read -r l; do
        u=${l##* }
        if echo "$cc" | grep -qF -- "$u"; then echo "$l   [on the critical path: delays boot]"; else echo "$l   [runs in parallel: does not delay boot]"; fi
    done
}
t_slow_units() {
    if [ -z "$out" ]; then MSG="no unit slower than 1s"; return 0; fi
    MSG="$(wc -l <<<"$out") unit(s) over 1s, none on the critical path (parallel)"
    ! grep -q "on the critical path" <<<"$out"
}

c_bootloader()  { bootctl status 2>&1 | grep -E "Secure Boot:|TPM2 Support:|Product:|Current Entry:|Default Entry:" | sort -u; }
c_loader_conf() { cat "$(bootctl --print-esp-path 2>/dev/null)/loader/loader.conf" 2>&1; }

c_esp() {
    local esp p
    esp=$(bootctl --print-esp-path 2>/dev/null)
    echo "ESP at $esp: $(df -h --output=used,size,pcent "$esp" | tail -1)"
    ls -lh "$esp/EFI/Linux/" 2>&1 | tail -n +2 | awk '{print $5, $6, $7, $8, $9}'
    p=$(df --output=pcent "$esp" | tail -1 | tr -dc 0-9)
    [ "${p:-0}" -ge 80 ] && echo "LOW SPACE on the ESP: old UKIs or fallbacks may need cleaning"
