# summary at the top of the report
{
    if [ "$FULL" -eq 1 ]; then
        echo "SUMMARY: full mode, nothing was condensed. Read each section."
    elif [ "${#BAD[@]}" -eq 0 ]; then
        echo "SUMMARY: all $OK_N automatic checks passed. Nothing needs attention."
    else
        if [ "$SUMONLY" -eq 1 ]; then echo "SUMMARY: $OK_N checks passed, ${#BAD[@]} need attention (run without --summary for their details):"
