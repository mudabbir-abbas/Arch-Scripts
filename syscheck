# ---------- 4. Shutdown time (estimated) ----------
c_stop_timeouts() {
    journalctl -b -1 --no-pager | grep -E "State .(stop-sigterm|stop-sigkill|stop-watchdog). timed out|stop job is running|Failed with result .timeout.|Killing\." | cut -c1-200 || true
}
c_shutdown_pauses() { # START_TS comes from the environment
    local r
    r=$(journalctl -b -1 -o short-unix --no-pager | awk -v s="$START_TS" '$1+0>=s+0 { if (pt!="" && $1-pt>=5) printf "%d s pause\n   before: %s\n   after:  %s\n", $1-pt, substr(pl,1,150), substr($0,1,150); pt=$1; pl=$0 }' | head -12)
    if [ -n "$r" ]; then echo "$r"; else echo "(no pause of 5 s or more found)"; fi
}

# systemd has no direct shutdown-duration metric. Estimate: first shutdown-ish
# line in the previous boot's journal -> last line written.
shutdown_section() {
    local PREV_LOG PREV_RC END_TS DUR
    SHUT_BAD=0; START_TS=""
    if [ "$IS_TTY" -eq 1 ]; then
        printf '\r\033[K%s[%2d/%d]%s %s %s> Reading previous boot journal%s' "$C_DIM" "$CUR_N" "$TOTAL" "$C_OFF" "$CUR_TITLE" "$C_DIM" "$C_OFF"
    fi
    # same pattern as _exec: output goes to a file (a straggler cannot hold a pipe open) and we wait in the
    # background, so the deadline holds and Ctrl+C works at once
    timeout -k 5 "$DL_SLOW" journalctl -b -1 -o short-unix --no-pager < /dev/null > "$CHK" 2>/dev/null &
    TPID=$!
    wait "$TPID"; PREV_RC=$?
    TPID=""
    PREV_LOG="$(cat "$CHK")"
    if [ "$PREV_RC" -eq 124 ] || [ "$PREV_RC" -eq 137 ]; then
        [ "$FULL" -eq 0 ] && { BAD+=("Shutdown duration"); WHY+=("timed out after ${DL_SLOW}s reading the previous boot journal, result unknown"); }
        printf '\n--- Shutdown duration  [CHECK]\nTimed out after %ss while reading the previous boot journal: the shutdown time and stop-timeout checks were skipped.\n' "$DL_SLOW" >> "$RAW"
        return
    fi
    if [ -z "$PREV_LOG" ]; then
        printf '\n--- Shutdown duration\nNo previous boot in journal (journal may not be persistent).\n' >> "$RAW"
        return
    fi
    START_TS="$(echo "$PREV_LOG" | grep -E "Stopped target (Graphical|Multi-User)|Starting systemd-poweroff|Starting systemd-reboot|Shutting down|System is (powering off|rebooting)" | head -1 | awk '{print $1}')"
    END_TS="$(echo "$PREV_LOG" | tail -1 | awk '{print $1}')"
    DUR=""
    if [ -n "$START_TS" ] && [ -n "$END_TS" ]; then DUR="$(awk -v s="$START_TS" -v e="$END_TS" 'BEGIN{printf "%d", e-s}')"; fi
    if [ -z "$DUR" ]; then
        printf '\n--- Shutdown duration\nCould not determine the shutdown window from the previous boot.\n' >> "$RAW"
    elif [ "$DUR" -lt 2 ]; then
        printf '\n--- Shutdown duration\nCould not measure: the window found in the previous boot is only %ss, which cannot be real\n(the journal lacks the early "Stopped target" lines, or the boot ended abruptly). Last lines of that boot:\n' "$DUR" >> "$RAW"
        journalctl -b -1 --no-pager -n 8 -o short 2>/dev/null | cut -c1-200 >> "$RAW"
    elif [ "$DUR" -le 20 ] && [ "$FULL" -eq 0 ]; then
        OK_N=$((OK_N + 1))
        printf '\n--- Shutdown duration\nOK: the previous shutdown took about %ss (healthy is under ~15s)\n' "$DUR" >> "$RAW"
    else
        SHUT_BAD=1
        if [ "$DUR" -gt 20 ] && [ "$FULL" -eq 0 ]; then BAD+=("Shutdown duration"); WHY+=("took about ${DUR}s (healthy is under ~15s)"); fi
        printf '\n--- Shutdown duration%s\nEstimated: %ss (under ~10-15s is healthy; much longer usually means a stop job timed out)\n' "$([ "$DUR" -gt 20 ] && [ "$FULL" -eq 0 ] && echo '  [CHECK]')" "$DUR" >> "$RAW"
    fi
    CHECK_DL=$DL_SLOW runq "Units that hit the stop timeout last shutdown" c_stop_timeouts t_empty "no unit hit its stop timeout"
    if { [ "$SHUT_BAD" -eq 1 ] || [ -n "$out" ]; } && [ "$SUMONLY" -eq 0 ] && [ -n "$START_TS" ]; then
        export START_TS
        CHECK_DL=$DL_SLOW run "Longest pauses during the previous shutdown (5 s or more; the line BEFORE a pause is what was being waited for)" c_shutdown_pauses
    fi
}

# ---------- 5. Services and errors ----------
c_system_state() { systemctl is-system-running; }
t_system_state() {
    if [ "$out" = degraded ] && [ "$KNOWN_TPM" -eq 1 ]; then MSG="degraded, only because of the known systemd-262 NvPCR units (systemd#43848)"; return 0; fi
    [ "$out" = running ]
}

c_failed_units() {
    systemctl --failed --plain --no-legend 2>&1
    systemctl --user --failed --plain --no-legend 2>&1 | sed "s/^/(user) /"
}
t_failed_units() {
    [ -z "$out" ] && return 0
    if [ "$KNOWN_TPM" -eq 1 ]; then
        MSG="only the 3 known systemd-262 NvPCR units failed (upstream bug systemd#43848: UKI has no PCR public key; harmless without TPM disk unlock; fix proposed in systemd#43948, so watch for a systemd update; optional interim: mask them)"
        return 0
    fi
    return 1
}

c_failed_why() {
    local u
    for u in $(systemctl --failed --plain --no-legend 2>/dev/null | awk '{print $1}' | head -8); do
        echo "== $u"; journalctl -u "$u" -b -n 4 --no-pager -o cat 2>&1 | cut -c1-200
    done
    for u in $(systemctl --user --failed --plain --no-legend 2>/dev/null | awk '{print $1}' | head -5); do
        echo "== (user) $u"; journalctl --user -u "$u" -b -n 4 --no-pager -o cat 2>&1 | cut -c1-200
    done
}

c_tpm_status() {
    echo "tpm devices: $(ls /sys/class/tpm 2>&1 | tr "\n" " ")"
    echo "tpm major version: $(cat /sys/class/tpm/tpm0/tpm_version_major 2>&1)"
    systemd-analyze has-tpm2 2>&1 | head -12
    echo "--- nvpcr definitions shipped:"; ls /usr/lib/nvpcr/ /etc/nvpcr/ 2>&1
    echo "--- packages:"; pacman -Q tpm2-tss systemd 2>&1 | grep -v ^warning
}
c_tpm_dmesg() { dmesg | grep -iE "tpm|tcg" | head -15; }

c_dbus_activation() {
    local b l e s
    for b in 0 -1; do
        l=$(journalctl -b $b -p 3 --no-pager 2>/dev/null | grep -E "Activation request for" | cut -c1-160)
        e=$(journalctl -b $b -n 1 -o short-unix --no-pager -q 2>/dev/null | cut -d. -f1)
        if [ "$b" = -1 ] && [ -n "$e" ]; then
            # nm_dispatcher refused in the last 2 minutes of the previous boot = shutdown, not a fault
            s=$(journalctl -b $b -p 3 --since "@$((e - 120))" --no-pager 2>/dev/null | grep -E "Activation request for .org.freedesktop.nm_dispatcher" | cut -c1-160)
            [ -n "$s" ] && l=$(printf "%s\n" "$l" | grep -vxFf <(printf "%s\n" "$s"))
        fi
        systemctl is-enabled --quiet bluetooth 2>/dev/null || l=$(echo "$l" | grep -v "org.bluez")
        l=$(echo "$l" | head -6)
        [ -n "$l" ] && { echo "boot $b:"; echo "$l"; }
    done
    true
}

c_errors_boot() {
    journalctl -p 3 -b --no-pager -o short | grep -vE "^-- " | grep -vE "$BENIGN_RE" | grep -vE "$TPMFILT" | cut -c1-220 | tail -25
}
c_errors_kernel() {
    dmesg --level=err,crit,alert,emerg | grep -vE "$BENIGN_RE" | grep -vE "$TPMFILT" | tail -25
}

c_coredumps() {
    local bs n o
    bs=$(date -d "-$(cut -d. -f1 /proc/uptime) seconds" "+%Y-%m-%d %H:%M:%S")
    n=$(coredumpctl list --no-pager --no-legend --since "$bs" 2>/dev/null | grep -c .)
    if [ "$n" -gt 0 ]; then
        echo "$n crash(es) since this boot started:"
        coredumpctl list --no-pager --no-legend --since "$bs" 2>/dev/null | tail -6
    fi
    o=$(coredumpctl list --no-pager --no-legend --since "7 days ago" --until "$bs" 2>/dev/null | grep .)
    if [ -n "$o" ]; then
        echo "$(echo "$o" | wc -l) earlier crash(es) in the last 7 days (before this boot), newest 4:"
        echo "$o" | tail -4
    fi
    true
}
t_coredumps() {
    grep -q "since this boot started" <<<"$out" && return 1
    [ -n "$out" ] && MSG="none this boot; $(head -1 <<<"$out" | cut -d" " -f1) earlier crash(es) in the last 7 days (run --full to list them)"
    return 0
}
c_newest_crash() {
    local p
    p=$(coredumpctl list --no-pager --no-legend 2>/dev/null | tail -1 | awk '{for(i=1;i<=NF;i++) if($i ~ /^SIG/){print $(i-3); exit}}')
    if [ -n "$p" ]; then
        coredumpctl info --no-pager "$p" 2>&1 | grep -E "Timestamp|Command Line|Signal|Package|Message|^ +#[0-9]+ " | cut -c1-180 | head -20
    else
        echo "could not read the newest crash entry"
    fi
}

# Known fault signatures per boot, plus boots that did not end cleanly (clean_end=NO).
c_boot_problems() {
    local b j wf ga i2 bh bs tp ce
    for b in 0 -1 -2 -3 -4 -5 -6 -7; do
        j=$(journalctl -b $b --no-pager 2>/dev/null); [ -z "$j" ] && continue
        wf=$(echo "$j" | grep -cE "iwlwifi.*(SW reset|Microcode SW error)")
        ga=$(echo "$j" | grep -c "Atomic update failure")
        i2=$(echo "$j" | grep -c "i2c_designware.*timed out")
        bh=$(echo "$j" | grep -E "Bluetooth: hci[0-9]+: .*(failed|tx timeout)" | grep -vcF "Reading supported features failed (-16)")
        bs=$(echo "$j" | grep -cE "bluetooth.service: .*timed out")
        tp=$(echo "$j" | grep -c "Failed to start Early TPM SRK Setup"); [ "$KNOWN_TPM" = 1 ] && tp=0
        ce=$(echo "$j" | tail -40 | grep -qE "Journal stopped|Unmounted /|Reached target .*(Shutdown|Power-Off|Reboot)|systemd-shutdown" && echo yes || echo NO)
        if [ $((wf+ga+i2+bh+bs+tp)) -gt 0 ] || { [ "$b" != 0 ] && [ "$ce" = NO ]; }; then
            echo "boot $b: wifi_fw_crash=$wf i915_atomic_err=$ga i2c_timeout=$i2 bt_hci_err=$bh bt_stop_timeout=$bs tpm_fail=$tp clean_end=$ce"
            echo "   started: $(echo "$j" | grep -m1 -vE "^-- " | cut -c1-15)   last line: $(echo "$j" | tail -1 | cut -c1-120)"
        fi
    done
}

# Error messages seen in 2+ of the last 7 boots. Digits become "#" so that times and ids do not hide repeats.
c_recurring_errors() {
    local n=0 tmp b res
    tmp=$(mktemp)
    for b in 0 -1 -2 -3 -4 -5 -6; do
        journalctl -b $b -n 1 --no-pager -q >/dev/null 2>&1 || continue
        n=$((n+1))
        journalctl -b $b -p 3 --no-pager -o short 2>/dev/null \
            | sed -E "s/^[A-Z][a-z]{2} +[0-9]+ [0-9:]{8} [^ ]+ //; s/\[[0-9]+\]//g; s/0x[0-9a-fA-F]+/0xN/g; s/[0-9]+/#/g" \
            | grep -vE "^[[:space:]]|^--|^$" \
            | grep -vE "$BENIGN_RE|Activation request for .org.freedesktop.nm_dispatcher" \
            | grep -vE "$TPMFILT" | cut -c1-170 | sort -u | awk -v b=$b '{print b "@@" $0}' >> "$tmp"
    done
    res=$(awk -F"@@" '{c[$2]++; if ($1==0) now[$2]=1} END{for (k in c) if (c[k]>=2) printf "%d %s %s\n", c[k], (now[k] ? "[now] " : "[gone]"), k}' "$tmp" | sort -rn | head -14)
    rm -f "$tmp"
    if [ -n "$res" ]; then
        echo "boots analysed: $n (count = boots it appeared in; [now] = also in this boot, [gone] = absent this boot; digits shown as #)"
        echo "$res"
    fi
}
t_recurring_errors() {
    [ -z "$out" ] && return 0
    grep -q "\[now\]" <<<"$out" && return 1
    MSG="only history: $(grep -c "\[gone\]" <<<"$out") message(s) recurred in earlier boots but are absent this boot (fixed?); run --full to list them"
    return 0
}

# ---------- 6. CPU, thermals, throttling ----------
c_cpu() {
    local c=/sys/devices/system/cpu/cpu0/cpufreq pl1 pl2
    pl1=$(( $(cat /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw 2>/dev/null || echo 0) / 1000000 ))
    pl2=$(( $(cat /sys/class/powercap/intel-rapl:0/constraint_1_power_limit_uw 2>/dev/null || echo 0) / 1000000 ))
    lscpu | sed -n "s/^Model name: *//p"
    echo "governor/driver: $(cat $c/scaling_governor 2>&1) / $(cat $c/scaling_driver 2>&1)"
    echo "power profile: $(powerprofilesctl get 2>/dev/null || echo none)"
    echo "PL1/PL2: ${pl1}W / ${pl2}W"
    awk '/cpu MHz/{s+=$4; if(min==""||$4<min)min=$4; if($4>max)max=$4; n++} END{if(n) printf "%d threads, MHz min %d / avg %d / max %d\n", n, min, s/n, max}' /proc/cpuinfo
    echo "limits kHz: min $(cat $c/scaling_min_freq 2>&1) / max $(cat $c/scaling_max_freq 2>&1) (hardware max $(cat $c/cpuinfo_max_freq 2>&1)); no_turbo=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>&1); EPP=$(cat $c/energy_performance_preference 2>&1)"
    echo "AC online: $(cat /sys/class/power_supply/A*/online 2>/dev/null | head -1) (1 = plugged in); an idle snapshot shows idle clocks, re-run during load to judge speed"
}

c_ucode() {
    pacman -Q intel-ucode 2>&1 | grep -v "^warning"
    journalctl -k -b --no-pager | grep -i "microcode: Current revision" | cut -c1-120
}
t_ucode() { grep -q "Current revision" <<<"$out" && ! grep -q "was not found" <<<"$out"; }

c_temps() { sensors 2>/dev/null | grep -E "Package id 0|Composite|^fan1"; }
t_temps() {
    local t
    t=$(grep -oE "Package id 0: +\+[0-9]+" <<<"$out" | grep -oE "[0-9]+$")
    MSG="CPU package ${t}C"
    [ -n "$t" ] && [ "$t" -lt 85 ]
}
c_temps_sysfs() {
    local z
    for z in /sys/class/thermal/thermal_zone*; do echo "$(cat $z/type): $(( $(cat $z/temp) / 1000 ))C"; done
}

c_throttling() {
    local t=/sys/devices/system/cpu/cpu0/thermal_throttle p
    p=$(cat $t/package_throttle_count 2>/dev/null || echo 0)
    echo "package_throttle_count=$p core_throttle_count=$(cat $t/core_throttle_count 2>/dev/null || echo 0) package_power_limit_count=$(cat $t/package_power_limit_count 2>/dev/null || echo n/a) since boot ($(awk '{printf "%.1f", $1/3600}' /proc/uptime) h up)"
    echo "during this report: +$((p - ${THR0:-$p}))"
    journalctl -k -b --no-pager | grep -iE "throttl|PROCHOT" | grep -v e1000e | tail -5
}
t_throttling() {
    local d
    d=$(sed -n "s/^during this report: +//p" <<<"$out")
    MSG="$(head -1 <<<"$out"); none during this report"
    [ "${d:-0}" -eq 0 ] && ! grep -qE "^[A-Z][a-z]{2} +[0-9]+ [0-9:]{8} " <<<"$out"
}
c_top_cpu() { ps -eo pid,comm,%cpu,%mem --sort=-%cpu | grep -v " ps " | head -8; }

