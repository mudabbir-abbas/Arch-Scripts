#!/usr/bin/env bash
# DESC: Install My Scripts: move updated scripts (and marked plain files like PLANS.md) from ~/Downloads to ~/.local/bin
# ims - Install My Scripts: move updated scripts from ~/Downloads to ~/.local/bin
#
# NEW IN THIS VERSION (2.4.0):
#   - New: install a file from anywhere, not only ~/Downloads. An argument that contains a
#     slash is a path to the file itself: 'ims ~/code/foo.py' installs it as 'foo' (the known
#     extension is dropped for a new script, like 'ims foo.py' does; --keep-ext keeps it).
#     Like Downloads files it is moved, with a backup of the file it replaces; -c/--copy
#     keeps the original, -n/--dry-run shows what would happen.
#   - Before, 'ims some/dir/foo' silently ignored the folder and looked for foo in ~/Downloads;
#     it now installs the file you named.
#   - The fish completion now completes ordinary paths when the word you are typing starts
#     with ~ . or / or already contains a slash. Reinstall it: ims completions --install
#   - The 2.3.0 entry is replaced by this one.
VERSION="2.4.0"
NAME="ims"

set -uo pipefail
shopt -s nullglob

BIN_DIR="${IMS_BIN_DIR:-$HOME/.local/bin}"
DL_DIR="${IMS_DL_DIR:-$HOME/Downloads}"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ims/backups"
KEEP_BACKUPS=3
KNOWN_EXT="sh|bash|zsh|fish|py|pl|rb|js|lua"
MARKER="ims-managed"

if [[ -t 1 ]]; then
    G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; D=$'\e[2m'; B=$'\e[1m'; X=$'\e[0m'
else
    G=""; Y=""; R=""; D=""; B=""; X=""
fi

ok()   { printf '%s\n' "${G}✓${X} $*"; }
note() { printf '%s\n' "${D}·${X} $*"; }
warn() { printf '%s\n' "${Y}!${X} $*" >&2; }
err()  { printf '%s\n' "${R}✗${X} $*" >&2; }

usage() {
    cat <<EOF
${B}$NAME v$VERSION${X} - Install My Scripts

Moves scripts from ~/Downloads into ~/.local/bin, replacing the old copy
and running chmod +x on it. Plain files (PLANS.md, ...) are handled too.

Usage:
  $NAME                    Update every script in ~/.local/bin that has a
                         matching file in ~/Downloads (plain files only
                         when the Downloads copy has the "$MARKER" marker)
  $NAME <scriptname>       Only look for <scriptname> in ~/Downloads
                         (new scripts install without .sh/.py etc.)
                         Also the way to install a plain file: $NAME PLANS.md
  $NAME <path/to/file>     Install a file from anywhere (any argument with a slash):
                         $NAME ~/code/foo.py installs it as "foo". Moved, like
                         Downloads files; add -c to keep the original
  $NAME list               List scripts in ~/.local/bin with version, date
                         and any update waiting in ~/Downloads
                         (-a/--all also shows non-script files)
  $NAME restore <name>     Roll back <name> to its latest backup
                         (run again to toggle back)
  $NAME completions        Print the fish tab-completion script
  $NAME completions --install
                         Install it as ~/.config/fish/completions/$NAME.fish
                         ($NAME <Tab> then lists the files in ~/Downloads)
  $NAME -h, --help         Show this help
  $NAME -v, --version      Show version

Options:
  -a, --all              With list: include non-script files too
  -n, --dry-run          Show what would happen, change nothing
  -c, --copy             Copy instead of move (keep file in ~/Downloads)
      --no-backup        Don't back up the file being replaced
      --keep-ext         Keep the extension when installing a NEW script
                         by name (default: "$NAME foo.sh" installs as "foo")
      --install          With completions: write the file instead of printing it

Matching:
  A Downloads file matches script "foo" if it is named foo, or foo.<ext>
  where <ext> is one of: ${KNOWN_EXT//|/ }.
  A browser duplicate suffix such as "foo (1).sh" is fine. The newest
  match wins. Identical files are skipped; .part/.crdownload are ignored.

Scripts:
  Only files that start with #! or have a known extension are scripts.

Plain files (PLANS.md, notes, ...):
  Installed like scripts, but never made executable. Plain "$NAME" replaces
  an existing plain file only if the copy in ~/Downloads contains
  "$MARKER" in its first 20 lines, e.g.  <!-- $MARKER -->
  Without the marker it is skipped with a note. "$NAME PLANS.md" (naming
  the file) skips the marker check. Other files in ~/.local/bin
  (binaries, ...) are left alone.

Tab completion (fish):
  After "$NAME completions --install", "$NAME <Tab>" offers every file in
  ~/Downloads, the subcommands and the scripts already installed;
  "$NAME restore <Tab>" offers the scripts that have a backup.
  "completions" is a reserved word, like "list" and "restore".

Notes:
  $NAME can safely update itself (installs are atomic renames).
  Backups: $BACKUP_DIR (last $KEEP_BACKUPS per file)
  Env:     IMS_BIN_DIR, IMS_DL_DIR override the default directories.
EOF
}

get_ver() {
    local v
    v=$(grep -m1 -E '^[[:space:]]*(readonly[[:space:]]+)?VERSION=' "$1" 2>/dev/null) || { printf '%s' "-"; return; }
    v=${v#*=}; v=${v//[\"\']/}; v=${v%%[[:space:]#]*}
    printf '%s' "${v:--}"
}

# is_script <path> -> 0 if it starts with a shebang or has a known script extension
is_script() {
    local ext
    [[ $(head -c2 -- "$1" 2>/dev/null) == "#!" ]] && return 0
    if [[ ${1##*/} == *.* ]]; then
        ext=${1##*.}
        [[ ${ext,,} =~ ^($KNOWN_EXT)$ ]] && return 0
    fi
    return 1
}

# has_marker <file> -> 0 if the file carries the ownership marker in its first 20 lines
has_marker() {
    head -n 20 -- "$1" 2>/dev/null | grep -qaF -- "$MARKER"
}

# matches_name <file> <scriptname>  -> 0 if the Downloads file is a candidate for that script
matches_name() {
    local b=${1##*/} n=$2 stem ext
    local re_dup='^(.*[^ ])[ ]?\([0-9]+\)(\.[^.]+)?$'
    [[ $b == *.part || $b == *.crdownload ]] && return 1
    [[ $b == "$n" ]] && return 0
    if [[ $b =~ $re_dup ]]; then
        b="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
        [[ $b == "$n" ]] && return 0
    fi
    if [[ $b == *.* ]]; then
        stem=${b%.*}; ext=${b##*.}
        if [[ ${ext,,} =~ ^($KNOWN_EXT)$ && $stem == "$n" ]]; then return 0; fi
    fi
    return 1
}

# find_match <scriptname> -> prints newest matching file in Downloads (or nothing)
find_match() {
    local f best=""
    for f in "$DL_DIR"/*; do
        [[ -f $f ]] || continue
        matches_name "$f" "$1" || continue
        if [[ -z $best || $f -nt $best ]]; then best=$f; fi
    done
    printf '%s' "$best"
}

# list_backups <name> -> fills BK with the backups of that file, oldest first.
# A backup is <name>.YYYYMMDD-HHMMSS, or <name>.YYYYMMDD-HHMMSS-NN when several were made in
# the same second. Only names of exactly that form count (so foo.sh.<stamp> or foo.<stamp>.bak
# are not foo's backups), and the order is fixed by sorting in the C locale, not by the glob.
BK=()
list_backups() {
    local f s found=()
    BK=()
    for f in "$BACKUP_DIR/$1".*; do
        s=${f##*/}; s=${s#"$1".}
        if [[ $s =~ ^[0-9]{8}-[0-9]{6}(-[0-9]{2})?$ ]]; then found+=("$f"); fi
    done
    if ((${#found[@]})); then
        mapfile -t BK < <(printf '%s\n' "${found[@]}" | LC_ALL=C sort)
    fi
}

backup_file() {   # backup_file <path> <name>
    mkdir -p "$BACKUP_DIR" || return 1
    local stamp target f s k last=-1
    stamp=$(date +%Y%m%d-%H%M%S)
    # A backup from this same second may exist already. Number the new one after the highest
    # number used in that second (-01, -02, ...). Simply testing whether the plain name exists is
    # not enough: pruning may already have removed it, and a new plain name would sort before
    # the numbered ones and be pruned at once.
    list_backups "$2"
    for f in ${BK[@]+"${BK[@]}"}; do
        s=${f##*/}; s=${s#"$2".}
        if [[ $s == "$stamp" ]]; then
            if ((last < 0)); then last=0; fi
        elif [[ $s == "$stamp"-* ]]; then
            k=$((10#${s##*-}))
            if ((k > last)); then last=$k; fi
        fi
    done
    if ((last < 0)); then
        target="$BACKUP_DIR/$2.$stamp"
    else
        last=$((last+1))
        if ((last > 99)); then warn "$2: too many backups within one second"; return 1; fi
        printf -v target '%s/%s.%s-%02d' "$BACKUP_DIR" "$2" "$stamp" "$last"
    fi
    cp -p -- "$1" "$target" || return 1
    # prune: the oldest backups come first (the name carries the timestamp; file dates are not
    # reliable because cp -p keeps them)
    list_backups "$2"
    if ((${#BK[@]} > KEEP_BACKUPS)); then
        rm -f -- "${BK[@]:0:${#BK[@]}-KEEP_BACKUPS}"
    fi
    return 0
}

# atomic_put <src> <dest> [plain 0|1]: stage next to dest, set the mode (chmod +x for
# scripts, 644 for plain files), then rename over it. A running script (e.g. ims updating
# itself) keeps its old inode, so it is never corrupted mid-run.
atomic_put() {
    local tmp plain=${3:-0}
    tmp=$(mktemp "$(dirname -- "$2")/.ims.XXXXXX") || return 1
    if cp -p -- "$1" "$tmp" && { if ((plain)); then chmod 644 -- "$tmp"; else chmod +x -- "$tmp"; fi; } \
        && mv -f -- "$tmp" "$2"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

INSTALLED=0; UNCHANGED=0; FAILED=0; WOULD=0

install_one() {   # install_one <src> <name>
    local src=$1 name=$2 dest="$BIN_DIR/$2" old_v new_v label verb plain=0
    new_v=$(get_ver "$src")
    if ! is_script "$src" && ! is_script "$dest"; then plain=1; fi

    if [[ -e $dest ]]; then
        if cmp -s -- "$src" "$dest"; then
            note "$name: unchanged (${src##*/} is identical)"
            ((UNCHANGED++)); return
        fi
        old_v=$(get_ver "$dest")
        if ((plain)); then label="$name  (plain file)"; else label="$name  ${old_v} → ${new_v}"; fi
        verb="replace"
    else
        if ((plain)); then label="$name  (new, plain file)"; else label="$name  (new, ${new_v})"; fi
        verb="install"
    fi

    if ((DRY)); then
        note "would $verb: ${src##*/} → $dest   [$label]"
        ((WOULD++))
        return
    fi

    mkdir -p -- "$BIN_DIR" || { err "cannot create $BIN_DIR"; ((FAILED++)); return; }

    if [[ -e $dest && $BACKUP -eq 1 ]]; then
        backup_file "$dest" "$name" || warn "$name: backup failed, continuing"
    fi

    local self=0
    [[ $dest -ef ${BASH_SOURCE[0]} ]] && self=1

    atomic_put "$src" "$dest" "$plain" || { err "$name: failed to write $dest"; ((FAILED++)); return; }
    ((COPY)) || rm -f -- "$src" || warn "$name: installed, but could not remove ${src##*/}"

    ok "$label   ${D}(from ${src##*/})${X}"
    ((self)) && note "$NAME updated itself; the new version applies on the next run"
    if ((!plain)); then
        [[ $(head -c2 -- "$dest") == "#!" ]] || warn "$name: no shebang on first line"
    fi
    ((INSTALLED++))
}

summary() {
    local s
    if ((DRY)); then s="$WOULD would be installed/updated (dry run)"
    else s="$INSTALLED installed/updated"; fi
    ((UNCHANGED)) && s+=", $UNCHANGED unchanged"
    ((FAILED))    && s+=", $FAILED failed"
    printf '%s\n' "${D}$s${X}"
}

cmd_default() {
    [[ -d $DL_DIR ]] || { err "$DL_DIR does not exist"; return 1; }
    [[ -d $BIN_DIR ]] || { err "$BIN_DIR does not exist"; return 1; }
    local f name src found=0
    for f in "$BIN_DIR"/*; do
        [[ -f $f ]] || continue
        name=${f##*/}
        src=$(find_match "$name")
        [[ -n $src ]] || continue
        if ! is_script "$f"; then
            # plain file: only with the ownership marker (naming it explicitly skips this check)
            cmp -s -- "$src" "$f" && continue
            if ! has_marker "$src"; then
                note "$name: ${src##*/} in $DL_DIR has no '$MARKER' marker, skipped (install it with: $NAME $name)"
                continue
            fi
        fi
        found=1
        install_one "$src" "$name"
    done
    if ((found)); then summary; else note "No matching files in $DL_DIR for scripts in $BIN_DIR"; fi
    ((FAILED == 0))
}

# install_name <filename> -> prints the name a new file is installed under: an installed
# script of that name wins; otherwise a known extension is dropped (unless --keep-ext)
install_name() {
    local name=$1 target=$1 ext
    if [[ ! -e $BIN_DIR/$target && $name == *.* ]]; then
        ext=${name##*.}
        if [[ ${ext,,} =~ ^($KNOWN_EXT)$ ]] && { [[ -e $BIN_DIR/${name%.*} ]] || ((!KEEP_EXT)); }; then
            target=${name%.*}
        fi
    fi
    printf '%s' "$target"
}

cmd_named() {
    local name=$1 target src
    [[ -d $DL_DIR ]] || { err "$DL_DIR does not exist"; return 1; }
    # "ims foo.sh": use the installed name if it exists; otherwise drop the
    # known extension for a new install (unless --keep-ext)
    target=$(install_name "$name")
    src=$(find_match "$target")
    if [[ -z $src && $target != "$name" ]]; then src=$(find_match "$name"); fi
    if [[ -z $src ]]; then
        err "No file matching '$name' found in $DL_DIR"
        return 1
    fi
    install_one "$src" "$target"
    summary
    ((FAILED == 0))
}

# "ims ~/code/foo.py": the argument is the file itself, wherever it is
cmd_path() {
    local src=$1 name target
    [[ $src == '~/'* ]] && src="$HOME/${src#'~/'}"   # a quoted ~ is not expanded by the shell
    if [[ ! -e $src ]]; then err "No such file: $src"; return 1; fi
    if [[ ! -f $src ]]; then err "Not a regular file: $src"; return 1; fi
    name=${src##*/}
    target=$(install_name "$name")
    if [[ $src -ef $BIN_DIR/$target ]]; then
        err "$src is already the installed file"
        return 1
    fi
    install_one "$src" "$target"
    summary
    ((FAILED == 0))
}

cmd_list() {
    [[ -d $BIN_DIR ]] || { err "$BIN_DIR does not exist"; return 1; }
    local f name src n=0 hidden=0 flags pending isscript
    printf '%s\n' "${B}$(printf '%-30s %-10s %-11s %s' NAME VERSION MODIFIED NOTES)${X}"
    for f in "$BIN_DIR"/*; do
        [[ -f $f || -L $f ]] || continue
        name=${f##*/}; flags=""
        src=$(find_match "$name")
        isscript=0; is_script "$f" && isscript=1
        pending=0
        if [[ -n $src ]] && ! cmp -s -- "$src" "$f"; then pending=1; fi
        if ((!isscript)) && ! ((ALL)); then
            # a plain file is listed without --all only when a marked update is waiting
            if ! ((pending)) || ! has_marker "$src"; then ((hidden++)); continue; fi
        fi
        if ((isscript)) && [[ ! -x $f ]]; then flags+="not-executable "; fi
        if ((pending)); then
            if ((isscript)) || has_marker "$src"; then
                flags+="${Y}update in Downloads (${src##*/})${X}"
            else
                flags+="${Y}in Downloads without '$MARKER' marker (${src##*/}); install with: $NAME $name${X}"
            fi
        fi
        printf '%-30s %-10s %-11s %s\n' "$name" "$(get_ver "$f")" "$(date -r "$f" +%F 2>/dev/null)" "$flags"
        ((n++))
    done
    ((n)) || note "No scripts in $BIN_DIR"
    ((n)) && printf '%s\n' "${D}$n file(s) in $BIN_DIR${X}"
    ((hidden)) && note "$hidden non-script file(s) hidden (use: $NAME list --all)"
    return 0
}

cmd_restore() {
    local name=${1:-}
    [[ -n $name ]] || { err "restore needs a script name"; return 2; }
    local dest="$BIN_DIR/$name" latest plain=0
    # oldest first, so the last one is the newest backup
    list_backups "$name"
    if ((${#BK[@]} == 0)); then
        err "No backup found for '$name' in $BACKUP_DIR"
        return 1
    fi
    latest=${BK[${#BK[@]}-1]}
    if ((DRY)); then note "would restore $name from ${latest##*/} (${D}$(get_ver "$latest")${X})"; return 0; fi
    if ! is_script "$dest" && ! is_script "$latest"; then plain=1; fi
    local tmp; tmp=$(mktemp) || { err "mktemp failed"; return 1; }
    cp -p -- "$latest" "$tmp" || { rm -f -- "$tmp"; err "restore failed"; return 1; }
    [[ -e $dest ]] && { backup_file "$dest" "$name" || warn "could not back up current $name"; }
    atomic_put "$tmp" "$dest" "$plain" || { rm -f -- "$tmp"; err "restore failed"; return 1; }
    rm -f -- "$tmp"
    ok "$name restored to $(get_ver "$dest") ${D}(from ${latest##*/})${X}"
}

# ---- fish tab completion ----
# The script below is pure fish: nothing from ims runs when you press Tab, it only lists
# folders. Printed by 'ims completions', written by 'ims completions --install'.
fish_completions() {
    printf '# fish completions for %s (written by %s v%s: regenerate with "%s completions --install")\n' \
        "$NAME" "$NAME" "$VERSION" "$NAME"
    cat <<'FISHEOF'

function __ims_dl_dir
    if set -q IMS_DL_DIR; and test -n "$IMS_DL_DIR"
        echo $IMS_DL_DIR
    else
        echo $HOME/Downloads
    end
end

function __ims_bin_dir
    if set -q IMS_BIN_DIR; and test -n "$IMS_BIN_DIR"
        echo $IMS_BIN_DIR
    else
        echo $HOME/.local/bin
    end
end

function __ims_backup_dir
    if set -q XDG_STATE_HOME; and test -n "$XDG_STATE_HOME"
        echo $XDG_STATE_HOME/ims/backups
    else
        echo $HOME/.local/state/ims/backups
    end
end

# the words typed so far that are not options (without "ims" itself)
function __ims_positionals
    set -l toks (commandline -opc)
    set -e toks[1]
    for t in $toks
        string match -q -- '-*' $t; and continue
        echo $t
    end
end

function __ims_at_first
    test (count (__ims_positionals)) -eq 0
end

function __ims_at_restore_arg
    set -l p (__ims_positionals)
    test (count $p) -eq 1; and test "$p[1]" = restore
end

function __ims_in_completions
    set -l p (__ims_positionals)
    test (count $p) -ge 1; and test "$p[1]" = completions
end

# every file in the Downloads folder (bare names: ims looks them up there itself)
function __ims_downloads
    command find -L (__ims_dl_dir) -maxdepth 1 -type f ! -name '.*' -printf '%f\tin Downloads\n' 2>/dev/null | sort
end

# files already in the bin folder (to update just one script)
function __ims_installed
    command find -L (__ims_bin_dir) -maxdepth 1 -type f ! -name '.*' -printf '%f\tinstalled\n' 2>/dev/null | sort
end

# names that have a backup: <name>.YYYYMMDD-HHMMSS[-NN]
function __ims_backed_up
    for f in (command find (__ims_backup_dir) -maxdepth 1 -type f -printf '%f\n' 2>/dev/null)
        string replace -rf -- '\.[0-9]{8}-[0-9]{6}(-[0-9]{2})?$' '' $f
    end | sort -u | while read -l n
        printf '%s\thas a backup\n' $n
    end
end

# the word being typed looks like a path (~/x, ./x, /x, dir/x): complete ordinary paths
function __ims_at_first_path
    __ims_at_first; or return 1
    string match -qr '^[~./]|/' -- (commandline -ct)
end

# no file completion from the current folder, except for words that look like paths
complete -c ims -f
complete -c ims -n __ims_at_first_path -F

complete -c ims -n __ims_at_first -a list -d 'List scripts with version and pending updates'
complete -c ims -n __ims_at_first -a restore -d 'Roll back a script to its latest backup'
complete -c ims -n __ims_at_first -a completions -d 'Print or install these fish completions'
complete -c ims -n __ims_at_first -a '(__ims_downloads)'
complete -c ims -n __ims_at_first -a '(__ims_installed)'
complete -c ims -n __ims_at_restore_arg -a '(__ims_backed_up)'

complete -c ims -s h -l help -d 'Show help'
complete -c ims -s v -l version -d 'Show version'
complete -c ims -s n -l dry-run -d 'Show what would happen, change nothing'
complete -c ims -s c -l copy -d 'Copy instead of move'
complete -c ims -l no-backup -d "Don't back up the file being replaced"
complete -c ims -l keep-ext -d 'Keep the extension when installing a new script'
complete -c ims -s a -l all -d 'With list: include non-script files'
complete -c ims -n __ims_in_completions -l install -d 'Write the file instead of printing it'
FISHEOF
}

cmd_completions() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions" file tmp
    file="$dir/$NAME.fish"
    if ((!INSTALL)); then
        fish_completions
        return 0
    fi
    if ((DRY)); then note "would write $file"; return 0; fi
    mkdir -p -- "$dir" || { err "cannot create $dir"; return 1; }
    tmp=$(mktemp "$dir/.ims.XXXXXX") || { err "cannot write in $dir"; return 1; }
    if fish_completions >"$tmp" && chmod 644 -- "$tmp" && mv -f -- "$tmp" "$file"; then
        ok "fish completions installed: $file"
        note "Open a new fish shell (or run: source $file) to use them"
        command -v fish >/dev/null 2>&1 || warn "fish was not found on this system"
        return 0
    fi
    rm -f -- "$tmp"
    err "could not write $file"
    return 1
}

# ---- argument parsing ----
DRY=0; COPY=0; BACKUP=1; KEEP_EXT=0; ALL=0; INSTALL=0
pos=()
while (($#)); do
    case $1 in
        -h|--help)    usage; exit 0 ;;
        -v|--version) printf '%s v%s\n' "$NAME" "$VERSION"; exit 0 ;;
        -n|--dry-run) DRY=1 ;;
        -c|--copy)    COPY=1 ;;
        --no-backup)  BACKUP=0 ;;
        --keep-ext)   KEEP_EXT=1 ;;
        -a|--all)     ALL=1 ;;
        --install)    INSTALL=1 ;;
        --)           shift; pos+=("$@"); break ;;
        -*)           err "Unknown option: $1 (try $NAME --help)"; exit 2 ;;
        *)            pos+=("$1") ;;
    esac
    shift
done

if ((${#pos[@]} > 2)); then err "Too many arguments (try $NAME --help)"; exit 2; fi

case "${pos[0]-}" in
    "")        cmd_default ;;
    list|ls)   cmd_list ;;
    restore)   cmd_restore "${pos[1]-}" ;;
    completions)
               ((${#pos[@]} > 1)) && { err "completions takes no name (try $NAME --help)"; exit 2; }
               cmd_completions ;;
    *)         ((${#pos[@]} > 1)) && { err "Too many arguments (try $NAME --help)"; exit 2; }
               if [[ ${pos[0]} == */* ]]; then cmd_path "${pos[0]}"; else cmd_named "${pos[0]}"; fi ;;
esac
