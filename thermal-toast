#!/usr/bin/env bash
# DESC: Notify when the CPU package stays hot for too long
# thermal-toast: notify when the CPU package stays hot for too long.
#
# NEW IN THIS VERSION (1.0.2):
#   - Fix: an option without a value (e.g. "thermal-toast -t") looped forever at
#     100% CPU; it now stops with a message (exit status 2).
#   - Fix: values that are not whole numbers (letters, empty, 0 for the polling
#     interval or the threshold, also from the THERMAL_TOAST_* variables) no longer
#     cause constant alerts or a busy loop; they are rejected with a message. Leading
#     zeros ("085") are read as decimal.
#   - Fix: a variable named TEST in the environment could turn the script into a
#     one-time test run; it is no longer read.
#   - Fix: if the CPU was already hot on the first reading, the alert came one polling
#     interval late and its "for Ns" figure was a few seconds short.
#   - Prints one line when started from a terminal, so you can tell it is watching.
#   - --version prints "thermal-toast v<version>"; VERSION is now quoted; added a
#     # DESC: line for shelf.
VERSION="1.0.2"
NAME="thermal-toast"

THRESHOLD="${THERMAL_TOAST_THRESHOLD:-85}"   # deg C
SUSTAIN="${THERMAL_TOAST_SUSTAIN:-60}"       # seconds above threshold before alerting
COOLDOWN="${THERMAL_TOAST_COOLDOWN:-600}"    # seconds between alerts
INTERVAL="${THERMAL_TOAST_INTERVAL:-5}"      # polling interval in seconds
HYSTERESIS=3                                 # must drop this far below threshold to reset
DO_TEST=0

usage() {
    cat <<EOF
$NAME v$VERSION - toast when the CPU stays hot for too long

Usage: $NAME [options]

Options:
  -t, --threshold C   Temperature threshold in deg C   (default: $THRESHOLD)
  -s, --sustain S     Seconds above threshold to alert (default: $SUSTAIN)
  -c, --cooldown S    Seconds between alerts           (default: $COOLDOWN)
  -i, --interval S    Polling interval in seconds      (default: $INTERVAL)
      --test          Send a test notification and exit
  -V, --version       Print version and exit
  -h, --help          Show this help and exit

All values are whole numbers (threshold and interval at least 1).
Environment overrides: THERMAL_TOAST_{THRESHOLD,SUSTAIN,COOLDOWN,INTERVAL}
EOF
}

need_val() { # called as: need_val "$@"  ($1 = the option, $2 = its value)
    [[ $# -ge 2 ]] || { echo "$NAME: $1 needs a value (try --help)" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--threshold) need_val "$@"; THRESHOLD="$2"; shift 2 ;;
        -s|--sustain)   need_val "$@"; SUSTAIN="$2";   shift 2 ;;
        -c|--cooldown)  need_val "$@"; COOLDOWN="$2";  shift 2 ;;
        -i|--interval)  need_val "$@"; INTERVAL="$2";  shift 2 ;;
        --test)         DO_TEST=1;      shift ;;
        -V|--version)   echo "$NAME v$VERSION"; exit 0 ;;
        -h|--help)      usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

# every number must be a whole number; "085" is 85, not octal
for _v in THRESHOLD SUSTAIN COOLDOWN INTERVAL; do
    case "${!_v}" in
        ''|*[!0-9]*) echo "$NAME: ${_v,,} must be a whole number, got '${!_v}' (try --help)" >&2; exit 2 ;;
    esac
    printf -v "$_v" '%s' "$((10#${!_v}))"
done
if (( THRESHOLD < 1 )); then echo "$NAME: threshold must be at least 1" >&2; exit 2; fi
if (( INTERVAL < 1 )); then echo "$NAME: interval must be at least 1" >&2; exit 2; fi

command -v notify-send >/dev/null || { echo "notify-send not found (install libnotify)" >&2; exit 1; }

find_sensor() {
    local h
    for h in /sys/class/hwmon/hwmon*; do
        if [[ "$(cat "$h/name" 2>/dev/null)" == "coretemp" && -r "$h/temp1_input" ]]; then
            echo "$h/temp1_input"; return 0
        fi
    done
    local z
    for z in /sys/class/thermal/thermal_zone*; do
        if [[ "$(cat "$z/type" 2>/dev/null)" == "x86_pkg_temp" ]]; then
            echo "$z/temp"; return 0
        fi
    done
    return 1
}

top_procs() {
    # Second top iteration = current usage (the first is a since-boot average).
    top -b -n 2 -d 1 -o %CPU 2>/dev/null | awk '
        /^top -/ { n++ }
        n == 2 && $1 ~ /^[0-9]+$/ && $12 != "top" && $12 != "awk" {
            printf "%s (%s%%)\n", $12, $9
            if (++c == 3) exit
        }'
}

toast() {
    notify-send -a "$NAME" -u critical -i temperature-warning "$1" "$2"
}

if (( DO_TEST )); then
    toast "CPU is hot (test)" "$NAME v$VERSION is working."
    exit 0
fi

SENSOR="$(find_sensor)" || { echo "No CPU temperature sensor found" >&2; exit 1; }

if [[ -t 1 ]]; then
    echo "Watching CPU temperature (alert above ${THRESHOLD}°C for ${SUSTAIN}s, check every ${INTERVAL}s). Ctrl+C to stop."
fi

hot_since=-1
last_alert=-999999

while true; do
    raw="$(cat "$SENSOR" 2>/dev/null)" || { sleep "$INTERVAL"; continue; }
    temp=$(( raw / 1000 ))
    now=$SECONDS

    if (( temp >= THRESHOLD )); then
        (( hot_since < 0 )) && hot_since=$now
        if (( now - hot_since >= SUSTAIN && now - last_alert >= COOLDOWN )); then
            toast "CPU running hot: ${temp}°C" \
                  "Above ${THRESHOLD}°C for $(( now - hot_since ))s. Top processes:
$(top_procs)"
            last_alert=$now
        fi
    elif (( temp < THRESHOLD - HYSTERESIS )); then
        hot_since=-1
    fi

    sleep "$INTERVAL"
done
